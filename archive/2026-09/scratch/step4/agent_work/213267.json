{"id": 213267, "entrypoint": "hex2rgb", "coverage": 98, "stage": "floor_pass", "python": "def hex2rgb(hex_str):\n    \"\"\"\n   #123456 -> (18, 52, 86)\n    \"\"\"\n    h = hex_str[hex_str.find('#') + 1:]\n    l = len(h)\n    if l == 6:\n        return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)\n    elif l == 3:\n        return int(h[0], 16), int(h[1], 16), int(h[2], 16)\n    else:\n        raise TypeError(\"hex_str not recognized:\" + str(hex_str))", "floor_fn": "\"\"\"\n   #123456 -> (18, 52, 86)\n    \"\"\"\ndef hex2rgb(hex_str: Any) -> object {\n    h = hex_str[(hex_str.find('#') + 1):];\n    l = len(h);\n    if (l == 6) {\n        return (int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16));\n    } elif (l == 3) {\n        return (int(h[0], 16), int(h[1], 16), int(h[2], 16));\n    } else {\n        raise TypeError((\"hex_str not recognized:\" + str(hex_str)));\n    }\n}", "test_blocks": "test \"t0\" {\n    assert (hex2rgb(\"#f3f3f3\") == (243, 243, 243));;\n}\n\ntest \"t1\" {\n    assert (hex2rgb('#000000') == (0, 0, 0));;\n}\n\ntest \"t2\" {\n    assert (hex2rgb('#123456') == (18, 52, 86));;\n}\n\ntest \"t3\" {\n    assert (hex2rgb(\"#FF0000\") == (255, 0, 0));;\n}\n\ntest \"t4\" {\n    assert (hex2rgb('#123456') == (18, 52, 86));;\n}\n\ntest \"t5\" {\n    assert (hex2rgb(\"#0F0F0F\") == (15, 15, 15));;\n}\n\ntest \"t6\" {\n    assert (hex2rgb(\"#000000\") == (0, 0, 0));;\n}\n\ntest \"t7\" {\n    assert (hex2rgb('#79370E') == (121, 55, 14));;\n}\n\ntest \"t8\" {\n    assert (hex2rgb(\"123456\") == (18, 52, 86));;\n}\n\ntest \"t9\" {\n    assert (hex2rgb(\"#123456\") == hex2rgb(\"#123456\"));;\n}\n\ntest \"t10\" {\n    assert (hex2rgb(\"#F0F0F0\") == (240, 240, 240));;\n}\n\ntest \"t11\" {\n    assert (hex2rgb(\"#123456\") == (18, 52, 86));;\n}\n\ntest \"t12\" {\n    assert (hex2rgb(\"#1b51a7\") == (27, 81, 167));;\n}\n\ntest \"t13\" {\n    assert (hex2rgb(\"123456\") == (18, 52, 86));;\n}\n\ntest \"t14\" {\n    assert (hex2rgb(\"5c74c7\") == (92, 116, 199