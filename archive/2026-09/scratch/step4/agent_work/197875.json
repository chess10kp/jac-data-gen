{"id": 197875, "entrypoint": "gcd", "coverage": 100, "stage": "floor_pass", "python": "def gcd(a, b):\n    \"\"\"Greatest Common Divisor by Euclid\"\"\"\n    a = abs(a)\n    b = abs(b)\n    if a == 0 and b == 0:\n        return 1\n    if a == 0:\n        return b\n    if b == 0:\n        return a\n    if a < b:\n        a, b = b, a\n    r = 1\n    while r:\n        r = a % b\n        if r:\n            a = b\n            b = r\n    return b", "floor_fn": "\"\"\"Greatest Common Divisor by Euclid\"\"\"\ndef gcd(a: Any, b: Any) -> object {\n    a = abs(a);\n    b = abs(b);\n    if ((a == 0) and (b == 0)) {\n        return 1;\n    }\n    if (a == 0) {\n        return b;\n    }\n    if (b == 0) {\n        return a;\n    }\n    if (a < b) {\n        (a, b) = (b, a);\n    }\n    r = 1;\n    while r {\n        r = a % b;\n        if r {\n            a = b;\n            b = r;\n        }\n    }\n    return b;\n}", "test_blocks": "test \"t0\" {\n    assert (\n        gcd(123456789012345678901234567890, 123456789012345678901234567890)\n        == 123456789012345678901234567890\n    );;\n}\n\ntest \"t1\" {\n    assert (gcd(1, 123456789012345678901234567890) == 1);;\n}\n\ntest \"t2\" {\n    assert (gcd(3, -3) == 3);;\n}\n\ntest \"t3\" {\n    assert (gcd(0, 15) == 15);;\n}\n\ntest \"t4\" {\n    assert (gcd(12345, 67890) == 15);;\n}\n\ntest \"t5\" {\n    assert (gcd(24, 36) == 12);;\n}\n\ntest \"t6\" {\n    assert (gcd(34, 0) == 34);;\n}\n\ntest \"t7\" {\n    assert (gcd(50, 1) == 1);;\n}\n\ntest \"t8\" {\n    assert (gcd(-36, 24) == 12);;\n}\n\ntest \"t9\" {\n    assert (gcd(3, 11) == 1);;\n}\n\ntest \"t10\" {\n    assert (gcd(36, 0) == 36);;\n}\n\ntest \"t11\" {\n    assert (gcd(4, -3) == 1);;\n}\n\ntest \"t12\" {\n    assert (gcd(1, 1) == 1);;\n}\n\ntest \"t13\" {\n    assert (gcd(20, 5) == 5);;\n}\n\ntest \"t14\" {\n    assert (gcd(-18, 12) == 6);;\n}\n\ntest \"t15\" {\n    assert (gcd(100, 150) == 50);;\n}\n\ntest \"t16\" {\n    assert (gcd(42, 0) == 42);;\n}\n\ntest \"t17\" 