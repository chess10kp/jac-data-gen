{"id": 78676, "entrypoint": "sec2time", "coverage": 100, "stage": "floor_pass", "python": "def sec2time(seconds):\n    \"\"\"\n    Converts seconds to time format\n\n    :param float|int seconds:\n    :return str: 'h:m:s\"\n    \"\"\"\n    m, s = divmod(seconds, 60)\n    h, m = divmod(m, 60)\n    return \"%d:%02d:%02d\" % (h, m, s)", "floor_fn": "\"\"\"\n    Converts seconds to time format\n\n    :param float|int seconds:\n    :return str: 'h:m:s\"\n    \"\"\"\ndef sec2time(seconds: Any) -> object {\n    (m, s) = divmod(seconds, 60);\n    (h, m) = divmod(m, 60);\n    return (\"%d:%02d:%02d\" % (h, m, s));\n}", "test_blocks": "test \"t0\" {\n    assert (sec2time(30) == \"0:00:30\");;\n}\n\ntest \"t1\" {\n    assert (sec2time(61) == '0:01:01');;\n}\n\ntest \"t2\" {\n    assert (sec2time(60.0) == '0:01:00');;\n}\n\ntest \"t3\" {\n    assert (sec2time(3600) == '1:00:00');;\n}\n\ntest \"t4\" {\n    assert (sec2time(86401) == '24:00:01');;\n}\n\ntest \"t5\" {\n    assert (sec2time(3600) == \"1:00:00\");;\n}\n\ntest \"t6\" {\n    assert (sec2time(4) == \"0:00:04\");;\n}\n\ntest \"t7\" {\n    assert (sec2time(86399.999999) == '23:59:59');;\n}\n\ntest \"t8\" {\n    assert (sec2time(3601) == \"1:00:01\");;\n}\n\ntest \"t9\" {\n    assert (sec2time(3601) == '1:00:01');;\n}\n\ntest \"t10\" {\n    assert (sec2time(61.1) == '0:01:01');;\n}\n\ntest \"t11\" {\n    assert (sec2time(7261) == \"2:01:01\");;\n}\n\ntest \"t12\" {\n    assert (sec2time(3661) == '1:01:01');;\n}\n\ntest \"t13\" {\n    assert (sec2time(86400) == '24:00:00');;\n}\n\ntest \"t14\" {\n    assert (sec2time(119) == \"0:01:59\");;\n}\n\ntest \"t15\" {\n    assert (sec2time(3599) == '0:59:59');;\n}\n\ntest \"t16\" {\n    assert (sec2time(3722) == \"1:02:02\");;\n}\n\ntest \"t17\" {\n    assert (sec2time(-86400) == \"-24:00:00\");;\n}\n\ntest \"t18\" {\n    assert (sec2time(-86400) == '-24:00:00');;\n}\n\ntest \"t19\" {\n    assert (sec2time(2) == '0:00:02');;\n}\n\ntest \"t20\" {\n    assert (sec2time(7321) == \"2: