{"id": 273573, "entrypoint": "swapxy", "coverage": 100, "stage": "floor_pass", "python": "def swapxy(v:list) -> list:\r\n    \"\"\"Swaps the first two values\r\n        in a list\r\n\r\n    Args:\r\n        list[x, y]\r\n\r\n    Returns:\r\n        list[y, x]\r\n    \"\"\"\r\n    return [v[1], v[0]]", "floor_fn": "\"\"\"Swaps the first two values\n        in a list\n\n    Args:\n        list[x, y]\n\n    Returns:\n        list[y, x]\n    \"\"\"\ndef swapxy(v: list) -> list {\n    return [v[1], v[0]];\n}", "test_blocks": "test \"t0\" {\n    assert (swapxy([-2, -1]) == [-1, -2]);;\n}\n\ntest \"t1\" {\n    assert (swapxy([7, 1]) == [1, 7]);;\n}\n\ntest \"t2\" {\n    assert (swapxy([1.5, 0]) == [0, 1.5]);;\n}\n\ntest \"t3\" {\n    assert (swapxy([4, 5]) == [5, 4]);;\n}\n\ntest \"t4\" {\n    assert (swapxy([0.5, -3.14159]) == [-3.14159, 0.5]);;\n}\n\ntest \"t5\" {\n    assert (swapxy([1, 2]) == [2, 1]);;\n}\n\ntest \"t6\" {\n    assert (swapxy([4, 6]) == [6, 4]);;\n}\n\ntest \"t7\" {\n    assert (swapxy([100, 200]) == [200, 100]);;\n}\n\ntest \"t8\" {\n    assert (swapxy([20, 30]) == [30, 20]);;\n}\n\ntest \"t9\" {\n    assert (swapxy(`list(range(2))) == [1, 0]);;\n}\n\ntest \"t10\" {\n    assert (swapxy([20000, 0]) == [0, 20000]);;\n}\n\ntest \"t11\" {\n    assert (swapxy([1000000, 1000000]) == [1000000, 1000000]);;\n}\n\ntest \"t12\" {\n    assert (swapxy([1, 2]) == [2, 1]);;\n}\n\ntest \"t13\" {\n    assert (swapxy([1000, 5000]) == [5000, 1000]);;\n}\n\ntest \"t14\" {\n    assert (swapxy([-2, 5]) == [5, -2]);;\n}\n\ntest \"t15\" {\n    assert (swapxy([2, 3]) == [3, 2]);;\n}\n\ntest \"t16\" {\n    assert (swapxy([4, 5]) == [5, 4]);;\n}\n\ntest \"t17\" {\n    assert (swapxy([1, 2]) == [2, 1]);;\n}\n\ntest \"t18\" {\n    assert (swapxy([0, 100]) == [100, 0]);;\n}\n\ntest \"t19\" {\n    assert (swapxy([200, 100]) == [100, 200]);;\n}\n\ntest \"t20\" {\n    assert (swapxy([3, 4]) == [4, 3]);;\n}\n\ntest \"t21\" {\n    assert (swapxy([-1, -100]) == [-100, -1]);;\n}\n\ntest \