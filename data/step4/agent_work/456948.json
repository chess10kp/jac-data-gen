{"id": 456948, "entrypoint": "xgcd", "coverage": 100, "stage": "floor_pass", "python": "def xgcd(a: int, b: int) -> tuple:\n    \"\"\"\n    Extended Euclidean algorithm.\n    Returns (g, x, y) such that a*x + b*y = g = gcd(a, b).\n    \"\"\"\n    x0, x1, y0, y1 = 0, 1, 1, 0\n    while a != 0:\n        (q, a), b = divmod(b, a), a\n        y0, y1 = y1, y0 - q * y1\n        x0, x1 = x1, x0 - q * x1\n    return b, x0, y0", "floor_fn": "\"\"\"\n    Extended Euclidean algorithm.\n    Returns (g, x, y) such that a*x + b*y = g = gcd(a, b).\n    \"\"\"\ndef xgcd(a: int, b: int) -> tuple {\n    (x0, x1, y0, y1) = (0, 1, 1, 0);\n    while (a != 0) {\n        ((q, a), b) = (divmod(b, a), a);\n        (y0, y1) = (y1, (y0 - (q * y1)));\n        (x0, x1) = (x1, (x0 - (q * x1)));\n    }\n    return (b, x0, y0);\n}", "test_blocks": "test \"t0\" {\n    assert (xgcd(0, 81985529216486895) == (81985529216486895, 0, 1));;\n}\n\ntest \"t1\" {\n    assert (xgcd(0, 100) == (100, 0, 1));;\n}\n\ntest \"t2\" {\n    assert (xgcd(3, 4) == (1, -1, 1));;\n}\n\ntest \"t3\" {\n    assert (xgcd(0, 1000) == (1000, 0, 1));;\n}\n\ntest \"t4\" {\n    assert (xgcd(4, 0) == (4, 1, 0));;\n}\n\ntest \"t5\" {\n    assert (xgcd(3, 0) == (3, 1, 0));;\n}\n\ntest \"t6\" {\n    assert (xgcd(20, 16) == (4, 1, -1));;\n}\n\ntest \"t7\" {\n    assert (xgcd(10, 12) == (2, -1, 1));;\n}\n\ntest \"t8\" {\n    assert (xgcd(0, 0) == (0, 0, 1));;\n}\n\ntest \"t9\" {\n    assert (xgcd(5, 1) == (1, 0, 1));;\n}\n\ntest \"t10\" {\n    assert (xgcd(123, 123) == (123, 1, 0));;\n}\n\ntest \"t11\" {\n    assert (xgcd(0, 1) == (1, 0, 1));;\n}\n\ntest \"t12\" {\n    assert (xgcd(4, 2) == (2, 0, 1));;\n}\n\ntest \"t13\" {\n    assert (xgcd(3, 3) == (3, 1, 0));;\n}\n\ntest \"t14\" {\n    assert (xgcd(40, 80) == (40, 1, 0));;\n}\n\ntest \"t15\" {\n    assert (xgcd(1000, 1000) == (1000, 1, 0));;\n}\n\ntest \"t16\" {\n    assert (xgcd(20, 0) == (20, 1, 0));;\n}\n\ntest \"t17\" {\n    assert (xgcd(10000000, 10000000) == (10000000, 1, 0));;\n}\n\ntest \"t18\" {\n    assert (xgcd(100, 0) == (100, 1, 0));;\n}\n\ntest \"t19\" {\n    assert (xgcd(13, 13) == (13, 1, 0));;\n}\n\ntest \"t20\" {\n    assert (xgcd(1, 0) == (1, 1, 0));;\n}\n\ntest \"t21\" {\n    assert (xgcd(0, 3) == (3, 0, 1));;\n}\n\ntest \"t22\" {\n    assert (xgcd(11, 10) == (1, 1, -1));;\n}\n\ntest \"t23\" {\n    assert (xgcd(3, 7) == (1, -2, 1));;\n}\n\ntest \"t24\" {\n    assert (xgcd(5, 5) == (5, 1, 0));;\n}\n\ntest \"t25\" {\n    assert (xgcd(10, 8) == (2, 1, -1));;\n}\n\ntest \"t26\" {\n    assert (xgcd(0, 2) == (2, 0, 1));;\n}\n\ntest \"t27\" {\n    assert (xgcd(0, 42) == (42, 0, 1));;\n}\n\ntest \"t28\" {\n    assert (xgcd(2, 3) == (1, -1, 1));;\n}\n\ntest \"t29\" {\n    assert (xgcd(1, -1) == (1, 1, 0));;\n}\n\ntest \"t30\" {\n    assert (xgcd(2, 0) == (2, 1, 0));;\n}\n\ntest \"t31\" {\n    assert (xgcd(12, 8) == (4, 1, -1));;\n}\n\ntest \"t32\" {\n    assert (xgcd(0, 4) == (4, 0, 1));;\n}\n\ntest \"t33\" {\n    assert (xgcd(6, 15) == (3, -2, 1));;\n}\n\ntest \"t34\" {\n    assert (xgcd(2, 2) == (2, 1, 0));;\n}\n\ntest \"t35\" {\n    assert (xgcd(1, 1) == (1, 1, 0));;\n}\n\ntest \"t36\" {\n    assert (xgcd(10, 1000) == (10, 1, 0));;\n}\n\ntest \"t37\" {\n    assert (xgcd(2, 1) == (1, 0, 1));;\n}\n\ntest \"t38\" {\n    assert (xgcd(5, 0) == (5, 1, 0));;\n}"}