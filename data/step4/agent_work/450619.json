{"id": 450619, "entrypoint": "_join_matchers", "coverage": 97, "stage": "floor_pass", "python": "def _join_matchers(matcher, *matchers):\n    \"\"\"Joins matchers of lists correctly.\"\"\"\n    output = {k: [e for e in v] for k, v in matcher.items()}\n\n    for matcher_to_join in matchers:\n        has_default = False\n        for key, value in matcher_to_join.items():\n            if key == \"default\":  # Default has a special case.\n                has_default = True\n\n            if key in output:\n                output[key].extend(value)\n            else:\n                # Important to add the \"default\" value, if it exists, as the new\n                # key was a \"default\", but is not anymore.\n                output[key] = value\n                if \"default\" in output and key != \"default\":\n                    value.extend(output[\"default\"])\n        if has_default:\n            for key in output.keys():\n                # All keys from output that are not in matcher_to_join were part\n                # of \"default\" in matcher_to_join, so they need to be added the\n                # default.\n                if key not in matcher_to_join:\n                    output[key].extend(matcher_to_join[\"default\"])\n    return output", "floor_fn": "\"\"\"Joins matchers of lists correctly.\"\"\"\ndef _join_matchers(matcher: Any, *matchers: Any) -> object {\n    output = {k: [e for e in v] for (k, v) in matcher.items()};\n    for matcher_to_join in matchers {\n        has_default = False;\n        for (key, value) in matcher_to_join.items() {\n            if (key == \"default\") {\n                has_default = True;\n            }\n            if (key in output) {\n                output[key].extend(value);\n            } else {\n                output[key] = value;\n                if ((\"default\" in output) and (key != \"default\")) {\n                    value.extend(output[\"default\"]);\n                }\n            }\n        }\n        if has_default {\n            for key in output.keys() {\n                if (key not in matcher_to_join) {\n                    output[key].extend(matcher_to_join[\"default\"]);\n                }\n            }\n        }\n    }\n    return output;\n}", "test_blocks": "test \"t0\" {\n    assert (\n        _join_matchers(\n            {\"foo\": [\"a\", \"b\"], \"default\": [\"d\", \"e\"], \"baz\": [\"g\", \"h\"]},\n            {\"foo\": [\"c\"], \"baz\": [\"f\"], \"default\": [\"i\", \"j\"]}\n        )\n        == {\n            \"foo\": [\"a\", \"b\", \"c\"],\n            \"default\": [\"d\", \"e\", \"i\", \"j\"],\n            \"baz\": [\"g\", \"h\", \"f\"]\n        }\n    );;\n}\n\ntest \"t1\" {\n    assert (\n        _join_matchers({\"a\": [1, 2]}, {\"a\": [3], \"b\": [10]})\n        == {\"a\": [1, 2, 3], \"b\": [10]}\n    );;\n}\n\ntest \"t2\" {\n    assert (\n        _join_matchers(\n            {\"a\": [1, 2, 3]}, {\"a\": [3, 4, 5]}, {\"b\": [1, 2, 3]}, {\"b\": [3, 4, 5]}\n        )\n        == {\"a\": [1, 2, 3, 3, 4, 5], \"b\": [1, 2, 3, 3, 4, 5]}\n    );;\n}\n\ntest \"t3\" {\n    assert (_join_matchers({\"a\": [1, 2]}, {\"b\": [3, 4]}) == {\"a\": [1, 2], \"b\": [3, 4]});;\n}\n\ntest \"t4\" {\n    assert (\n        _join_matchers({\"a\": [\"b\"], \"default\": [\"d\"]}, {\"a\": [\"e\"], \"default\": [\"f\"]})\n        == {\"a\": [\"b\", \"e\"], \"default\": [\"d\", \"f\"]}\n    );;\n}\n\ntest \"t5\" {\n    assert (\n        _join_matchers(\n            {\"a\": [1, 2, 3], \"default\": [10, 20]}, {\"a\": [5, 6, 7], \"default\": [8, 9]}\n        )\n        == {\"a\": [1, 2, 3, 5, 6, 7], \"default\": [10, 20, 8, 9]}\n    );;\n}\n\ntest \"t6\" {\n    assert (_join_matchers({}) == {});;\n}\n\ntest \"t7\" {\n    assert (\n        _join_matchers({'a': [1, 2, 3]}, {'a': [4]}, {'a': [5, 6]})\n        == {'a': [1, 2, 3, 4, 5, 6]}\n    );;\n}\n\ntest \"t8\" {\n    assert (\n        _join_matchers(\n            {'a': [1], 'b': [2]}, {'a': [2], 'b': [3]}, {'a': [3]}, {'b': [4]}\n        )\n        == {'a': [1, 2, 3], 'b': [2, 3, 4]}\n    );;\n}\n\ntest \"t9\" {\n    assert (\n        _join_matchers(\n            {\"a\": [1, 2], \"b\": [3, 4]},\n            {\"a\": [1], \"c\": [2]},\n            {\"a\": [2], \"b\": [3], \"d\": [4]},\n            {\"b\": [4]}\n        )\n        == {\"a\": [1, 2, 1, 2], \"b\": [3, 4, 3, 4], \"c\": [2], \"d\": [4]}\n    );;\n}\n\ntest \"t10\" {\n    assert (\n        _join_matchers({\"a\": [1, 2], \"default\": [30]}, {\"a\": [3], \"default\": [11]})\n        == {\"a\": [1, 2, 3], \"default\": [30, 11]}\n    );;\n}\n\ntest \"t11\" {\n    assert (\n        _join_matchers({\"a\": [1, 2], \"default\": [\"d\"]}, {\"a\": [3, 4], \"default\": [\"e\"]})\n        == {\"a\": [1, 2, 3, 4], \"default\": [\"d\", \"e\"]}\n    );;\n}\n\ntest \"t12\" {\n    assert (\n        _join_matchers(\n            {\"a\": [\"1\", \"2\"], \"default\": [\"3\"]}, {\"a\": [\"4\", \"5\"], \"default\": [\"6\"]}\n        )\n        == {\"a\": [\"1\", \"2\", \"4\", \"5\"], \"default\": [\"3\", \"6\"]}\n    );;\n}\n\ntest \"t13\" {\n    assert (_join_matchers({'a': [1, 2, 3]}, {'b': [4]}) == {'a': [1, 2, 3], 'b': [4]});;\n}\n\ntest \"t14\" {\n    assert (\n        _join_matchers({\"default\": [1, 2, 3]}, {\"default\": [4, 5]})\n        == {\"default\": [1, 2, 3, 4, 5]}\n    );;\n}\n\ntest \"t15\" {\n    assert (\n        _join_matchers({\"a\": [1, 2]}, {\"a\": [3, 4], \"b\": [5]})\n        == {\"a\": [1, 2, 3, 4], \"b\": [5]}\n    );;\n}\n\ntest \"t16\" {\n    assert (\n        _join_matchers({\"a\": [1]}, {\"b\": [2]}, {\"b\": [3], \"c\": [4]})\n        == {\"a\": [1], \"b\": [2, 3], \"c\": [4]}\n    );;\n}\n\ntest \"t17\" {\n    assert (_join_matchers({\"a\": [1, 2]}, {\"a\": [3, 4]}) == {\"a\": [1, 2, 3, 4]});;\n}\n\ntest \"t18\" {\n    assert (\n        _join_matchers(\n            {\"a\": [1, 2, 3]},\n            {\"a\": [3, 4, 5]},\n            {\"a\": [5, 6, 7]},\n            {\"b\": [1, 2, 3]},\n            {\"b\": [3, 4, 5]},\n            {\"b\": [5, 6, 7]}\n        )\n        == {\"a\": [1, 2, 3, 3, 4, 5, 5, 6, 7], \"b\": [1, 2, 3, 3, 4, 5, 5, 6, 7]}\n    );;\n}\n\ntest \"t19\" {\n    assert (\n        _join_matchers({\"a\": [\"A\"], \"b\": [\"B\"]}, {\"b\": [\"C\"], \"c\": [\"D\"]})\n        == {\"a\": [\"A\"], \"b\": [\"B\", \"C\"], \"c\": [\"D\"]}\n    );;\n}\n\ntest \"t20\" {\n    assert (\n        _join_matchers({\"a\": [1, 2], \"b\": [10]}, {\"a\": [3], \"b\": [11]})\n        == {\"a\": [1, 2, 3], \"b\": [10, 11]}\n    );;\n}\n\ntest \"t21\" {\n    assert (\n        _join_matchers({\"hello\": [0, 1, 2]}, {\"hello\": [3, 4, 5]}, {\"hello\": [6, 7, 8]})\n        == {\"hello\": [0, 1, 2, 3, 4, 5, 6, 7, 8]}\n    );;\n}\n\ntest \"t22\" {\n    assert (\n        _join_matchers({\"default\": [\"default_1\", \"default_2\"]})\n        == {\"default\": [\"default_1\", \"default_2\"]}\n    );;\n}\n\ntest \"t23\" {\n    assert (\n        _join_matchers(\n            {\"foo\": [\"a\", \"b\"], \"bar\": [\"a\", \"b\"], \"default\": [\"c\"]},\n            {\"foo\": [\"a\", \"b\", \"c\"], \"bar\": [\"c\"]}\n        )\n        == {\"foo\": [\"a\", \"b\", \"a\", \"b\", \"c\"], \"bar\": [\"a\", \"b\", \"c\"], \"default\": [\"c\"]}\n    );;\n}\n\ntest \"t24\" {\n    assert (\n        _join_matchers({\"a\": [1, 2]}, {\"a\": [3, 4], \"b\": [5]}, {\"b\": [6]})\n        == {\"a\": [1, 2, 3, 4], \"b\": [5, 6]}\n    );;\n}\n\ntest \"t25\" {\n    assert (_join_matchers({\"default\": [\"a\"]}) == {\"default\": [\"a\"]});;\n}\n\ntest \"t26\" {\n    assert (\n        _join_matchers(\n            {\"a\": [\"b\"], \"default\": [\"d\"]},\n            {\"a\": [\"e\"], \"default\": [\"f\"]},\n            {\"a\": [\"g\"], \"default\": [\"h\"]}\n        )\n        == {\"a\": [\"b\", \"e\", \"g\"], \"default\": [\"d\", \"f\", \"h\"]}\n    );;\n}\n\ntest \"t27\" {\n    assert (\n        _join_matchers({\"a\": [1, 2], \"b\": [3, 4], \"c\": [5]})\n        == {\"a\": [1, 2], \"b\": [3, 4], \"c\": [5]}\n    );;\n}\n\ntest \"t28\" {\n    assert (\n        _join_matchers(\n            {\"a\": [1, 2], \"b\": [3, 4], \"c\": [5]},\n            {\"a\": [6, 7], \"b\": [8, 9]},\n            {\"a\": [10]}\n        )\n        == {\"a\": [1, 2, 6, 7, 10], \"b\": [3, 4, 8, 9], \"c\": [5]}\n    );;\n}\n\ntest \"t29\" {\n    assert (\n        _join_matchers({\"a\": [1, 2]}, {\"a\": [3]}, {\"b\": [10]})\n        == {\"a\": [1, 2, 3], \"b\": [10]}\n    );;\n}\n\ntest \"t30\" {\n    assert (\n        _join_matchers(\n            {\"a\": [1, 2, 3], \"b\": [4, 5, 6], \"default\": [10, 20]},\n            {\"a\": [5, 6, 7], \"b\": [8, 9]}\n        )\n        == {\"a\": [1, 2, 3, 5, 6, 7], \"b\": [4, 5, 6, 8, 9], \"default\": [10, 20]}\n    );;\n}\n\ntest \"t31\" {\n    assert (\n        _join_matchers({\"a\": [1, 2]}, {\"a\": [3, 4]}, {\"b\": [5, 6]})\n        == {\"a\": [1, 2, 3, 4], \"b\": [5, 6]}\n    );;\n}\n\ntest \"t32\" {\n    assert (_join_matchers({\"test\": [\"a\"]}) == {\"test\": [\"a\"]});;\n}\n\ntest \"t33\" {\n    assert (\n        _join_matchers(\n            {\"default\": [\"a\", \"b\"]},\n            {\"default\": [\"c\", \"d\"]},\n            {\"default\": [\"e\", \"f\"]},\n            {\"default\": [\"g\", \"h\"]}\n        )\n        == {\"default\": [\"a\", \"b\", \"c\", \"d\", \"e\", \"f\", \"g\", \"h\"]}\n    );;\n}\n\ntest \"t34\" {\n    assert (\n        _join_matchers(\n            {\"key1\": [\"a\", \"b\", \"c\"], \"key2\": [\"d\", \"e\"], \"key3\": [\"f\"]},\n            {\"key1\": [\"g\"], \"key2\": [\"h\"], \"key4\": [\"i\"]},\n            {\"key3\": [\"j\"], \"key4\": [\"k\"]},\n            {\"key2\": [\"l\"], \"key3\": [\"m\"], \"key4\": [\"n\"]}\n        )\n        == {\n            \"key1\": [\"a\", \"b\", \"c\", \"g\"],\n            \"key2\": [\"d\", \"e\", \"h\", \"l\"],\n            \"key3\": [\"f\", \"j\", \"m\"],\n            \"key4\": [\"i\", \"k\", \"n\"]\n        }\n    );;\n}\n\ntest \"t35\" {\n    assert (\n        _join_matchers(\n            {\"a\": [\"b\"], \"default\": [\"d\"]}, {\"a\": [\"e\"], \"default\": [\"f\"]}, {\"a\": [\"g\"]}\n        )\n        == {\"a\": [\"b\", \"e\", \"g\"], \"default\": [\"d\", \"f\"]}\n    );;\n}\n\ntest \"t36\" {\n    assert (\n        _join_matchers(\n            {\"a\": [1, 2, 3], \"b\": [4, 5, 6], \"c\": [7, 8, 9]},\n            {\"a\": [10, 11, 12], \"b\": [13, 14, 15]},\n            {\"a\": [16, 17, 18], \"b\": [19, 20, 21], \"c\": [22, 23, 24]}\n        )\n        == {\n            \"a\": [1, 2, 3, 10, 11, 12, 16, 17, 18],\n            \"b\": [4, 5, 6, 13, 14, 15, 19, 20, 21],\n            \"c\": [7, 8, 9, 22, 23, 24]\n        }\n    );;\n}\n\ntest \"t37\" {\n    assert (\n        _join_matchers({\"a\": [1, 2], \"default\": [\"d\"]})\n        == {\"a\": [1, 2], \"default\": [\"d\"]}\n    );;\n}\n\ntest \"t38\" {\n    assert (\n        _join_matchers({\"a\": [\"A\"], \"b\": [\"B\"]}, {\"b\": [\"C\"], \"c\": [\"D\"]}, {\"c\": [\"E\"]})\n        == {\"a\": [\"A\"], \"b\": [\"B\", \"C\"], \"c\": [\"D\", \"E\"]}\n    );;\n}\n\ntest \"t39\" {\n    assert (\n        _join_matchers({\"a\": [1]}, {\"a\": [2]}, {\"a\": [3], \"c\": [4]})\n        == {\"a\": [1, 2, 3], \"c\": [4]}\n    );;\n}\n\ntest \"t40\" {\n    assert (\n        _join_matchers({}, {}, {\"foo\": [\"bar\"], \"default\": [\"baz\", \"qux\"]})\n        == {\"foo\": [\"bar\"], \"default\": [\"baz\", \"qux\"]}\n    );;\n}\n\ntest \"t41\" {\n    assert (\n        _join_matchers({}, {\"default\": [\"baz\", \"qux\"]}, {})\n        == {\"default\": [\"baz\", \"qux\"]}\n    );;\n}\n\ntest \"t42\" {\n    assert (_join_matchers({}) == {});;\n}\n\ntest \"t43\" {\n    assert (\n        _join_matchers({'a': [1, 2, 3], 'b': [4]}, {'a': [5, 6]}, {'b': [7, 8]})\n        == {'a': [1, 2, 3, 5, 6], 'b': [4, 7, 8]}\n    );;\n}\n\ntest \"t44\" {\n    assert (\n        _join_matchers({\"a\": [1, 2], \"b\": [3, 4]}, {\"a\": [5, 6]}, {\"b\": [7, 8]})\n        == {\"a\": [1, 2, 5, 6], \"b\": [3, 4, 7, 8]}\n    );;\n}\n\ntest \"t45\" {\n    assert (\n        _join_matchers(\n            {\"default\": [\"a\", \"b\"]},\n            {\"default\": [\"c\", \"d\"]},\n            {\"default\": [\"e\", \"f\"]},\n            {\"default\": [\"g\", \"h\"]},\n            {\"default\": [\"i\", \"j\"]}\n        )\n        == {\"default\": [\"a\", \"b\", \"c\", \"d\", \"e\", \"f\", \"g\", \"h\", \"i\", \"j\"]}\n    );;\n}\n\ntest \"t46\" {\n    assert (\n        _join_matchers({\"a\": [1, 2, 3]}, {\"a\": [3, 4, 5]}, {\"a\": [5, 6, 7]})\n        == {\"a\": [1, 2, 3, 3, 4, 5, 5, 6, 7]}\n    );;\n}\n\ntest \"t47\" {\n    assert (\n        _join_matchers({\"default\": [\"d\"]}, {\"default\": [\"f\"]})\n        == {\"default\": [\"d\", \"f\"]}\n    );;\n}\n\ntest \"t48\" {\n    assert (\n        _join_matchers(\n            {\"a\": [1, 2], \"b\": [3, 4]}, {\"a\": [5, 6]}, {\"b\": [7, 8]}, {\"a\": [9, 10]}\n        )\n        == {\"a\": [1, 2, 5, 6, 9, 10], \"b\": [3, 4, 7, 8]}\n    );;\n}\n\ntest \"t49\" {\n    assert (\n        _join_matchers({\"a\": [1, 2], \"b\": [2, 3], \"c\": [2, 3], \"default\": [1, 2, 2, 3]})\n        == {\"a\": [1, 2], \"b\": [2, 3], \"c\": [2, 3], \"default\": [1, 2, 2, 3]}\n    );;\n}\n\ntest \"t50\" {\n    assert (\n        _join_matchers(\n            {\"a\": [1, 2], \"b\": [3, 4]},\n            {\"a\": [1], \"c\": [2]},\n            {\"a\": [2], \"b\": [3], \"d\": [4]}\n        )\n        == {\"a\": [1, 2, 1, 2], \"b\": [3, 4, 3], \"c\": [2], \"d\": [4]}\n    );;\n}\n\ntest \"t51\" {\n    assert (\n        _join_matchers(\n            {\"key1\": [\"a\", \"b\", \"c\"], \"key2\": [\"d\", \"e\"], \"key3\": [\"f\"]},\n            {\"key1\": [\"g\"], \"key2\": [\"h\"], \"key4\": [\"i\"]},\n            {\"key3\": [\"j\"], \"key4\": [\"k\"]}\n        )\n        == {\n            \"key1\": [\"a\", \"b\", \"c\", \"g\"],\n            \"key2\": [\"d\", \"e\", \"h\"],\n            \"key3\": [\"f\", \"j\"],\n            \"key4\": [\"i\", \"k\"]\n        }\n    );;\n}\n\ntest \"t52\" {\n    assert (_join_matchers({}, {}) == {});;\n}\n\ntest \"t53\" {\n    assert (\n        _join_matchers({\"a\": [1, 2]}, {\"a\": [3, 4]}, {\"a\": [5, 6]})\n        == {\"a\": [1, 2, 3, 4, 5, 6]}\n    );;\n}\n\ntest \"t54\" {\n    assert (\n        _join_matchers({\"a\": [\"1\", \"2\"], \"default\": [\"3\"]}, {\"a\": [\"4\", \"5\"]})\n        == {\"a\": [\"1\", \"2\", \"4\", \"5\"], \"default\": [\"3\"]}\n    );;\n}\n\ntest \"t55\" {\n    assert (\n        _join_matchers(\n            {\"foo\": [\"a\", \"b\"], \"baz\": [\"g\", \"h\"]},\n            {\"foo\": [\"c\"], \"baz\": [\"f\"], \"default\": [\"i\", \"j\"]}\n        )\n        == {\"foo\": [\"a\", \"b\", \"c\"], \"default\": [\"i\", \"j\"], \"baz\": [\"g\", \"h\", \"f\"]}\n    );;\n}"}