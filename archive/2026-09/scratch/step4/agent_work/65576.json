{"id": 65576, "entrypoint": "read_table_header_left", "coverage": 100, "stage": "floor_pass", "python": "def read_table_header_left(table):\n    \"\"\"\n    Read a table whit header in first column.\n\n    @param  table   Matrix format\n\n    @return dict    Dictionary with header as key\n    \"\"\"\n    data = {}\n    for row in table:\n        data[row[0]] = row[1:]\n\n    return data", "floor_fn": "\"\"\"\n    Read a table whit header in first column.\n\n    @param  table   Matrix format\n\n    @return dict    Dictionary with header as key\n    \"\"\"\ndef read_table_header_left(table: Any) -> object {\n    data = {};\n    for row in table {\n        data[row[0]] = row[1:];\n    }\n    return data;\n}", "test_blocks": "test \"t0\" {\n    assert (\n        read_table_header_left([['A', 'B', 'C'], ['D', 'E', 'F'], ['G', 'H', 'I']])\n        == {'A': ['B', 'C'], 'D': ['E', 'F'], 'G': ['H', 'I']}\n    );;\n}\n\ntest \"t1\" {\n    assert (\n        read_table_header_left([[\"a\", \"b\"], [\"c\", \"d\"]]) == {\"a\": [\"b\"], \"c\": [\"d\"]}\n    );;\n}\n\ntest \"t2\" {\n    assert (\n        read_table_header_left(\n            [\n                ['Harry', '37.21', 'NaN'],\n                ['Berry', '37.21', 'NaN'],\n                ['Tina', '37.2', 'NaN'],\n                ['Akriti', '41', 'NaN'],\n                ['Harsh', '39', '95']\n            ]\n        )\n        == {\n            'Harry': ['37.21', 'NaN'],\n            'Berry': ['37.21', 'NaN'],\n            'Tina': ['37.2', 'NaN'],\n            'Akriti': ['41', 'NaN'],\n            'Harsh': ['39', '95']\n        }\n    );;\n}\n\ntest \"t3\" {\n    assert (\n        read_table_header_left([[\"1\", \"2\", \"3\"], [\"A\", \"B\", \"C\"]])\n        == {\"1\": [\"2\", \"3\"], \"A\": [\"B\", \"C\"]}\n    );;\n}\n\ntest \"t4\" {\n    assert (read_table_header_left([]) == {});;\n}\n\ntest \"t5\" {\n    assert (\n        read_table_header_left([['c', 'd', 'e'], ['b', 'c', '3'], ['a', '1', '2']])\n        == {'a': ['1', '2'], 'b': ['c', '3'], 'c': ['d', 'e']}\n    );;\n}\n\ntest \"t6\" {\n    assert (\n        read_table_header_left([[\"1\", \"2\", \"3\"], [\"A\", \"B\", \"C\"], [\"D\", \"E\", \"F\"]])\n        == {\"1\": [\"2\", \"3\"], \"A\": [\"B\", \"C\"], \"D\": [\"E\", \"F\"]}\n    );;\n}\n\ntest \"t7\" {\n    assert (\n        read_table_header_left([['1', '2', '3'], ['a', 'b', 'c'], ['d', 'e', 'f']])\n        == {'1': ['2', '3'], 'a': ['b', 'c'], 'd': ['e', 'f']}\n    );;\n}\n\ntest \"t8\" {\n    assert (\n        read_table_header_left(\n            [['a', '1', '2', '3'], ['b', '2', '4', '6'], ['c', '3', '6', '9']]\n        )\n        == {'a': ['1', '2', '3'], 'b': ['2', '4', '6'], 'c': ['3', '6', '9']}\n    );;\n}\n\ntest \"t9\" {\n    assert (\n        read_table_header_left(\n            [[\"1\", \"2\", \"3\"], [\"A\", \"B\", \"C\"], [\"D\", \"E\", \"F\"], [\"G\", \"H\", \"I\"]]\n        )\n        == {\"1\": [\"2\", \"3\"], \"A\": [\"B\", \"C\"], \"D\": [\"E\", \"F\"], \"G\": [\"H\", \"I\"]}\n    );;\n}\n\ntest \"t10\" {\n    assert (\n        read_table_header_left(\n            [[\"a\", \"b\", \"c\"], [\"d\", \"e\", \"f\"], [\"g\", \"h\", \"i\"], [\"j\", \"k\", \"l\"]]\n        )\n        == {\"a\": [\"b\", \"c\"], \"d\": [\"e\", \"f\"], \"g\": [\"h\", \"i\"], \"j\": [\"k\", \"l\"]}\n    );;\n}\n\ntest \"t11\" {\n    assert (\n        read_table_header_left(\n            [['header', 'a', 'b', 'c'], ['data1', 1, 2, 3], ['data2', 4, 5, 6]]\n        )\n        == {'header': ['a', 'b', 'c'], 'data1': [1, 2, 3], 'data2': [4, 5, 6]}\n    );;\n}\n\ntest \"t12\" {\n    assert (\n        read_table_header_left([['a', '1'], ['b', '2'], ['c', '3']])\n        == {'a': ['1'], 'b': ['2'], 'c': ['3']}\n    );;\n}\n\ntest \"t13\" {\n    assert (\n        read_table_header_left(\n            [\n                [\"1\", \"2\", \"3\"],\n                [\"A\", \"B\", \"C\"],\n                [\"D\", \"E\", \"F\"],\n                [\"G\", \"H\", \"I\"],\n                [\"J\", \"K\", \"L\"]\n            ]\n        )\n        == {\n            \"1\": [\"2\", \"3\"],\n            \"A\": [\"B\", \"C\"],\n            \"D\": [\"E\", \"F\"],\n            \"G\": [\"H\", \"I\"],\n            \"J\": [\"K\", \"L\"]\n        }\n    );;\n}\n\ntest \"t14\" {\n    assert (\n        read_table_header_left([['a', 'b', 'c'], ['d', 'e', 'f'], ['g', 'h', 'i']])\n        == {'a': ['b', 'c'], 'd': ['e', 'f'], 'g': ['h', 'i']}\n    );;\n}\n\ntest \"t15\" {\n    assert (\n        read_table_header_left([['a', '1', '2'], ['b', 'c', '3'], ['c', 'd', 'e']])\n        == {'a': ['1', '2'], 'b': ['c', '3'], 'c': ['d', 'e']}\n    );;\n}\n\ntest \"t16\" {\n    assert (\n        read_table_header_left([['a', '1'], ['b', '2'], ['c', '3']])\n        == {'a': ['1'], 'b': ['2'], 'c': ['3']}\n    );;\n}\n\ntest \"t17\" {\n    assert (\n        read_table_header_left([['a', 'b', 'c'], ['d', 'e', 'f']])\n        == {'a': ['b', 'c'], 'd': ['e', 'f']}\n    );;\n}\n\ntest \"t18\" {\n    assert (\n        read_table_header_left([['A', 'B', 'C'], ['D', 'E', 'F']])\n        == {'A': ['B', 'C'], 'D': ['E', 'F']}\n    );;\n}\n\ntest \"t19\" {\n    assert (\n        read_table_header_left([[\"a\"], [\"b\"], [\"c\"]]) == {\"a\": [], \"b\": [], \"c\": []}\n    );;\n}\n\ntest \"t20\" {\n    assert (\n        read_table_header_left([[\"a\", \"b\", \"c\"], [\"d\", \"e\", \"f\"], [\"g\", \"h\", \"i\"]])\n        == {\"a\": [\"b\", \"c\"], \"d\": [\"e\", \"f\"], \"g\": [\"h\", \"i\"]}\n    );;\n}\n\ntest \"t21\" {\n    assert (\n        read_table_header_left(\n            [\n                ['Harry', '37.21', '95'],\n                ['Berry', '37.21', '95'],\n                ['Tina', '37.2', '95'],\n                ['Akriti', '41', '95'],\n                ['Harsh', '39', '95']\n            ]\n        )\n        == {\n            'Harry': ['37.21', '95'],\n            'Berry': ['37.21', '95'],\n            'Tina': ['37.2', '95'],\n            'Akriti': ['41', '95'],\n            'Harsh': ['39', '95']\n        }\n    );;\n}\n\ntest \"t22\" {\n    assert (\n        read_table_header_left([[\"a\", \"b\"], [\"c\", \"d\"], [\"e\", \"f\"]])\n        == {\"a\": [\"b\"], \"c\": [\"d\"], \"e\": [\"f\"]}\n    );;\n}"}