{"id": 45508, "entrypoint": "_next_break", "coverage": 100, "stage": "floor_pass", "python": "def _next_break(primitive_boundaries, pos, expects):\n    \"\"\"(internal)\n    \"\"\"\n\n    for i in range(pos, len(primitive_boundaries)):\n        sb = primitive_boundaries[i][1]\n        if sb in expects:\n            return sb\n    return None", "floor_fn": "\"\"\"(internal)\n    \"\"\"\ndef _next_break(primitive_boundaries: Any, pos: Any, expects: Any) -> object {\n    for i in range(pos, len(primitive_boundaries)) {\n        sb = primitive_boundaries[i][1];\n        if (sb in expects) {\n            return sb;\n        }\n    }\n    return None;\n}", "test_blocks": "test \"t0\" {\n    assert (\n        _next_break(\n            [(0, \"a\"), (4, \"b\"), (8, \"c\"), (12, \"d\"), (13, \"e\"), (18, \"f\")], 2, [\"d\"]\n        )\n        == \"d\"\n    );;\n}\n\ntest \"t1\" {\n    assert (_next_break([(0, 1), (1, 2), (2, 3), (3, 4), (4, 5)], 0, (2, )) == 2);;\n}\n\ntest \"t2\" {\n    assert (\n        _next_break([(1, 'a'), (2, 'b'), (3, 'c'), (4, 'd'), (5, 'e')], 0, ('d', 'e'))\n        == 'd'\n    );;\n}\n\ntest \"t3\" {\n    assert (_next_break([(10, 12), (13, 14), (15, 16)], 0, `set([11, 14, 15])) == 14);;\n}\n\ntest \"t4\" {\n    assert (\n        _next_break([(1, 'a'), (2, 'b'), (3, 'c'), (4, 'd'), (5, 'e')], 0, ('b', 'c'))\n        == 'b'\n    );;\n}\n\ntest \"t5\" {\n    assert (_next_break([(0, 'A'), (1, 'B'), (2, 'C')], 1, ['B']) == 'B');;\n}\n\ntest \"t6\" {\n    assert (\n        _next_break(\n            [(0, 'a'), (1, 'b'), (3, 'c'), (5, 'd'), (8, 'e'), (9, 'f')],\n            0,\n            ('a', 'b', 'c')\n        )\n        == 'a'\n    );;\n}\n\ntest \"t7\" {\n    assert (\n        _next_break(\n            [(0, 10, \"foo\"), (10, 20, \"bar\"), (20, 30, \"baz\")],\n            2,\n            [(\"foo\", \"bar\"), (\"bar\", \"baz\")]\n        )\n        == None\n    );;\n}\n\ntest \"t8\" {\n    assert (\n        _next_break([(0, \"1\"), (1, \"2\"), (2, \"3\"), (3, \"4\")], 2, [\"2\", \"3\"]) == \"3\"\n    );;\n}\n\ntest \"t9\" {\n    assert (\n        _next_break([(None, 'a'), ('a', 'b'), ('b', 'c'), ('c', None)], 0, ('c', 'a'))\n        == 'a'\n    );;\n}\n\ntest \"t10\" {\n    assert (_next_break([(0, 'X'), (0, 'Y'), (0, 'Z')], 0, `set(['X'])) == 'X');;\n}\n\ntest \"t11\" {\n    assert (\n        _next_break(\n            [(0, 'foo'), (3, 'bar'), (5, 'baz'), (6, 'spam'), (11, 'eggs')],\n            1,\n            `set(['bar', 'baz'])\n        )\n        == 'bar'\n    );;\n}\n\ntest \"t12\" {\n    assert (_next_break([(0, 'a'), (1, 'b')], 0, ['b']) == 'b');;\n}\n\ntest \"t13\" {\n    assert (_next_break([(0, 'X')], 0, `set(['X'])) == 'X');;\n}\n\ntest \"t14\" {\n    assert (\n        _next_break(\n            [(0, 's'), (1, 'a'), (2, 'b'), (3, 'c'), (4, 'd'), (5, 'e'), (6, 'f')],\n            0,\n            `set(['b'])\n        )\n        == 'b'\n    );;\n}\n\ntest \"t15\" {\n    assert (_next_break([(0, 1), (1, 2), (2, 3), (3, 4), (4, 5)], 0, (1, )) == 1);;\n}\n\ntest \"t16\" {\n    assert (_next_break([(10, 12), (13, 14)], 0, `set([11, 14])) == 14);;\n}\n\ntest \"t17\" {\n    assert (_next_break([(10, 12)], 0, `set()) == None);;\n}\n\ntest \"t18\" {\n    assert (\n        _next_break([(0, \"a\"), (1, \"b\"), (2, \"c\")], 3, `set([\"a\", \"b\", \"c\"])) == None\n    );;\n}\n\ntest \"t19\" {\n    assert (\n        _next_break([('', 0), (' ', 1), ('  ', 2), ('   ', 3)], 3, {' ', ' ', '  '})\n        == None\n    );;\n}\n\ntest \"t20\" {\n    assert (\n        _next_break([(None, 'a'), ('a', 'b'), ('b', 'c'), ('c', None)], 0, ('a', 'c'))\n        == 'a'\n    );;\n}\n\ntest \"t21\" {\n    assert (\n        _next_break(\n            [(0, 's'), (1, 'a'), (2, 'b'), (3, 'c'), (4, 'd'), (5, 'e'), (6, 'f')],\n            0,\n            `set(['a'])\n        )\n        == 'a'\n    );;\n}\n\ntest \"t22\" {\n    assert (_next_break([(\"a\", 1), (\"b\", 2), (\"c\", 3)], 0, [\"c\"]) == None);;\n}\n\ntest \"t23\" {\n    assert