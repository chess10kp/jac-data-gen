{"id": 250112, "entrypoint": "check_conditions", "coverage": 100, "stage": "floor_pass", "python": "def check_conditions(line, category, method, thresh=0.3):\n    \"\"\"Check conditions of our or m3d txt file\"\"\"\n\n    check = False\n    assert category in ['pedestrian', 'cyclist', 'all']\n\n    if category == 'all':\n        category = ['pedestrian', 'person_sitting', 'cyclist']\n\n    if method == 'gt':\n        if line.split()[0].lower() in category:\n            check = True\n\n    else:\n        conf = float(line[15])\n        if line[0].lower() in category and conf >= thresh:\n            check = True\n    return check", "floor_fn": "\"\"\"Check conditions of our or m3d txt file\"\"\"\ndef check_conditions(\n    line: Any, category: Any, method: Any, thresh: Any = 0.3\n) -> object {\n    check = False;\n    assert (category in ['pedestrian', 'cyclist', 'all']);\n    if (category == 'all') {\n        category = ['pedestrian', 'person_sitting', 'cyclist'];\n    }\n    if (method == 'gt') {\n        if (line.split()[0].lower() in category) {\n            check = True;\n        }\n    } else {\n        conf = float(line[15]);\n        if ((line[0].lower() in category) and (conf >= thresh)) {\n            check = True;\n        }\n    }\n    return check;\n}", "test_blocks": "test \"t0\" {\n    assert (\n        check_conditions(\n            'Pedestrian -1.048000 2.393117 25.39 55.19 0.00 0.00 0.00 1.47 1.43 0.89 1.75 0.11 -1.00',\n            'pedestrian',\n            'pred'\n        )\n        == True\n    );;\n}\n\ntest \"t1\" {\n    assert (\n        check_conditions(\n            \"Pedestrian -1.000 2.435 0.300 2.085 -1.000 2.528 0.298 2.089 0.860\",\n            'all',\n            'gt'\n        )\n        == True\n    );;\n}\n\ntest \"t2\" {\n    assert (\n        check_conditions(\n            \"Pedestrian -1.43806400 0.02384200 9.59459000 -1.43788800 -0.02252800 9.59772000 -0.00011400 0.00009300 0.99999900 100.00000000 100.00000000 100.00000000 100.00000000 0.00000000 0.00000000\",\n            \"cyclist\",\n            \"gt\"\n        )\n        == False\n    );;\n}\n\ntest \"t3\" {\n    assert (\n        check_conditions(\n            \"Pedestrian -1.42643200 1.91590794 11.57972601 5.13582301 -0.00653605 -0.18086202 2.92082300\",\n            'cyclist',\n            'gt'\n        )\n        == False\n    );;\n}\n\ntest \"t4\" {\n    assert (\n        check_conditions(\n            \"Pedestrian -1.364071 0.068565 0.246584 -0.149823 -0.074883 -0.160386 -0.186543 0.031109 0.025261 0.136892 0.184083 0.089131 1.000000\",\n            'cyclist',\n            'gt'\n        )\n        == False\n    );;\n}\n\ntest \"t5\" {\n    assert (\n        check_conditions(\n            'Pedestrian 0.365302 183.837802 -14.795721 183.561104 -15.071951 2.145686 216.223892 143.167198 3.189478 216.512505 142.747978 0.999600 2.096340',\n            'pedestrian',\n            'gt',\n            0.3\n        )\n        == True\n    );;\n}\n\ntest \"t6\" {\n    assert (\n        check_conditions(\n            'Pedestrian -1.048000 2.393117 25.39 55.19 0.00 0.00 0.00 1.47 1.43 0.89 1.75 0.11 -1.00',\n            'pedestrian',\n            'gt'\n        )\n        == True\n    );;\n}\n\ntest \"t7\" {\n    assert (\n        check_conditions(\n            'Pedestrian -1.048000 2.393117 25.39 55.19 0.00 0.00 0.00 1.47 1.43 0.89 1.75 0.11 -1.00',\n            'cyclist',\n            'gt'\n        )\n        == False\n    );;\n}\n\ntest \"t8\" {\n    assert (\n        check_conditions(\n            \"Pedestrian 0.80 0 1.157130 2.481135 1.874954 0.877676 1.219432 1.600000 -1.000000 1.650000 0.800000\",\n            'pedestrian',\n            'gt'\n        )\n        == True\n    );;\n}\n\ntest \"t9\" {\n    assert (\n        check_conditions(\n            \"Pedestrian -1.42643200 1.91590794 11.57972601 5.13582301 -0.00653605 -0.18086202 2.92082300\",\n            'all',\n            'gt'\n        )\n        == True\n    );;\n}\n\ntest \"t10\" {\