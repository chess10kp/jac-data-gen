\" {\n    assert (\n        ris_DependentField_get(\n            'A1',\n            {\n                'TY': {'AB': ['SO', 'SS']},\n                'A1': ['B'],\n                'T1': ['B'],\n                'AU': ['A'],\n                'TI': ['A'],\n                'PY': ['A'],\n                'VL': ['A'],\n                'SN': ['A'],\n                'ER': ['A'],\n                'UR': ['A'],\n                'AB': ['A'],\n                'C1': ['A'],\n                'SP': ['A'],\n                'M1': ['A'],\n                'M2': ['A']\n            }\n        )\n        == {'A1': ['B']}\n    );;\n}\n\ntest \"t3\" {\n    assert (\n        ris_DependentField_get(\n            'TY',\n            {'TY': {'AB': ['A', 'B'], 'C': 'D'}, 'A': {'B': [], 'C': 'D', 'F': []}}\n        )\n        == {'TY': {'AB': ['A', 'B'], 'C': 'D'}}\n    );;\n}\n\ntest \"t4\" {\n    assert (ris_DependentField_get('A', {}) == {});;\n}\n\ntest \"t5\" {\n    assert (\n        ris_DependentField_get(\n            'TY',\n            {\n                'TY': {'AB': ['SO', 'SS']},\n                'A1': ['B'],\n                'T1': ['B'],\n                'AU': ['A'],\n                'TI': ['A'],\n                'PY': ['A'],\n                'VL': ['A'],\n                'SN': ['A'],\n                'ER': ['A'],\n                'UR': ['A'],\n                'AB': ['A'],\n                'C1': ['A'],\n                'SP': ['A'],\n                'M1': ['A'],\n                'M2': ['A']\n            }\n        )\n        == {'TY': {'AB': ['SO', 'SS']}}\n    );;\n}\n\ntest \"t6\" {\n    assert (\n        ris_DependentField_get(\n            'T1',\n            {\n                'TY': {'AB': ['SO', 'SS']},\n                'A1': ['B'],\n                'T1': ['B'],\n                'AU': ['A'],\n                'TI': ['A'],\n                'PY': ['A'],\n                'VL': ['A'],\n                'SN': ['A'],\n                'ER': ['A'],\n                'UR': ['A'],\n                'AB': ['A'],\n                'C1': ['A'],\n                'SP': ['A'],\n                'M1': ['A'],\n                'M2': ['A']\n            }\n        )\n        == {'T1': ['B']}\n    );;\n}\n\ntest \"t7\" {\n    assert (\n        ris_DependentField_get(\n            'TY', {'TY': {'AB': {'AC': 'foo', 'AU': 'bar'}, 'AD': 'qux'}}\n        )\n        == {'TY': {'AB': {'AC': 'foo', 'AU': 'bar'}, 'AD': 'qux'}}\n    );;\n}\n\ntest \"t8\" {\n    assert (\n        ris_DependentField_get(\n            'A', {'TY': {'AB': ['A', 'B'], 'C': 'D'}, 'A': {'B': [], 'C': 'D', 'F': []}}\n        )\n        == {'A': {'B': [], 'C': 'D', 'F': []}}\n    );;\n}\n\ntest \"t9\" {\n    assert (ris_DependentField_get('B', {'TY': {'AB': ['A', 'B'], 'C': 'D'}}) == {});;\n}\n\ntest \"t10\" {\n    assert (\n        ris_DependentField_get(\n            'TY',\n            {\n                'TY': {'A1': ['B1', 'C1', 'D1'], 'A2': ['B2', 'C2', 'D2']},\n                'AU': {'A3': ['B3', 'C3', 'D3'], 'A4': ['B4', 'C4', 'D4']},\n                'PB': {'A5': ['B5', 'C5', 'D5'], 'A6': ['B6', 'C6', 'D6']}\n            }\n        )\n        == {'TY': {'A1': ['B1', 'C1', 'D1'], 'A2': ['B2', 'C2', 'D2']}}\n    );;\n}\n\ntest \"t11\" {\n    assert (ris_DependentField_get('TY', {}) == {});;\n}\n\ntest \"t12\" {\n    assert (\n        ris_DependentField_get(\n            'A',\n            {\n                'TY': {'AB': ['A', 'B'], 'C': 'D'},\n                'A': {'B': [], 'C': 'D', 'F': []},\n                'B': {'C': 'D', 'F': []}\n            }\n        )\n        == {'A': {'B': [], 'C': 'D', 'F': []}}\n    );;\n}"}