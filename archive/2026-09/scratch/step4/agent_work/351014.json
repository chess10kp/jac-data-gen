{"id": 351014, "entrypoint": "cliprgb", "coverage": 100, "stage": "floor_pass", "python": "def cliprgb(r, g, b):\n    \"\"\" clip r,g,b values into range 0..254 \"\"\"\n    def clip(x):\n        \"\"\" clip x value into range 0..254 \"\"\"\n        if x < 0:\n            x = 0\n        elif x > 254:\n            x = 254\n        return x\n    return clip(r), clip(g), clip(b)", "floor_fn": "\"\"\" clip r,g,b values into range 0..254 \"\"\"\ndef cliprgb(r: Any, g: Any, b: Any) -> object {\n    \"\"\" clip x value into range 0..254 \"\"\";\n    def clip(x: Any) -> object {\n        if (x < 0) {\n            x = 0;\n        } elif (x > 254) {\n            x = 254;\n        }\n        return x;\n    }\n    return (clip(r), clip(g), clip(b));\n}", "test_blocks": "test \"t0\" {\n    assert (cliprgb(102, 153, 204) == (102, 153, 204));;\n}\n\ntest \"t1\" {\n    assert (cliprgb(200, 200, 200) == (200, 200, 200));;\n}\n\ntest \"t2\" {\n    assert (cliprgb(254, 254, 255) == (254, 254, 254));;\n}\n\ntest \"t3\" {\n    assert (cliprgb(0, 1, 255) == (0, 1, 254));;\n}\n\ntest \"t4\" {\n    assert (cliprgb(246, 246, 246) == (246, 246, 246));;\n}\n\ntest \"t5\" {\n    assert (cliprgb(100, 100, -1) == (100, 100, 0));;\n}\n\ntest \"t6\" {\n    assert (cliprgb(33, 33, 33) == (33, 33, 33));;\n}\n\ntest \"t7\" {\n    assert (cliprgb(256, 0, 0) == (254, 0, 0));;\n}\n\ntest \"t8\" {\n    assert (cliprgb(248, 248, 248) == (248, 248, 248));;\n}\n\ntest \"t9\" {\n    assert (cliprgb(100, 100, 150) == (100, 100, 150));;\n}\n\ntest \"t10\" {\n    assert (cliprgb(0, 1, 254) == (0, 1, 254));;\n}\n\ntest \"t11\" {\n    assert (cliprgb(100, 256, -100) == (100, 254, 0));;\n}\n\ntest \"t12\" {\n    assert (cliprgb(100, 120, 255) == (100, 120, 254));;\n}\n\ntest \"t13\" {\n    assert (cliprgb(0, 2, 0) == (0, 2, 0));;\n}\n\ntest \"t14\" {\n    assert (cliprgb(0, 0, -1) == (0, 0, 0));;\n}\n\ntest \"t15\" {\n    assert (cliprgb(0, 1, 2) == (0, 1, 2));;\n}\n\ntest \"t16\" {\n    assert (cliprgb(0, 1, 1) == (0, 1, 1));;\n}\n\ntest \"t17\" {\n    assert (cliprgb(100, 200, 100) == (100, 200, 100));;\n}\n\ntest \"t18\" {\n    assert (cliprgb(0, 0, 0) == (0, 0, 0));;\n}\n\ntest \"t19\" {\n    assert (cliprgb(251, 251, 251) == (251, 251, 251));;\n}\n\ntest \"t20\" {\n    assert (cliprgb(0, 0, 0) == (0, 0, 0));;\n}\n\ntest \"t21\" {\n    assert (cliprgb(0, 1, 0) == (0, 1, 0));;\n}\n\ntest \"t22\" {\n    assert (cliprgb(255, 255, 254) == (254, 254, 254));;\n}\n\ntest \"t23\" {\n    assert (cliprgb(-2, -2, -2) == (0, 0, 0));;\n}\n\ntest \"t24\" {\n    assert (cliprgb(0, 0, 2) == (0, 0, 2));;\n}\n\ntest \"t25\" {\n    assert (cliprgb(100, 255, 100) == (100, 254, 100));;\n}\n\ntest \"t26\" {\n    assert (cliprgb(100, 100, 100) == (100, 100, 100));;\n}\n\ntest \"t27\" {\n    assert (cliprgb(0, 0, 255) == (0, 0, 254));;\n}\n\ntest \"t28\" {\n    assert (cliprgb(0, 256, 0) == (0, 254, 0));;\n}\n\ntest \"t29\" {\n    assert (cliprgb(51, 102, 153) == (51, 102, 153));;\n}\n\ntest \"t30\" {\n    assert (cliprgb(0, 254, 0) == (0, 254, 0));;\n}\n\ntest \"t31\" {\n    assert (cliprgb(100, 120, 100) == (100, 120, 100));;\n}\n\ntest \"t32\" {\n    assert (cliprgb(250, 250, 250) == (250, 250, 250));;\n}\n\ntest \"t33\" {\n    assert (cliprgb(255, 100, 100) == (254, 100, 100));;\n}\n\ntest \"t34\" {\n    assert (cliprgb(247, 247, 247) == (247, 247, 247));;\n}\n\ntest \"t35\" {\n    assert (cliprgb(1, 2, 3) == (1, 2, 3));;\n}\n\ntest \"t36\" {\n    assert (cliprgb(255, 255, 0) == (254, 254, 0));;\n}\n\ntest \"t37\" {\n    assert (cliprgb(300, 300, 300) == (254, 254, 254));;\n}\n\ntest \"t38\" {\n    assert (cliprgb(-1, -2, -3) == (0, 0, 0));;\n}\n\ntest \"t39\" {\n    assert (cliprgb(255, 255, 100) == (254, 254, 100));;\n}\n\ntest \"t40\" {\n    assert (cliprgb(0, 0, 254) == (0, 0, 254));;\n}\n\ntest \"t41\" {\n    assert (cliprgb(249, 249, 249) == (249, 249, 249));;\n}\n\ntest \"t42\" {\n    assert (cliprgb(1, 0, 0) == (1, 0, 0));;\n}\n\ntest \"t43\" {\n    assert (cliprgb(0, 2, 2) == (0, 2,