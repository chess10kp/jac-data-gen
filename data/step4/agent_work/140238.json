{"id": 140238, "entrypoint": "str2dict", "coverage": 99, "stage": "floor_pass", "python": "def str2dict(str_):\n    \"\"\"Change str to dict.\"\"\"\n    if not isinstance(str_, str):\n        raise TypeError('\"str_\" must be a string, not {}'.format(type(str_)))\n    # to keep the keys order\n    str_.replace('dict(', 'OrderedDict(')\n    return eval(str_)", "floor_fn": "\"\"\"Change str to dict.\"\"\"\ndef str2dict(str_: Any) -> object {\n    if not isinstance(str_, str) {\n        raise TypeError('\"str_\" must be a string, not {}'.format(`type(str_)));\n    }\n    str_.replace('dict(', 'OrderedDict(');\n    return eval(str_);\n}", "test_blocks": "test \"t0\" {\n    assert (str2dict(r'{\"x\": 1, \"y\": 2}') == {'x': 1, 'y': 2});;\n}\n\ntest \"t1\" {\n    assert (str2dict(r\"{'a': 1, 'b': 2, 'c': 3}\") == {'a': 1, 'b': 2, 'c': 3});;\n}\n\ntest \"t2\" {\n    assert (str2dict(r'dict(a=3, b=4, c=5)') == {'a': 3, 'b': 4, 'c': 5});;\n}\n\ntest \"t3\" {\n    assert (str2dict(r'dict(a=dict(b=2), c=3)') == {'a': {'b': 2}, 'c': 3});;\n}\n\ntest \"t4\" {\n    assert (\n        str2dict(r'''\ndict(a=1, b=2,\n             c=3)\n''') == {'a': 1, 'b': 2, 'c': 3}\n    );;\n}\n\ntest \"t5\" {\n    assert (str2dict('{\"x\": 1, \"y\": 2, \"z\": 4}') == {'x': 1, 'y': 2, 'z': 4});;\n}\n\ntest \"t6\" {\n    assert (\n        str2dict(r'{\"a\": \"A\", \"b\": \"B\", \"c\": \"C\", \"d\": \"D\"}')\n        == {'a': \"A\", 'b': \"B\", 'c': \"C\", 'd': \"D\"}\n    );;\n}\n\ntest \"t7\" {\n    assert (str2dict(r'dict(a=3, b=4)') == {'a': 3, 'b': 4});;\n}\n\ntest \"t8\" {\n    assert (str2dict(str(0)) == 0);;\n}\n\ntest \"t9\" {\n    assert (str2dict(r'{\"A\": 1, \"B\": 2, \"C\": 3}') == {'A': 1, 'B': 2, 'C': 3});;\n}\n\ntest \"t10\" {\n    assert (str2dict(r'dict(a=dict(b=dict(c=1)))') == {'a': {'b': {'c': 1}}});;\n}\n\ntest \"t11\" {\n    assert (str2dict(str({})) == {});;\n}\n\ntest \"t12\" {\n    assert (\n        str2dict(str({1: 'a', 2: {1: 'b', 2: 'c'}})) == {1: 'a', 2: {1: 'b', 2: 'c'}}\n    );;\n}\n\ntest \"t13\" {\n    assert (str2dict(r'{\"a\": \"b\"}') == {'a': 'b'});;\n}\n\ntest \"t14\" {\n    assert (str2dict(r\"dict(a=1, b=2)\") == {'a': 1, 'b': 2});;\n}\n\ntest \"t15\" {\n    assert (str2dict('{\" \": \"a\"}') == {' ': 'a'});;\n}\n\ntest \"t16\" {\n    assert (str2dict(str({'a': {1: 'b', 2: 'c'}})) == {'a': {1: 'b', 2: 'c'}});;\n}\n\ntest \"t17\" {\n    assert (\n        str2dict('dict(a=1, b=\"abc\", c=dict(d=2, e=3))')\n        == {'a': 1, 'b': 'abc', 'c': {'d': 2, 'e': 3}}\n    );;\n}\n\ntest \"t18\" {\n    assert (\n        str2dict(r'{\"A\": \"a\", \"B\": \"b\", \"C\": \"c\"}') == {'A': \"a\", 'B': \"b\", 'C': \"c\"}\n    );;\n}\n\ntest \"t19\" {\n    assert (str2dict(r'dict(a=3, b=4, c=5, d=6)') == {'a': 3, 'b': 4, 'c': 5, 'd': 6});;\n}\n\ntest \"t20\" {\n    assert (str2dict('{\"x\": 1, \"y\": [2, 3], \"z\": 4}') == {'x': 1, 'y': [2, 3], 'z': 4});;\n}\n\ntest \"t21\" {\n    assert (str2dict(r'{\"a\": 1, \"b\": 2}') == {'a': 1, 'b': 2});;\n}\n\ntest \"t22\" {\n    assert (str2dict(r'dict(a=3)') == {'a': 3});;\n}\n\ntest \"t23\" {\n    assert (str2dict(r'dict()') == `dict());;\n}\n\ntest \"t24\" {\n    assert (\n        str2dict(\n            '{'\n            '\"key1\": \"value1\", '\n            '\"key2\": 2, '\n            '\"key3\": 1.0, '\n            '\"key4\": [1, 2], '\n            '\"key5\": [\"a\", \"b\"], '\n            '\"key6\": {\"a\": 1}, '\n            '\"key7\": [\"a\", {\"b\": \"c\"}], '\n            '\"key8\": {\"a\": 1, \"b\": \"c\"}, '\n            '\"key9\": [{\"a\": 1}, {\"b\": \"c\"}], '\n            '\"key10\": [\"a\", [\"b\", \"c\"]]'\n            '}'\n        )\n        == {\n            'key1': 'value1',\n            'key2': 2,\n            'key3': 1.0,\n            'key4': [1, 2],\n            'key5': ['a', 'b'],\n            'key6': {'a': 1},\n            'key7': ['a', {'b': 'c'}],\n            'key8': {'a': 1, 'b': 'c'},\n            'key9': [{'a': 1}, {'b': 'c'}],\n            'key10': ['a', ['b', 'c']]\n        }\n    );;\n}\n\ntest \"t25\" {\n    assert (str2dict(str({'1': 1, '2': 2})) == {'1': 1, '2': 2});;\n}\n\ntest \"t26\" {\n    assert (\n        str2dict(r'{\"a\": 1, \"b\": 2, \"c\": 3, \"d\": 4, \"e\": 5}')\n        == {\"a\": 1, \"b\": 2, \"c\": 3, \"d\": 4, \"e\": 5}\n    );;\n}\n\ntest \"t27\" {\n    assert (str2dict('{\"x\": 1, \"y\": 2, \"z\": 3}') == {'x': 1, 'y': 2, 'z': 3});;\n}\n\ntest \"t28\" {\n    assert (str2dict(r'dict(a=1, b=\"hello\")') == {'a': 1, 'b': \"hello\"});;\n}\n\ntest \"t29\" {\n    assert (str2dict(r'{1: \"a\", 2: \"b\", 3: \"c\"}') == {1: \"a\", 2: \"b\", 3: \"c\"});;\n}\n\ntest \"t30\" {\n    assert (\n        str2dict(r'{\"a\": 1, \"b\": 2, \"c\": 3, \"d\": 4}')\n        == {\"a\": 1, \"b\": 2, \"c\": 3, \"d\": 4}\n    );;\n}\n\ntest \"t31\" {\n    assert (str2dict(str({'1': {'2': {'3': 3}}})) == {'1': {'2': {'3': 3}}});;\n}\n\ntest \"t32\" {\n    assert (str2dict(r'dict(c=5, a=3, b=4)') == {'a': 3, 'b': 4, 'c': 5});;\n}\n\ntest \"t33\" {\n    assert (str2dict(str(1)) == 1);;\n}\n\ntest \"t34\" {\n    assert (str2dict('{\"x\": 1, \"y\": b\"two\", \"z\": 4}') == {'x': 1, 'y': b'two', 'z': 4});;\n}\n\ntest \"t35\" {\n    assert (str2dict(r\"{'a': 1, 'b': 2}\") == {'a': 1, 'b': 2});;\n}\n\ntest \"t36\" {\n    assert (str2dict(str('{\"1\": 1, \"2\": 2}')) == str2dict(str('{\"2\": 2, \"1\": 1}')));;\n}\n\ntest \"t37\" {\n    assert (str2dict(r'{\"a\": 1}') == {'a': 1});;\n}\n\ntest \"t38\" {\n    assert (str2dict('{\"x\": 1, \"y\": 2.5, \"z\": 4}') == {'x': 1, 'y': 2.5, 'z': 4});;\n}\n\ntest \"t39\" {\n    assert (\n        str2dict(r'{\"a\": \"A\", \"b\": \"B\", \"c\": \"C\"}') == {'a': \"A\", 'b': \"B\", 'c': \"C\"}\n    );;\n}\n\ntest \"t40\" {\n    assert (str2dict(str({1: 'a', 2: 'b'})) == {1: 'a', 2: 'b'});;\n}\n\ntest \"t41\" {\n    assert (str2dict('dict()') == `dict());;\n}\n\ntest \"t42\" {\n    assert (str2dict(str(None)) == None);;\n}\n\ntest \"t43\" {\n    assert (str2dict(str('{\"1\": 1, \"2\": 2}')) == str2dict(str('{\"2\": 2, \"1\": 1,}')));;\n}\n\ntest \"t44\" {\n    assert (str2dict(r'dict(a=1, b=2)') == {'a': 1, 'b': 2});;\n}\n\ntest \"t45\" {\n    assert (\n        str2dict(r'''dict(a=1, b=2,\n             c=3)''') == {'a': 1, 'b': 2, 'c': 3}\n    );;\n}\n\ntest \"t46\" {\n    assert (str2dict(\"dict()\") == `dict());;\n}\n\ntest \"t47\" {\n    assert (str2dict(r\"{}\") == {});;\n}\n\ntest \"t48\" {\n    assert (str2dict('{\"key\": \"value\"}') == {'key': 'value'});;\n}\n\ntest \"t49\" {\n    assert (str2dict(r'dict(a=1, b=2, c=3)') == {'a': 1, 'b': 2, 'c': 3});;\n}\n\ntest \"t50\" {\n    assert (str2dict(r\"dict()\") == {});;\n}\n\ntest \"t51\" {\n    assert (str2dict(r'{\"a\": 1, \"b\": 2, \"c\": 3}') == {\"a\": 1, \"b\": 2, \"c\": 3});;\n}\n\ntest \"t52\" {\n    assert (str2dict(str({'a': 1})) == {'a': 1});;\n}\n\ntest \"t53\" {\n    assert (\n        str2dict(r'{\"a\": 1, \"b\": 2, \"c\": 3, \"d\": 4, \"e\": 5, \"f\": 6}')\n        == {\"a\": 1, \"b\": 2, \"c\": 3, \"d\": 4, \"e\": 5, \"f\": 6}\n    );;\n}\n\ntest \"t54\" {\n    assert (str2dict(r'dict()') == {});;\n}\n\ntest \"t55\" {\n    assert (str2dict(\"dict({1: 2})\") == `dict({1: 2}));;\n}\n\ntest \"t56\" {\n    assert (str2dict('{\"x\": 1, \"y\": (2, 3), \"z\": 4}') == {'x': 1, 'y': (2, 3), 'z': 4});;\n}\n\ntest \"t57\" {\n    assert (str2dict('{\"x\": 1, \"y\": \"two\", \"z\": 4}') == {'x': 1, 'y': 'two', 'z': 4});;\n}\n\ntest \"t58\" {\n    assert (str2dict('{\"key\": 1}') == {'key': 1});;\n}\n\ntest \"t59\" {\n    assert (str2dict(r'dict(a=1, b=\"abc\")') == {'a': 1, 'b': 'abc'});;\n}\n\ntest \"t60\" {\n    assert (str2dict(r\"{'a': 1}\") == {'a': 1});;\n}\n\ntest \"t61\" {\n    assert (str2dict(r'''\ndict(a=1, b=2,\n     c=3)\n''') == {'a': 1, 'b': 2, 'c': 3});;\n}\n\ntest \"t62\" {\n    assert (str2dict(r'dict(a=1)') == {'a': 1});;\n}\n\ntest \"t63\" {\n    assert (\n        str2dict(r'{\"a\": 1, \"b\": 2, \"c\": 3, \"d\": 4, \"e\": 5, \"f\": 6, \"g\": 7}')\n        == {\"a\": 1, \"b\": 2, \"c\": 3, \"d\": 4, \"e\": 5, \"f\": 6, \"g\": 7}\n    );;\n}"}