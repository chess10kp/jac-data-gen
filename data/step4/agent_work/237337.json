{"id": 237337, "entrypoint": "_parse_connection", "coverage": 100, "stage": "floor_pass", "python": "def _parse_connection(connection):\n    \"\"\"\n    Parse a string of the form \"{id1} {id2} {ts}\" for\n    example: \"1 2 12345678\"\n    \"\"\"\n    return tuple(int(field) for field in connection.split(' '))", "floor_fn": "\"\"\"\n    Parse a string of the form \"{id1} {id2} {ts}\" for\n    example: \"1 2 12345678\"\n    \"\"\"\ndef _parse_connection(connection: Any) -> object {\n    return `tuple(int(field) for field in connection.split(' '));\n}", "test_blocks": "test \"t0\" {\n    assert (_parse_connection(\"0 1 1\") == (0, 1, 1));;\n}\n\ntest \"t1\" {\n    assert (_parse_connection(\"1 2 12345678\") == (1, 2, 12345678));;\n}\n\ntest \"t2\" {\n    assert (_parse_connection(\"1 2 0\") == (1, 2, 0));;\n}\n\ntest \"t3\" {\n    assert (\n        _parse_connection(\"1 2 1234567890123456789\") == (1, 2, 1234567890123456789)\n    );;\n}\n\ntest \"t4\" {\n    assert (_parse_connection(\"1 2 012345678\") == (1, 2, 12345678));;\n}\n\ntest \"t5\" {\n    assert (_parse_connection(\"1234 5678 90123456\") == (1234, 5678, 90123456));;\n}\n\ntest \"t6\" {\n    assert (\n        _parse_connection(\"1 2 1234567890123456789012345678901234567890\")\n        == (1, 2, 1234567890123456789012345678901234567890)\n    );;\n}\n\ntest \"t7\" {\n    assert (_parse_connection(\"12 34 56789012\") == (12, 34, 56789012));;\n}\n\ntest \"t8\" {\n    assert (_parse_connection(\"0 0 1\") == (0, 0, 1));;\n}\n\ntest \"t9\" {\n    assert (_parse_connection('1 2 3') == (1, 2, 3));;\n}\n\ntest \"t10\" {\n    assert (_parse_connection(\"0 0 0\") == (0, 0, 0));;\n}\n\ntest \"t11\" {\n    assert (_parse_connection(\"1 2 12345678\") == (1, 2, 12345678));;\n}\n\ntest \"t12\" {\n    assert (_parse_connection(\"1 2 1234567890\") == (1, 2, 1234567890));;\n}\n\ntest \"t13\" {\n    assert (_parse_connection(\"123 456 78901234\") == (123, 456, 78901234));;\n}\n\ntest \"t14\" {\n    assert (_parse_connection(\"1 2 12345678\") == (1, 2, 12345678));;\n}\n\ntest \"t15\" {\n    assert (_parse_connection(\"1 0 1\") == (1, 0, 1));;\n}\n\ntest \"t16\" {\n    assert (_parse_connection('1 2 12345678') == (1, 2, 12345678));;\n}\n\ntest \"t17\" {\n    assert (_parse_connection('4 5 87654321') == (4, 5, 87654321));;\n}\n\ntest \"t18\" {\n    assert (_parse_connection(\"1 2 1000000000\") == (1, 2, 1000000000));;\n}\n\ntest \"t19\" {\n    assert (_parse_connection(\"1 2 123456789\") == (1, 2, 123456789));;\n}\n\ntest \"t20\" {\n    assert (_parse_connection(\"1 2 12345678901\") == (1, 2, 12345678901));;\n}\n\ntest \"t21\" {\n    assert (_parse_connection(\"1 2 12345678\") == (1, 2, 12345678));;\n}\n\ntest \"t22\" {\n    assert (\n        _parse_connection(\"1 2 12345678901234567890\") == (1, 2, 12345678901234567890)\n    );;\n}\n\ntest \"t23\" {\n    assert (_parse_connection(\"1 2 123456780\") == (1, 2, 123456780));;\n}\n\ntest \"t24\" {\n    assert (_parse_connection(\"0 1 0\") == (0, 1, 0));;\n}\n\ntest \"t25\" {\n    assert (\n        _parse_connection(\"1000000000000000 2000000000000000 12345678\")\n        == (1000000000000000, 2000000000000000, 12345678)\n    );;\n}\n\ntest \"t26\" {\n    assert (_parse_connection(\"1 2 3\") == (1, 2, 3));;\n}\n\ntest \"t27\" {\n    assert (_parse_connection('1 2 12345678') == (1, 2, 12345678));;\n}\n\ntest \"t28\" {\n    assert (_parse_connection(\"1 0 0\") == (1, 0, 0));;\n}\n\ntest \"t29\" {\n    assert (_parse_connection(\"1 2 0123456780\") == (1, 2, 123456780));;\n}"}