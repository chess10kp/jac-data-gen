{"id": 283128, "entrypoint": "get_fx", "coverage": 100, "stage": "floor_pass", "python": "def get_fx(x, linear):\n\t\"\"\" Return the y value of function x \"\"\"\n\ta,b,offset = linear\n\ty = ((a * x) + b)//offset\n\treturn y", "floor_fn": "\"\"\" Return the y value of function x \"\"\"\ndef get_fx(x: Any, linear: Any) -> object {\n    (a, b, offset) = linear;\n    y = ((a * x) + b) // offset;\n    return y;\n}", "test_blocks": "test \"t0\" {\n    assert (get_fx(1, [1, 0, 1]) == 1);;\n}\n\ntest \"t1\" {\n    assert (get_fx(100, (1, 0, 1)) == 100);;\n}\n\ntest \"t2\" {\n    assert (get_fx(1, (2, 3, 4)) == 1);;\n}\n\ntest \"t3\" {\n    assert (get_fx(10, (1, 0, 1)) == 10);;\n}\n\ntest \"t4\" {\n    assert (get_fx(1, (1, 1, 2)) == 1);;\n}\n\ntest \"t5\" {\n    assert (get_fx(0, [10, 1, 3]) == 0);;\n}\n\ntest \"t6\" {\n    assert (get_fx(1, (0, 0, 1)) == 0);;\n}\n\ntest \"t7\" {\n    assert (get_fx(1, (2, 1, 2)) == 1);;\n}\n\ntest \"t8\" {\n    assert (get_fx(10, (1, 10, 10)) == 2);;\n}\n\ntest \"t9\" {\n    assert (get_fx(0, (1, 2, 5)) == 0);;\n}\n\ntest \"t10\" {\n    assert (get_fx(2, (2, 3, 4)) == 1);;\n}\n\ntest \"t11\" {\n    assert (get_fx(2.0, (0.5, 0, 1)) == 1);;\n}\n\ntest \"t12\" {\n    assert (get_fx(3, (1, 1, 3)) == 1);;\n}\n\ntest \"t13\" {\n    assert (get_fx(0, (0, 0, 7)) == 0);;\n}\n\ntest \"t14\" {\n    assert (get_fx(5, (2, 0, 4)) == 2);;\n}\n\ntest \"t15\" {\n    assert (get_fx(0, (1, 0, 100)) == 0);;\n}\n\ntest \"t16\" {\n    assert (get_fx(0, (0, 0, 4)) == 0);;\n}\n\ntest \"t17\" {\n    assert (get_fx(4, (1, 2, 12)) == 0);;\n}\n\ntest \"t18\" {\n    assert (get_fx(0, (0, 0, 2)) == 0);;\n}\n\ntest \"t19\" {\n    assert (get_fx(100, (2, 1, 2)) == 100);;\n}\n\ntest \"t20\" {\n    assert (get_fx(0, (0, 0, 1)) == 0);;\n}\n\ntest \"t21\" {\n    assert (get_fx(1, (2, 1, 2)) == 1);;\n}\n\ntest \"t22\" {\n    assert (get_fx(3, (1, 0, 2)) == 1);;\n}\n\ntest \"t23\" {\n    assert (get_fx(1000, (1, 0, 1)) == 1000);;\n}\n\ntest \"t24\" {\n    assert (get_fx(-1, (1, 1, 4)) == 0);;\n}\n\ntest \"t25\" {\n    assert (get_fx(2, (2, 1, 2)) == 2);;\n}\n\ntest \"t26\" {\n    assert (get_fx(-1, (1, 1, 3)) == 0);;\n}\n\ntest \"t27\" {\n    assert (get_fx(1, (2, 3, 4)) == 1);;\n}\n\ntest \"t28\" {\n    assert (get_fx(2, (2, 3, 2)) == 3);;\n}\n\ntest \"t29\" {\n    assert (get_fx(0, (1, 1, 2)) == 0);;\n}\n\ntest \"t30\" {\n    assert (get_fx(6, (1, 2, 1)) == 8);;\n}\n\ntest \"t31\" {\n    assert (get_fx(0, (0, 0, 123456)) == 0);;\n}\n\ntest \"t32\" {\n    assert (get_fx(1, (2, 4, 3)) == 2);;\n}\n\ntest \"t33\" {\n    assert (get_fx(10, (1, 2, 1)) == 12);;\n}\n\ntest \"t34\" {\n    assert (get_fx(10, (1, 1, 2)) == 5);;\n}\n\ntest \"t35\" {\n    assert (get_fx(5, (0, 3, 5)) == 0);;\n}\n\ntest \"t36\" {\n    assert (get_fx(100000, [1, 1, 1]) == 100001);;\n}\n\ntest \"t37\" {\n    assert (get_fx(0, (10, 1, 100)) == 0);;\n}\n\ntest \"t38\" {\n    assert (get_fx(0, (2, 0, 1)) == 0);;\n}\n\ntest \"t39\" {\n    assert (get_fx(0, (1, 2, 1)) == 2);;\n}\n\ntest \"t40\" {\n    assert (get_fx(2, (1, 2, 6)) == 0);;\n}\n\ntest \"t41\" {\n    assert (get_fx(3, [3, 0, 3]) == 3);;\n}\n\ntest \"t42\" {\n    assert (get_fx(2, (2, 1, 3)) == 1);;\n}\n\ntest \"t43\" {\n    assert (get_fx(3, (2, 3, 2)) == 4);;\n}\n\ntest \"t44\" {\n    assert (get_fx(5, (1, 6, 7)) == 1);;\n}\n\ntest \"t45\" {\n    assert (get_fx(0, (1, 1, 10)) == 0);;\n}\n\ntest \"t46\" {\n    assert (get_fx(1, (1, 1, 2)) == 1);;\n}\n\ntest \"t47\" {\n    assert (get_fx(-100, (2, 1, 2)) == -100);;\n}\n\ntest \"t48\" {\n    assert (get_fx(1.0, (0.5, 0, 1)) == 0);;\n}\n\ntest \"t49\" {\n    assert (get_fx(2, (1, 1, 2)) == 1);;\n}\n\ntest \"t50\" {\n    assert (get_fx(1, [1, 2, 3]) == 1);;\n}\n\ntest \"t51\" {\n    assert (get_fx(1, (2, 3, 2)) == 2);;\n}\n\ntest \"t52\" {\n    assert (get_fx(0, (0, 1, 2)) == 0);;\n}\n\ntest \"t53\" {\n    assert (get_fx(0, (0, 1, 4)) == 0);;\n}\n\ntest \"t54\" {\n    assert (get_fx(6, (2, 3, 4)) == 3);;\n}\n\ntest \"t55\" {\n    assert (get_fx(2, (0, 1, 2)) == 0);;\n}\n\ntest \"t56\" {\n    assert (get_fx(4, (1, 2, 6)) == 1);;\n}\n\ntest \"t57\" {\n    assert (get_fx(0, (1, 0, 1)) == 0);;\n}\n\ntest \"t58\" {\n    assert (get_fx(1, (1, 1, 4)) == 0);;\n}\n\ntest \"t59\" {\n    assert (get_fx(0, (0, 0, 100000)) == 0);;\n}\n\ntest \"t60\" {\n    assert (get_fx(2, [2, 0, 2]) == 2);;\n}\n\ntest \"t61\" {\n    assert (get_fx(0, (1, 0, 3)) == 0);;\n}\n\ntest \"t62\" {\n    assert (get_fx(0, (1, 0, 4)) == 0);;\n}\n\ntest \"t63\" {\n    assert (get_fx(3, (2, 1, 4)) == 1);;\n}\n\ntest \"t64\" {\n    assert (get_fx(0, (2, 0, 2)) == 0);;\n}"}