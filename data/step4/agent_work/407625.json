{"id": 407625, "entrypoint": "is_box_inside", "coverage": 100, "stage": "floor_pass", "python": "def is_box_inside(in_box, out_box):\n    \"\"\"\n    check if in_box is inside out_box (both are 4 dim box coordinates in [x1, y1, x2, y2] format)\n    \"\"\"\n    xmin_o, ymin_o, xmax_o, ymax_o = out_box\n    xmin_i, ymin_i, xmax_i, ymax_i = in_box\n    \n    if (xmin_o > xmin_i) or (xmax_o < xmax_i) or (ymin_o > ymin_i) or (ymax_o < ymax_i):\n        return False\n    return True", "floor_fn": "\"\"\"\n    check if in_box is inside out_box (both are 4 dim box coordinates in [x1, y1, x2, y2] format)\n    \"\"\"\ndef is_box_inside(in_box: Any, out_box: Any) -> object {\n    (xmin_o, ymin_o, xmax_o, ymax_o) = out_box;\n    (xmin_i, ymin_i, xmax_i, ymax_i) = in_box;\n    if (\n        (xmin_o > xmin_i) or (xmax_o < xmax_i) or (ymin_o > ymin_i) or (ymax_o < ymax_i)\n    ) {\n        return False;\n    }\n    return True;\n}", "test_blocks": "test \"t0\" {\n    assert (is_box_inside([20, 20, 30, 30], [5, 5, 40, 40]) == True);;\n}\n\ntest \"t1\" {\n    assert (is_box_inside((25, 25, 50, 50), (0, 0, 100, 100)) == True);;\n}\n\ntest \"t2\" {\n    assert (is_box_inside([10, 10, 20, 20], [10, 10, 100, 100]) == True);;\n}\n\ntest \"t3\" {\n    assert (is_box_inside((1, 2, 3, 4), (2, 3, 3, 4)) == False);;\n}\n\ntest \"t4\" {\n    assert (is_box_inside((1.0, 1.99, 3.0, 4.01), (1.0, 2.0, 3.0, 4.0)) == False);;\n}\n\ntest \"t5\" {\n    assert (is_box_inside([1, 1, 3, 3], [0, 4, 2, 6]) == False);;\n}\n\ntest \"t6\" {\n    assert (is_box_inside((1, 2, 3, 4), (0, 1, 2, 4)) == False);;\n}\n\ntest \"t7\" {\n    assert (is_box_inside([10, 10, 15, 15], [5, 5, 40, 40]) == True);;\n}\n\ntest \"t8\" {\n    assert (is_box_inside([0, 0, 5, 5], [1, 1, 6, 6]) == False);;\n}\n\ntest \"t9\" {\n    assert (is_box_inside([10, 10, 100, 100], [10, 10, 100, 100]) == True);;\n}\n\ntest \"t10\" {\n    assert (is_box_inside([1, 1, 5, 5], [5, 5, 7, 7]) == False);;\n}\n\ntest \"t11\" {\n    assert (is_box_inside([5, 5, 15, 15], [0, 0, 10, 10]) == False);;\n}\n\ntest \"t12\" {\n    assert (is_box_inside([1, 2, 4, 8], [2, 2, 2, 2]) == False);;\n}\n\ntest \"t13\" {\n    assert (is_box_inside((1, 2, 3, 4), (0, 0, 4, 4)) == True);;\n}\n\ntest \"t14\" {\n    assert (is_box_inside([1, 1, 3, 3], [1, 1, 3, 3]) == True);;\n}\n\ntest \"t15\" {\n    assert (is_box_inside([0, 0, 1, 1], [-1, -1, 0, 0]) == False);;\n}\n\ntest \"t16\" {\n    assert (is_box_inside([10, 10, 15, 15], [10, 10, 15, 15]) == True);;\n}\n\ntest \"t17\" {\n    assert (is_box_inside([5, 5, 15, 15], [1, 1, 10, 10]) == False);;\n}\n\ntest \"t18\" {\n    assert (is_box_inside([1, 2, 4, 8], [2, 2, 4, 8]) == False);;\n}\n\ntest \"t19\" {\n    assert (is_box_inside((1.0, 2.0, 3.0, 4.0), (1.0, 3.0, 4.0, 6.0)) == False);;\n}\n\ntest \"t20\" {\n    assert (is_box_inside([1, 2, 4, 8], [1, 2, 4, 8]) == True);;\n}\n\ntest \"t21\" {\n    assert (is_box_inside((1.2, 2.2, 4.2, 10.2), (1.5, 2.5, 4.5, 10.5)) == False);;\n}\n\ntest \"t22\" {\n    assert (is_box_inside([1, 2, 4, 8], [2, 1, 4, 4]) == False);;\n}\n\ntest \"t23\" {\n    assert (is_box_inside((15, 15, 25, 25), (10, 10, 15, 15)) == False);;\n}\n\ntest \"t24\" {\n    assert (is_box_inside([10, 10, 100, 100], [100, 100, 1000, 1000]) == False);;\n}\n\ntest \"t25\" {\n    assert (is_box_inside([1, 1, 3, 3], [4, 4, 6, 6]) == False);;\n}\n\ntest \"t26\" {\n    assert (is_box_inside([10, 10, 15, 15], [100, 100, 150, 150]) == False);;\n}\n\ntest \"t27\" {\n    assert (is_box_inside([100, 100, 200, 200], [5, 5, 40, 40]) == False);;\n}\n\ntest \"t28\" {\n    assert (is_box_inside([0, 0, 5, 5], [3, 3, 5, 5]) == False);;\n}\n\ntest \"t29\" {\n    assert (is_box_inside((1.5, 2.5, 4.5, 10.5), (1.2, 2.2, 4.2, 10.2)) == False);;\n}\n\ntest \"t30\" {\n    assert (is_box_inside((1, 2, 3, 4), (0, 3, 2, 4)) == False);;\n}\n\ntest \"t31\" {\n    assert (is_box_inside([1, 1, 5, 5], [1.5, 2.5, 4.5, 4.51]) == False);;\n}\n\ntest \"t32\" {\n    assert (is_box_inside([0, 0, 0.5, 0.5], [0, 0, 1, 1]) == True);;\n}\n\ntest \"t33\" {\n    assert (is_box_inside([1, 1, 3, 3], [0, 0, 1, 1]) == False);;\n}\n\ntest \"t34\" {\n    assert (is_box_inside([0, 0, 3, 3], [0, 0, 3, 3]) == True);;\n}\n\ntest \"t35\" {\n    assert (is_box_inside([0, 0, 1, 1], [1, 1, 2, 2]) == False);;\n}\n\ntest \"t36\" {\n    assert (is_box_inside((0, 0, 10, 10), (10, 10, 20, 20)) == False);;\n}\n\ntest \"t37\" {\n    assert (is_box_inside([100, 100, 199, 199], [100, 99, 100, 99]) == False);;\n}\n\ntest \"t38\" {\n    assert (is_box_inside((0, 0, 100, 100), (25, 25, 50, 50)) == False);;\n}\n\ntest \"t39\" {\n    assert (is_box_inside((-10, 10, 30, 30), (5, 5, 100, 100)) == False);;\n}\n\ntest \"t40\" {\n    assert (is_box_inside([0, 0, 5, 5], [-1, -1, 1, 100]) == False);;\n}\n\ntest \"t41\" {\n    assert (is_box_inside((1.0, 4.0, 2.0, 5.0), (1.2, 2.5, 3.1, 5.2)) == False);;\n}\n\ntest \"t42\" {\n    assert (is_box_inside((1.0, 2.0, 3.0, 4.0), (1.0, 2.0, 3.0, 4.0)) == True);;\n}\n\ntest \"t43\" {\n    assert (is_box_inside((1, 2, 3, 4), (0, 0, 1, 2)) == False);;\n}\n\ntest \"t44\" {\n    assert (is_box_inside([0, 0, 1, 1], [0, 0, 1, 1]) == True);;\n}\n\ntest \"t45\" {\n    assert (is_box_inside([100, 100, 199, 199], [99, 99, 99, 99]) == False);;\n}\n\ntest \"t46\" {\n    assert (is_box_inside([5, 5, 15, 15], [0, 0, 11, 11]) == False);;\n}\n\ntest \"t47\" {\n    assert (is_box_inside((1, 2, 3, 4), (-1, -1, 5, 5)) == True);;\n}\n\ntest \"t48\" {\n    assert (is_box_inside([1000, 1000, 1100, 1100], [10, 10, 100, 100]) == False);;\n}\n\ntest \"t49\" {\n    assert (is_box_inside((1, 2, 3, 4), (0, 0, 5, 5)) == True);;\n}\n\ntest \"t50\" {\n    assert (is_box_inside([10, 10, 100, 100], [10, 10, 100, 1000]) == True);;\n}\n\ntest \"t51\" {\n    assert (is_box_inside([100, 100, 199, 199], [99, 100, 99, 100]) == False);;\n}\n\ntest \"t52\" {\n    assert (is_box_inside((10, 10, 20, 20), (10, 10, 20, 20)) == True);;\n}\n\ntest \"t53\" {\n    assert (is_box_inside([1, 1, 2, 2], [1, 1, 4, 4]) == True);;\n}\n\ntest \"t54\" {\n    assert (is_box_inside((1, 2, 3, 4), (0, 3, 3, 5)) == False);;\n}\n\ntest \"t55\" {\n    assert (is_box_inside((1.2, 2.2, 4.2, 10.2), (2.0, 2.5, 5.0, 10.0)) == False);;\n}\n\ntest \"t56\" {\n    assert (is_box_inside([100, 100, 1000, 1000], [10, 10, 100, 100]) == False);;\n}\n\ntest \"t57\" {\n    assert (is_box_inside([100, 100, 199, 199], [100, 99, 100, 98]) == False);;\n}\n\ntest \"t58\" {\n    assert (is_box_inside([5, 5, 15, 15], [0, 0, 11, 10]) == False);;\n}\n\ntest \"t59\" {\n    assert (is_box_inside((5, 5, 15, 15), (0, 0, 10, 10)) == False);;\n}\n\ntest \"t60\" {\n    assert (is_box_inside([1, 2, 4, 8], [1, 1, 1, 1]) == False);;\n}\n\ntest \"t61\" {\n    assert (is_box_inside([100, 100, 199, 199], [100, 100, 199, 199]) == True);;\n}\n\ntest \"t62\" {\n    assert (is_box_inside([1, 1, 2, 2], [1, 1, 2, 2]) == True);;\n}"}