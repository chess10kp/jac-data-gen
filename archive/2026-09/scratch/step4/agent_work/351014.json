rgb(-100, 256, 256) == (0, 254, 254));;\n}\n\ntest \"t71\" {\n    assert (cliprgb(0, 255, 0) == (0, 254, 0));;\n}\n\ntest \"t72\" {\n    assert (cliprgb(0, 0, 256) == (0, 0, 254));;\n}\n\ntest \"t73\" {\n    assert (cliprgb(204, 153, 102) == (204, 153, 102));;\n}\n\ntest \"t74\" {\n    assert (cliprgb(0, 0, 253) == (0, 0, 253));;\n}\n\ntest \"t75\" {\n    assert (cliprgb(10, 20, 30) == (10, 20, 30));;\n}\n\ntest \"t76\" {\n    assert (cliprgb(100, 120, 120) == (100, 120, 120));;\n}\n\ntest \"t77\" {\n    assert (cliprgb(254, 255, 255) == (254, 254, 254));;\n}\n\ntest \"t78\" {\n    assert (cliprgb(-1, 0, 0) == (0, 0, 0));;\n}\n\ntest \"t79\" {\n    assert (cliprgb(255, 254, 254) == (254, 254, 254));;\n}\n\ntest \"t80\" {\n    assert (cliprgb(-100, -100, -100) == (0, 0, 0));;\n}\n\ntest \"t81\" {\n    assert (cliprgb(1, 1, 1) == (1, 1, 1));;\n}\n\ntest \"t82\" {\n    assert (cliprgb(1, 0, 1) == (1, 0, 1));;\n}\n\ntest \"t83\" {\n    assert (cliprgb(10, 20, 30) == cliprgb(10, 20, 30));;\n}\n\ntest \"t84\" {\n    assert (cliprgb(0, 2, 1) == (0, 2, 1));;\n}\n\ntest \"t85\" {\n    assert (cliprgb(0, -1, 0) == (0, 0, 0));;\n}\n\ntest \"t86\" {\n    assert (cliprgb(0, 1, 253) == (0, 1, 253));;\n}\n\ntest \"t87\" {\n    assert (cliprgb(0, 0, 1) == (0, 0, 1));;\n}\n\ntest \"t88\" {\n    assert (cliprgb(255, 0, 0) == (254, 0, 0));;\n}\n\ntest \"t89\" {\n    assert (cliprgb(255, 254, 255) == (254, 254, 254));;\n}\n\ntest \"t90\" {\n    assert (cliprgb(1, 2, 300) == (1, 2, 254));;\n}\n\ntest \"t91\" {\n    assert (cliprgb(252, 252, 252) == (252, 252, 252));;\n}\n\ntest \"t92\" {\n    assert (cliprgb(255, 255, 255) == (254, 254, 254));;\n}"}