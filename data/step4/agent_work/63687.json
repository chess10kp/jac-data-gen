{"id": 63687, "entrypoint": "pi", "coverage": 100, "stage": "floor_pass", "python": "def pi(p, q):\n    \"\"\" Calculates premium policy for insurance company\n    Args:\n    q (float): Coverage amount \n    p (float): Probability of loss\n    Returns:\n    (float): Premium policy of bundle\n    \"\"\"\n    return (p*q)", "floor_fn": "\"\"\" Calculates premium policy for insurance company\n    Args:\n    q (float): Coverage amount\n    p (float): Probability of loss\n    Returns:\n    (float): Premium policy of bundle\n    \"\"\"\ndef pi(p: Any, q: Any) -> object {\n    return (p * q);\n}", "test_blocks": "test \"t0\" {\n    assert (pi(0.001, 0.5) == 0.0005);;\n}\n\ntest \"t1\" {\n    assert (pi(0.1, 0.25) == 0.025);;\n}\n\ntest \"t2\" {\n    assert (pi(2, 2) == 4);;\n}\n\ntest \"t3\" {\n    assert (pi(0.01, 100) == 1);;\n}\n\ntest \"t4\" {\n    assert (pi(0.1, 1) == 0.1) , 'pi(0.1, 1) should be 0.1';;\n}\n\ntest \"t5\" {\n    assert (pi(0, 0) == 0);;\n}\n\ntest \"t6\" {\n    assert (pi(1, 0.5) == 0.5);;\n}\n\ntest \"t7\" {\n    assert (pi(0.25, 0.25) == 0.0625);;\n}\n\ntest \"t8\" {\n    assert (pi(0.5, 100) == 50);;\n}\n\ntest \"t9\" {\n    assert (pi(0.5, 75) == 37.5);;\n}\n\ntest \"t10\" {\n    assert (pi(0.5, 50) == 25) , 'pi(0.5, 50) should be 25';;\n}\n\ntest \"t11\" {\n    assert (pi(0.1, 0) == 0) , 'pi(0.1, 0) should be 0';;\n}\n\ntest \"t12\" {\n    assert (pi(0.5, 1.0) == 0.5);;\n}\n\ntest \"t13\" {\n    assert (pi(0.1, 100) == 10);;\n}\n\ntest \"t14\" {\n    assert (pi(0.05, 100) == 5);;\n}\n\ntest \"t15\" {\n    assert (pi(0.5, 100) == 50) , 'pi(0.5, 100) should be 50';;\n}\n\ntest \"t16\" {\n    assert (pi(1000, 0.9) == 900);;\n}\n\ntest \"t17\" {\n    assert (pi(1, 7) == 7);;\n}\n\ntest \"t18\" {\n    assert (pi(3, 2) == 6);;\n}\n\ntest \"t19\" {\n    assert (pi(1000, 1) == 1000);;\n}\n\ntest \"t20\" {\n    assert (pi(1.5, 1) == 1.5);;\n}\n\ntest \"t21\" {\n    assert (pi(1, 2) == 2);;\n}\n\ntest \"t22\" {\n    assert (pi(1, 6) == 6);;\n}\n\ntest \"t2