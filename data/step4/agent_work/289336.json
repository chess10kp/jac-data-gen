{"id": 289336, "entrypoint": "map_range", "coverage": 100, "stage": "floor_pass", "python": "def map_range(x, in_min, in_max, out_min, out_max):\n    \"\"\"\n    Maps a number from one range to another.\n    :return: Returns value mapped to new range\n    :rtype: float\n    \"\"\"\n    mapped = (x - in_min) * (out_max - out_min) / (in_max - in_min) + out_min\n    if out_min <= out_max:\n        return max(min(mapped, out_max), out_min)\n\n    return min(max(mapped, out_max), out_min)", "floor_fn": "\"\"\"\n    Maps a number from one range to another.\n    :return: Returns value mapped to new range\n    :rtype: float\n    \"\"\"\ndef map_range(x: Any, in_min: Any, in_max: Any, out_min: Any, out_max: Any) -> object {\n    mapped = (((x - in_min) * (out_max - out_min)) / (in_max - in_min)) + out_min;\n    if (out_min <= out_max) {\n        return max(min(mapped, out_max), out_min);\n    }\n    return min(max(mapped, out_max), out_min);\n}", "test_blocks": "test \"t0\" {\n    assert (map_range(0, 0, 100, 0, 100) == 0);;\n}\n\ntest \"t1\" {\n    assert (map_range(1, 0, 1, 0, 2) == 2.0);;\n}\n\ntest \"t2\" {\n    assert (map_range(0.5, 0, 1, 2, 3) == 2.5);;\n}\n\ntest \"t3\" {\n    assert (map_range(15, 0, 10, 0, -10) == -10);;\n}\n\ntest \"t4\" {\n    assert (map_range(0, 10, 20, 0, 100) == 0);;\n}\n\ntest \"t5\" {\n    assert (map_range(0, 0, 1, 0, 2) == 0.0);;\n}\n\ntest \"t6\" {\n    assert (map_range(3, 0, 10, 0, 100) == 30.0);;\n}\n\ntest \"t7\" {\n    assert (map_range(1, 0, 10, 0, 10) == 1);;\n}\n\ntest \"t8\" {\n    assert (map_range(100, 0, 100, 50, -50) == -50);;\n}\n\ntest \"t9\" {\n    assert (map_range(0, 0, 100, 100, 200) == 100);;\n}\n\ntest \"t10\" {\n    assert (map_range(-10, -10, 0, 0, 1) == 0.0);;\n}\n\ntest \"t11\" {\n    assert (map_range(50, 0, 100, 0, 1) == 0.5);;\n}\n\ntest \"t12\" {\n    assert (map_range(0, 100, 0, 0, 100) == 100);;\n}\n\ntest \"t13\" {\n    assert (map_range(1, 0, 1, 0, 1) == 1);;\n}\n\ntest \"t14\" {\n    assert (map_range(0,