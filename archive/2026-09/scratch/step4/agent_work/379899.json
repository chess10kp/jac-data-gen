{"id": 379899, "entrypoint": "__stretch__", "coverage": 100, "stage": "floor_pass", "python": "def __stretch__(p,s1,f1):\n    \"\"\" If a point has coordinate p  when the steep/flat points are at s0/f0,\n        this returns its coordinates when the steep/flat points are at s1/f1.\n        This is necessary to preserve the colourmap features.\n    \"\"\"\n    s0 = 0.3125\n    f0 = 0.75\n    dsf = f0 - s0\n\n    if p <= s0:\n        return p*s1/s0\n    elif p <= f0:\n        return ( (p-s0)*f1 + (f0-p)*s1 )/dsf\n    else:\n        return ( (p-f0) + (1.-p)*f1 )/(1-f0)", "floor_fn": "\"\"\" If a point has coordinate p  when the steep/flat points are at s0/f0,\n        this returns its coordinates when the steep/flat points are at s1/f1.\n        This is necessary to preserve the colourmap features.\n    \"\"\"\ndef __stretch__(p: Any, s1: Any, f1: Any) -> object {\n    s0 = 0.3125;\n    f0 = 0.75;\n    dsf = f0 - s0;\n    if (p <= s0) {\n        return ((p * s1) / s0);\n    } elif (p <= f0) {\n        return ((((p - s0) * f1) + ((f0 - p) * s1)) / dsf);\n    } else {\n        return (((p - f0) + ((1.0 - p) * f1)) / (1 - f0));\n    }\n}", "test_blocks": "test \"t0\" {\n    assert (__stretch__(0.75, 1, 0.5) == 0.5);;\n}\n\ntest \"t1\" {\n    assert (__stretch__(0, 0.125, 0.875) == 0.0);;\n}\n\ntest \"t2\" {\n    assert (__stretch__(0.0, 2, 1) == 0.0);;\n}\n\ntest \"t3\" {\n    assert (__stretch__(1.0, 1.0, 0.0) == 1.0);;\n}\n\ntest \"t4\" {\n    assert (__stretch__(1.0, 0.3125, 0.75) == 1.0);;\n}\n\ntest \"t5\" {\n    assert (__stretch__(0.999, 0.3125, 0.75) == 0.999);;\n}\n\ntest \"t6\" {\n    assert (__stretch__(0.0, 1.0, 0.0) == 0.0);;\n}\n\ntest \"t7\" {\n    assert (__stretch__(1, 2, 2) == 1);;\n}\n\ntest \"t8\" {\n    assert (__stretch__(1, 3, 3) == 1);;\n}\n\ntest \"t9\" {\n    assert (__stretch__(0.5, 0.0, 0.0) == 0.0);;\n}\n\ntest \"t10\" {\n    assert (__stretch__(0.75, 0.001, 0.001) == 0.001);;\n}\n\ntest \"t11\" {\n    assert (__stretch__(0.75, 1, 0.75) == 0.75);;\n}\n\ntest \"t12\" {\n    assert (__stretch__(1, 0, 1) == 1);;\n}\n\ntest \"t13\" {\n    assert (__stretch__(0.75, 0.75, 0.3125) == 0.3125);;\n}\n\ntest \"t14\" {\n    assert (__stretch__(0, 0, 1) == 0);;\n}\n\ntest \"t15\" {\n    assert (__stretch__(0.0, 0.5, 1.0) == 0.0);;\n}\n\ntest \"t16\" {\n    assert (__stretch__(0, 2, 0.5) == 0);;\n}\n\ntest \"t17\" {\n    assert (__stretch__(0, 0.25, 0.75) == 0.0);;\n}\n\ntest \"t18\" {\n    assert (__stretch__(0.6874, 0.3125, 0.75) == 0.6874);;\n}\n\ntest \"t19\" {\n    assert (__stretch__(0.5, 1.5, 1.5) == 1.5);;\n}\n\ntest \"t20\" {\n    assert (__stretch__(0, 2, 1) == 0);;\n}\n\ntest \"t21\" {\n    assert (__stretch__(1, 1, 0.75) == 1);;\n}\n\ntest \"t22\" {\n    assert (__stretch__(1.0, 1.0, 1.0) == 1.0);;\n}\n\ntest \"t23\" {\n    assert (__stretch__(0.0, 0.0, 0.0) == 0.0);;\n}\n\ntest \"t24\" {\n    assert (__stretch__(0.062, 0.3125, 0.75) == 0.062);;\n}\n\ntest \"t25\" {\n    assert (__stretch__(0.3125, 0.3125, 0.3125) == 0.3125);;\n}\n\ntest \"t26\" {\n    assert (__stretch__(1, 2, 0.5) == 1);;\n}\n\ntest \"t27\" {\n    assert (__stretch__(1.0, 0.0, 1.0) == 1.0);;\n}\n\ntest \"t28\" {\n    assert (__stretch__(0.0, 1.0, 1.0) == 0.0);;\n}\n\ntest \"t29\" {\n    assert (__stretch__(0.3125, 0.3125, 0.75) == 0.3125);;\n}\n\ntest \"t30\" {\n    assert (__stretch__(1.0, 1.0, 1.0) == 1.0);;\n}\n\ntest \"t31\" {\n    assert (\n        __stretch__(12345, 0.3125, 0.75)\n        == (((12345 - 0.75) + ((1 - 12345) * 0.75)) / 0.25)\n    );;\n}\n\ntest \"t32\" {\n    assert (__stretch__(1, 0, 0) == 1);;\n}\n\ntest \"t33\" {\n    assert (__stretch__(0, 1, 1) == 0);;\n}\n\ntest \"t34\" {\n    assert (__stretch__(1.0, 0.0, 1.0) == 1.0);;\n}\n\ntest \"t35\" {\n    assert (__stretch__(0.0, 0.3125, 0.75) == 0.0);;\n}\n\ntest \"t36\" {\n    assert (__stretch__(1, 2, 1) == 1);;\n}\n\ntest \"t37\" {\n    assert (__stretch__(0.75, 0.0, 0.0) == 0.0);;\n}\n\ntest \"t38\" {\n    assert (__stretch__(1.0, 1.0, 0.0) == 1.0);;\n}\n\ntest \"t39\" {\n    assert (__stretch__(1, 2, 3) == 1);;\n}\n\ntest \"t40\" {\n    assert (__stretch__(0.8749, 0.3125, 0.75) == 0.8749);;\n}\n\ntest \"t41\" {\n    assert (__stretch__(0.75, 1.0, 0.0) == 0.0);;\n}\n\ntest \"t42\" {\n    assert (__stretch__(1.0, 0.5, 0.0) == 1.0);;\n}\n\ntest \"t43\" {\n    assert (__stretch__(0, 3, 4) == 0);;\n}\n\ntest \"t44\" {\n    assert (__stretch__(0.0, 0.75, 0.3125) == 0.0);;\n}\n\ntest \"t45\" {\n    assert (__stretch__(1.0, 0.5, 1.0) == 1.0);;\n}\n\ntest \"t46\" {\n    assert (__stretch__(1, 1, 0.25) == 1);;\n}\n\ntest \"t47\" {\n    assert (__stretch__(0.0, 1, 1) == 0.0);;\n}\n\ntest \"t48\" {\n    assert (__stretch__(0.5, 0.3125, 0.75) == 0.5);;\n}\n\ntest \"t49\" {\n    assert (__stretch__(0, 0, 0) == 0);;\n}\n\ntest \"t50\" {\n    assert (__stretch__(0.75, 0.3125, 0.75) == 0.75);;\n}\n\ntest \"t51\" {\n    assert (__stretch__(0.125, 0.3125, 1.0) == 0.125);;\n}\n\ntest \"t52\" {\n    assert (__stretch__(1.0, 2, 1) == 1.0);;\n}\n\ntest \"t53\" {\n    assert (__stretch__(0.0, 0.0, 1.0) == 0.0);;\n}\n\ntest \"t54\" {\n    assert (__stretch__(0.0, 0.3125, 0.75) == 0.0);;\n}\n\ntest \"t55\" {\n    assert (__stretch__(0, 1, 1) == 0);;\n}\n\ntest \"t56\" {\n    assert (__stretch__(0.0, 0.0, 1.0) == 0.0);;\n}\n\ntest \"t57\" {\n    assert (__stretch__(0.3125, 0.3125, 0.75) == 0.3125);;\n}\n\ntest \"t58\" {\n    assert (__stretch__(0.5, 0.0, 0.0) == 0.0);;\n}\n\ntest \"t59\" {\n    assert (__stretch__(0.501, 0.3125, 0.75) == 0.501);;\n}\n\ntest \"t60\" {\n    assert (__stretch__(0.0, 0.3125, 0.75) == 0.0);;\n}\n\ntest \"t61\" {\n    assert (__stretch__(1, 1, 0.5) == 1);;\n}\n\ntest \"t62\" {\n    assert (__stretch__(0.001, 0.3125, 0.75) == 0.001);;\n}\n\ntest \"t63\" {\n    assert (__stretch__(0, 1, 2) == 0);;\n}\n\ntest \"t64\" {\n    assert (__stretch__(0.0, 0.0, 0.5) == 0.0);;\n}\n\ntest \"t65\" {\n    assert (__stretch__(0.25, 0.0, 0.0) == 0.0);;\n}\n\ntest \"t66\" {\n    assert (__stretch__(0.75, 0.3125, 0.75) == 0.75);;\n}\n\ntest \"t67\" {\n    assert (__stretch__(0.0, 0.0, 0.0) == 0.0);;\n}\n\ntest \"t68\" {\n    assert (__stretch__(0.75, 0.25, 0.75) == 0.75);;\n}\n\ntest \"t69\" {\n    assert (__stretch__(1, 1, 2) == 1);;\n}\n\ntest \"t70\" {\n    assert (__stretch__(1.0, 1, 1) == 1.0);;\n}\n\ntest \"t71\" {\n    assert (__stretch__(1, 3, 4) == 1);;\n}\n\ntest \"t72\" {\n    assert (__stretch__(1.0, 0.3125, 0.75) == 1.0);;\n}\n\ntest \"t73\" {\n    assert (__stretch__(1.0, 0.25, 0.75) == 1.0);;\n}\n\ntest \"t74\" {\n    assert (__stretch__(1, 1, 0) == 1);;\n}\n\ntest \"t75\" {\n    assert (__stretch__(0, 2, 2) == 0);;\n}\n\ntest \"t76\" {\n    assert (__stretch__(0, 3, 3) == 0);;\n}\n\ntest \"t77\" {\n    assert (__stretch__(0.75, 0.0, 1.0) == 1.0);;\n}\n\ntest \"t78\" {\n    assert (__stretch__(0.875, 0.5, 1.0) == 1.0);;\n}\n\ntest \"t79\" {\n    assert (__stretch__(0.3125, 0.3125, 0.75) == 0.3125);;\n}\n\ntest \"t80\" {\n    assert (__stretch__(1.0, 0.3125, 0.75) == 1.0);;\n}\n\ntest \"t81\" {\n    assert (__stretch__(1, 1, 1) == 1);;\n}\n\ntest \"t82\" {\n    assert (__stretch__(0, 1, 2) == 0);;\n}\n\ntest \"t83\" {\n    assert (__stretch__(0, 2, 3) == 0);;\n}\n\ntest \"t84\" {\n    assert (__stretch__(0.5, 0.5, 0.5) == 0.5);;\n}\n\ntest \"t85\" {\n    assert (__stretch__(0.3125, 0.001, 0.001) == 0.001);;\n}\n\ntest \"t86\" {\n    assert (__stretch__(1, 1, 1) == 1);;\n}"}