{"id": 329889, "entrypoint": "inheritance", "coverage": 100, "stage": "floor_pass", "python": "def inheritance(child, parent):\n    \"\"\"Aggregate into child what is missing from parent\n    \"\"\"\n    for v in child:\n        if (v in parent) and isinstance(child[v], dict) and isinstance(parent[v], dict):\n            parent[v] = inheritance(child[v], parent[v])\n        else:\n            parent[v] = child[v]\n    return parent", "floor_fn": "\"\"\"Aggregate into child what is missing from parent\n    \"\"\"\ndef inheritance(child: Any, parent: Any) -> object {\n    for v in child {\n        if (\n            (v in parent)\n            and isinstance(child[v], `dict)\n            and isinstance(parent[v], `dict)\n        ) {\n            parent[v] = inheritance(child[v], parent[v]);\n        } else {\n            parent[v] = child[v];\n        }\n    }\n    return parent;\n}", "test_blocks": "test \"t0\" {\n    assert (inheritance({'a': 1}, {'a': 2, 'b': 3}) == {'a': 1, 'b': 3});;\n}\n\ntest \"t1\" {\n    assert (inheritance({'a': 1}, {'a': 1, 'b': 2}) == {'a': 1, 'b': 2});;\n}\n\ntest \"t2\" {\n    assert (\n        inheritance(\n            {\"a\": 1, \"b\": 2, \"c\": 3, \"d\": {\"d1\": 1, \"d2\": 2}},\n            {\"a\": 1, \"b\": 2, \"c\": 3, \"d\": {\"d1\": 100, \"d3\": 300}}\n        )\n        == {\"a\": 1, \"b\": 2, \"c\": 3, \"d\": {\"d1\": 1, \"d2\": 2, \"d3\": 300}}\n    );;\n}\n\ntest \"t3\" {\n    assert (\n        inheritance(\n            {\"a\": {\"a1\": \"a1_override\"}, \"b\": \"b_override\"},\n            {\"a\": {\"a1\": \"a1_default\", \"a2\": \"a2_default\"}, \"b\": \"b_default\"}\n        )\n        == {\"a\": {\"a1\": \"a1_override\", \"a2\": \"a2_default\"}, \"b\": \"b_override\"}\n    );;\n}\n\ntest \"t4\" {\n    assert (\n        inheritance(\n            {'a': 1, 'b': {'c': 2, 'd': 3}, 'e': 4}, {'a': 10, 'b': {'c': 20, 'f': 5}}\n        )\n        == {'a': 1, 'b': {'c': 2, 'd': 3, 'f': 5}, 'e': 4}\n    );;\n}\n\ntest \"t5\" {\n    assert (\n        inheritance(\n            {'a': 'foo', 'b': 'bar', 'c': {'d': 'baz', 'e': 'qux'}},\n            {'a': 'foo', 'b': 'bar', 'c': {'d': 'baz', 'e': 'quux'}}\n        )\n        == {'a': 'foo', 'b': 'bar', 'c': {'d': 'baz', 'e': 'qux'}}\n    );;\n}\n\ntest \"t6\" {\n    assert (inheritance({'a': [1, 2]}, {'a': [1]}) == {'a': [1, 2]});;\n}\n\ntest \"t7\" {\n    assert (inheritance(`dict(), `dict()) == `dict());;\n}\n\ntest \"t8\" {\n    assert (inheritance({\"a\": \"b\"}, {\"a\": \"c\"}) == {\"a\": \"b\"});;\n}\n\ntest \"t9\" {\n    assert (\n        inheritance({'a': {'b': {'e': 7}}}, {'a': {'b': {'c': 5, 'd': 6}, 'd': 4}})\n        == {'a': {'b': {'c': 5, 'd': 6, 'e': 7}, 'd': 4}}\n    );;\n}\n\ntest \"t10\" {\n    assert (inheritance({\"a\": \"b\", \"d\": \"e\"}, {\"a\": \"c\"}) == {\"a\": \"b\", \"d\": \"e\"});;\n}\n\ntest \"t11\" {\n    assert (inheritance({}, {'a': 1, 'b': 2}) == {'a': 1, 'b': 2});;\n}\n\ntest \"t12\" {\n    assert (\n        inheritance({\"a\": 1, \"b\": 2, \"c\": 3}, {\"a\": 1, \"b\": 2})\n        == {\"a\": 1, \"b\": 2, \"c\": 3}\n    );;\n}\n\ntest \"t13\" {\n    assert (\n        inheritance({'a': {'b': {'c': 1}}}, {'a': {'b': {'d': 2}}})\n        == {'a': {'b': {'c': 1, 'd': 2}}}\n    );;\n}\n\ntest \"t14\" {\n    assert (\n        inheritance({\"a\": {\"b\": \"c\", \"d\": \"e\"}}, {\"a\": {\"e\": \"f\"}})\n        == {\"a\": {\"b\": \"c\", \"d\": \"e\", \"e\": \"f\"}}\n    );;\n}\n\ntest \"t15\" {\n    assert (\n        inheritance({\"a\": {\"b\": \"c\", \"d\": \"e\"}}, {\"a\": {\"b\": \"c\"}})\n        == {\"a\": {\"b\": \"c\", \"d\": \"e\"}}\n    );;\n}\n\ntest \"t16\" {\n    assert (\n        inheritance({\"a\": {\"b\": {\"c\": 1}}}, {\"a\": {\"b\": {\"d\": 2}}})\n        == {\"a\": {\"b\": {\"c\": 1, \"d\": 2}}}\n    );;\n}\n\ntest \"t17\" {\n    assert (\n        inheritance(\n            {\"a\": {\"a1\": {\"a11\": \"a11_override\"}}, \"b\": \"b_override\"},\n            {\"a\": {\"a1\": {\"a12\": \"a12_default\"}}, \"b\": \"b_default\"}\n        )\n        == {\n            \"a\": {\"a1\": {\"a11\": \"a11_override\", \"a12\": \"a12_default\"}},\n            \"b\": \"b_override\"\n        }\n    );;\n}\n\ntest \"t18\" {\n    assert (\n        inheritance({'a': 'A', 'b': {'c': 'C', 'd': 'D'}}, {'b': {'d': 'D', 'e': 'E'}})\n        == {'a': 'A', 'b': {'c': 'C', 'd': 'D', 'e': 'E'}}\n    );;\n}\n\ntest \"t19\" {\n    assert (\n        inheritance(\n            {'a': 'foo', 'b': 'bar', 'c': {'d': 'baz', 'e': 'qux'}},\n            {'a': 'foo', 'b': 'bar', 'c': {'d': 'baz', 'e': 'qux', 'f': 'quux'}}\n        )\n        == {'a': 'foo', 'b': 'bar', 'c': {'d': 'baz', 'e': 'qux', 'f': 'quux'}}\n    );;\n}\n\ntest \"t20\" {\n    assert (\n        inheritance({'a': 1, 'b': 2, 'c': 3}, {'a': 4, 'b': 5, 'c': 6, 'd': 7, 'e': 8})\n        == {'a': 1, 'b': 2, 'c': 3, 'd': 7, 'e': 8}\n    );;\n}\n\ntest \"t21\" {\n    assert (\n        inheritance(\n            {'a': {'b': {'c': {'d': 1}, 'e': 1}}}, {'a': {'b': {'c': {'e': 2}}}}\n        )\n        == {'a': {'b': {'c': {'d': 1, 'e': 2}, 'e': 1}}}\n    );;\n}\n\ntest \"t22\" {\n    assert (\n        inheritance(\n            {'a': 'A', 'b': {'c': 'C', 'd': 'D'}}, {'a': 'A', 'b': {'d': 'D', 'e': 'E'}}\n        )\n        == {'a': 'A', 'b': {'c': 'C', 'd': 'D', 'e': 'E'}}\n    );;\n}\n\ntest \"t23\" {\n    assert (\n        inheritance(\n            {'a': 1, 'b': 2, 'c': 3, 'd': {'x': 11, 'y': 12}},\n            {'a': 1, 'b': 20, 'c': 3, 'd': {'x': 111, 'y': 12, 'z': 13}, 'e': 50}\n        )\n        == {'a': 1, 'b': 2, 'c': 3, 'd': {'x': 11, 'y': 12, 'z': 13}, 'e': 50}\n    );;\n}\n\ntest \"t24\" {\n    assert (\n        inheritance(\n            {'a': 'A', 'b': {'c': 'C', 'd': 'D'}}, {'b': {'d': 'D', 'e': 'E'}, 'f': 'F'}\n        )\n        == {'a': 'A', 'b': {'c': 'C', 'd': 'D', 'e': 'E'}, 'f': 'F'}\n    );;\n}\n\ntest \"t25\" {\n    assert (\n        inheritance(\n            {\"a\": {\"a1\": {\"a11\": \"a11_override\"}}, \"b\": \"b_override\"},\n            {\n                \"a\": {\"a1\": {\"a11\": \"a11_default\", \"a12\": \"a12_default\"}},\n                \"b\": \"b_default\"\n            }\n        )\n        == {\n            \"a\": {\"a1\": {\"a11\": \"a11_override\", \"a12\": \"a12_default\"}},\n            \"b\": \"b_override\"\n        }\n    );;\n}\n\ntest \"t26\" {\n    assert (\n        inheritance(\n            {'a': 1, 'b': 2, 'c': 3, 'd': {'x': 11, 'y': 12}},\n            {'a': 1, 'b': 20, 'c': 3, 'd': {'x': 111, 'y': 12, 'z': 13}}\n        )\n        == {'a': 1, 'b': 2, 'c': 3, 'd': {'x': 11, 'y': 12, 'z': 13}}\n    );;\n}\n\ntest \"t27\" {\n    assert (\n        inheritance(\n            {'a': 1, 'b': 2, 'c': {'d': 4, 'e': 5}}, {'a': 3, 'c': {'d': 6, 'f': 7}}\n        )\n        == {'a': 1, 'b': 2, 'c': {'d': 4, 'e': 5, 'f': 7}}\n    );;\n}\n\ntest \"t28\" {\n    assert (\n        inheritance({'a': {'b': {'c': {'d': 1}}}}, {'a': {'b': {'c': {'e': 2}}}})\n        == {'a': {'b': {'c': {'d': 1, 'e': 2}}}}\n    );;\n}\n\ntest \"t29\" {\n    assert (\n        inheritance({\"a\": 1, \"b\": {\"c\": 2, \"d\": 3}}, {\"a\": 1, \"b\": {\"c\": 2}})\n        == {\"a\": 1, \"b\": {\"c\": 2, \"d\": 3}}\n    );;\n}\n\ntest \"t30\" {\n    assert (\n        inheritance({'a': {'c': 7}}, {'a': {'b': 5, 'c': 3}}) == {'a': {'b': 5, 'c': 7}}\n    );;\n}\n\ntest \"t31\" {\n    assert (\n        inheritance(\n            {\"a\": {\"a1\": \"a1_override\"}, \"b\": \"b_override\"},\n            {\"a\": {\"a2\": \"a2_default\"}, \"b\": \"b_default\"}\n        )\n        == {\"a\": {\"a1\": \"a1_override\", \"a2\": \"a2_default\"}, \"b\": \"b_override\"}\n    );;\n}\n\ntest \"t32\" {\n    assert (\n        inheritance({'a': {'b': 1}}, {'a': {'b': 1, 'c': 2}}) == {'a': {'b': 1, 'c': 2}}\n    );;\n}\n\ntest \"t33\" {\n    assert (\n        inheritance(\n            {'a': {'b': 1, 'c': {'d': 3}}}, {'a': {'b': 1, 'c': {'d': 3, 'e': 4}}}\n        )\n        == {'a': {'b': 1, 'c': {'d': 3, 'e': 4}}}\n    );;\n}\n\ntest \"t34\" {\n    assert (inheritance({'a': 3}, {'a': 1, 'b': 2}) == {'a': 3, 'b': 2});;\n}\n\ntest \"t35\" {\n    assert (\n        inheritance(\n            {'a': 'foo', 'b': 'bar', 'c': {'d': 'baz', 'e': 'qux'}},\n            {'a': 'foo', 'b': 'bar', 'c': {'d': 'baz'}}\n        )\n        == {'a': 'foo', 'b': 'bar', 'c': {'d': 'baz', 'e': 'qux'}}\n    );;\n}\n\ntest \"t36\" {\n    assert (inheritance({'a': 1}, {}) == {'a': 1});;\n}\n\ntest \"t37\" {\n    assert (inheritance({'a': 3, 'b': 4}, {'a': 1, 'b': 2}) == {'a': 3, 'b': 4});;\n}\n\ntest \"t38\" {\n    assert (\n        inheritance(\n            {'a': 1, 'b': 2, 'c': 3, 'd': {'x': 11, 'y': 12}},\n            {'a': 1, 'b': 20, 'c': 3, 'd': {'x': 111, 'y': 12}}\n        )\n        == {'a': 1, 'b': 2, 'c': 3, 'd': {'x': 11, 'y': 12}}\n    );;\n}\n\ntest \"t39\" {\n    assert (inheritance({'a': [1]}, {'a': [1]}) == {'a': [1]});;\n}\n\ntest \"t40\" {\n    assert (\n        inheritance(\n            {\"a\": 1, \"b\": {\"c\": 2, \"d\": {\"e\": 4}}},\n            {\"a\": 1, \"b\": {\"c\": 2, \"d\": {\"e\": 4, \"f\": 5}}}\n        )\n        == {\"a\": 1, \"b\": {\"c\": 2, \"d\": {\"e\": 4, \"f\": 5}}}\n    );;\n}"}