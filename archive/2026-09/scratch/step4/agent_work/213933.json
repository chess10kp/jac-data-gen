{"id": 213933, "entrypoint": "trangle_area", "coverage": 100, "stage": "floor_pass", "python": "def trangle_area(a, b, c):\n    \"\"\"triangle_area\"\"\"\n    return ((a[0] - c[0]) * (b[1] - c[1]) - (a[1] - c[1]) * (b[0] - c[0])) / 2.0", "floor_fn": "\"\"\"triangle_area\"\"\"\ndef trangle_area(a: Any, b: Any, c: Any) -> object {\n    return ((((a[0] - c[0]) * (b[1] - c[1])) - ((a[1] - c[1]) * (b[0] - c[0]))) / 2.0);\n}", "test_blocks": "test \"t0\" {\n    assert (trangle_area(*[(0, 0), (1, 1), (0, 1)]) == 0.5);;\n}\n\ntest \"t1\" {\n    assert (trangle_area((1, 1), (0, 0), (1, 1)) == 0);;\n}\n\ntest \"t2\" {\n    assert (trangle_area((0, 0), (1, 0), (-0.5, 1)) == 0.5);;\n}\n\ntest \"t3\" {\n    assert (trangle_area(*[(0, 0), (1, 1), (0, 1)]) == 0.5);;\n}\n\ntest \"t4\" {\n    assert (trangle_area((0, 0), (1, 1), (0, 1)) == 0.5);;\n}\n\ntest \"t5\" {\n    assert (trangle_area((0, 0), (2, 2), (2, 2)) == 0);;\n}\n\ntest \"t6\" {\n    assert (trangle_area((0, 0), (-2, 0), (2, 0)) == 0);;\n}\n\ntest \"t7\" {\n    assert (trangle_area((0, 0), (1, 1), (1, 1)) == 0);;\n}\n\ntest \"t8\" {\n    assert (trangle_area((0, 0), (0, 0), (0, 0)) == 0);;\n}\n\ntest \"t9\" {\n    assert (trangle_area((0, 2), (1, 1), (2, 2)) == 1);;\n}"}