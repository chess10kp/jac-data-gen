{"id": 65898, "entrypoint": "split1d", "coverage": 99, "stage": "floor_pass", "python": "def split1d(Astart,Aend,Bstart,Bend):\n    \"\"\"For a 1-d pair of lines A and B:\n    given start and end locations,\n    produce new set of points for A, split by B.\n    \n    For example:\n    split1d(1,9,3,5)\n    splits the line from 1 to 9 into 3 pieces,\n    1 to 3\n    3 to 5\n    and\n    5 to 9\n    it returns these three pairs and a list of whether\n    those points were inside B.\n    In this case the list is [False,True,False]\n    \"\"\"\n    #five options\n    #1 A and B don't intersect. This shouldn't happen\n    if (Astart>=Bend) or (Bstart>=Aend):\n        #Not sure what to do\n        assert False\n    #2 B starts first, and ends inside A:\n    if (Astart>=Bstart) and (Bend<Aend):\n        #return Astart-Bend Bend-Aend\n        return [[Astart,Bend],[Bend,Aend]], [True, False]\n    #3 B extends beyond limits of A in both directions:\n    if (Bstart<=Astart) and (Bend>=Aend):\n        #return A\n        return [[Astart,Aend]], [True]\n    #4 B starts in A and finishes after A\n    if (Astart<Bstart) and (Bend>=Aend):\n        #return Astart-Bstart Bstart-Aend\n        return [[Astart,Bstart],[Bstart,Aend]], [False,True]\n    #5 B is inside A\n    if (Astart<Bstart) and (Bend<Aend):\n        #return Astart-Bstart Bstart-Bend Bend-Aend\n        return [[Astart,Bstart],[Bstart,Bend],[Bend,Aend]], [False,True,False]", "floor_fn": "\"\"\"For a 1-d pair of lines A and B:\n    given start and end locations,\n    produce new set of points for A, split by B.\n\n    For example:\n    split1d(1,9,3,5)\n    splits the line from 1 to 9 into 3 pieces,\n    1 to 3\n    3 to 5\n    and\n    5 to 9\n    it returns these three pairs and a list of whether\n    those points were inside B.\n    In this case the list is [False,True,False]\n    \"\"\"\ndef split1d(Astart: Any, Aend: Any, Bstart: Any, Bend: Any) -> object {\n    if ((Astart >= Bend) or (Bstart >= Aend)) {\n        assert False;\n    }\n    if ((Astart >= Bstart) and (Bend < Aend)) {\n        return ([[Astart, Bend], [Bend, Aend]], [True, False]);\n    }\n    if ((Bstart <= Astart) and (Bend >= Aend)) {\n        return ([[Astart, Aend]], [True]);\n    }\n    if ((Astart < Bstart) and (Bend >= Aend)) {\n        return ([[Astart, Bstart], [Bstart, Aend]], [False, True]);\n    }\n    if ((Astart < Bstart) and (Bend < Aend)) {\n        return ([[Astart, Bstart], [Bstart, Bend], [Bend, Aend]], [False, True, False]);\n    }\n}", "test_blocks": "test \"t0\" {\n    assert (split1d(1, 10, 2, 8) == ([[1, 2], [2, 8], [8, 10]], [False, True, False]));;\n}\n\ntest \"t1\" {\n    assert (split1d(1, 9, 0, 9) == ([[1, 9]], [True]));;\n}\n\ntest \"t2\" {\n    assert (split1d(0, 10, 5, 8) == ([[0, 5], [5, 8], [8, 10]], [False, True, False]));;\n}\n\ntest \"t3\" {\n    assert (split1d(1, 9, 3, 5) == ([[1, 3], [3, 5], [5, 9]], [False, True, False]));;\n}\n\ntest \"t4\" {\n    assert (split1d(1, 10, 8, 9) == ([[1, 8], [8, 9], [9, 10]], [False, True, False]));;\n}\n\ntest \"t5\" {\n    assert (split1d(1, 9, 1, 9) == ([[1, 9]], [True]));;\n}\n\ntest \"t6\" {\n    assert (split1d(0, 10, 0, 8) == ([[0, 8], [8, 10]], [True, False]));;\n}\n\ntest \"t7\" {\n    assert (split1d(0, 10, -1, 11) == ([[0, 10]], [True]));;\n}\n\ntest \"t8\" {\n    assert (split1d(1, 9, 3, 4) == ([[1, 3], [3, 4], [4, 9]], [False, True, False])) , \"split1d(1, 9, 3, 4) should be [[1, 3], [3, 4], [4, 9]], [False, True, False]\";;\n}\n\ntest \"t9\" {\n    assert (split1d(1, 9, 1, 8) == ([[1, 8], [8, 9]], [True, False]));;\n}\n\ntest \"t10\" {\n    assert (split1d(1, 9, 1, 5) == ([[1, 5], [5, 9]], [True, False]));;\n}\n\ntest \"t11\" {\n    assert (split1d(1, 10, 4, 5) == ([[1, 4], [4, 5], [5, 10]], [False, True, False]));;\n}\n\ntest \"t12\" {\n    assert (split1d(1, 10, 1, 7) == ([[1, 7], [7, 10]], [True, False]));;\n}\n\ntest \"t13\" {\n    assert (split1d(1, 9, 0, 10) == ([[1, 9]], [True]));;\n}\n\ntest \"t14\" {\n    assert (split1d(0, 10, 0, 9) == ([[0, 9], [9, 10]], [True, False]));;\n}\n\ntest \"t15\" {\n    assert (split1d(3, 9, 1, 5) == ([[3, 5], [5, 9]], [True, False]));;\n}\n\ntest \"t16\" {\n    assert (split1d(1, 9, 2, 3) == ([[1, 2], [2, 3], [3, 9]], [False, True, False]));;\n}\n\ntest \"t17\" {\n    assert (split1d(1, 10, 5, 7) == ([[1, 5], [5, 7], [7, 10]], [False, True, False]));;\n}\n\ntest \"t18\" {\n    assert (split1d(1, 1, 0, 2) == ([[1, 1]], [True]));;\n}\n\ntest \"t19\" {\n    assert (split1d(1, 9, 2, 4) == ([[1, 2], [2, 4], [4, 9]], [False, True, False]));;\n}\n\ntest \"t20\" {\n    assert (split1d(0, 10, 0, 10) == ([[0, 10]], [True]));;\n}\n\ntest \"t21\" {\n    assert (split1d(1, 10, 5, 10) == ([[1, 5], [5, 10]], [False, True]));;\n}\n\ntest \"t22\" {\n    assert (split1d(1, 9, 5, 10) == ([[1, 5], [5, 9]], [False, True]));;\n}\n\ntest \"t23\" {\n    assert (split1d(1, 9, 3, 9) == ([[1, 3], [3, 9]], [False, True]));;\n}\n\ntest \"t24\" {\n    assert (split1d(1, 9, -1, 9) == ([[1, 9]], [True]));;\n}\n\ntest \"t25\" {\n    assert (split1d(0, 10, 1, 8) == ([[0, 1], [1, 8], [8, 10]], [False, True, False]));;\n}\n\ntest \"t26\" {\n    assert (split1d(0, 10, -10, 20) == ([[0, 10]], [True]));;\n}\n\ntest \"t27\" {\n    assert (split1d(1, 9, 3, 7) == ([[1, 3], [3, 7], [7, 9]], [False, True, False]));;\n}\n\ntest \"t28\" {\n    assert (split1d(1, 9, 3, 4) == ([[1, 3], [3, 4], [4, 9]], [False, True, False]));;\n}\n\ntest \"t29\" {\n    assert (split1d(1, 9, 3, 5) == ([[1, 3], [3, 5], [5, 9]], [False, True, False]));;\n}\n\ntest \"t30\" {\n    assert (split1d(1, 10, 0, 10) == ([[1, 10]], [True]));;\n}\n\ntest \"t31\" {\n    assert (split1d(1, 9, 1, 9) == ([[1, 9]], [True]));;\n}\n\ntest \"t32\" {\n    assert (split1d(1, 10, 1, 10) == ([[1, 10]], [True]));;\n}\n\ntest \"t33\" {\n    assert (split1d(1, 9, -1, 10) == ([[1, 9]], [True]));;\n}\n\ntest \"t34\" {\n    assert (split1d(1, 10, 2, 7) == ([[1, 2], [2, 7], [7, 10]], [False, True, False]));;\n}\n\ntest \"t35\" {\n    assert (split1d(1, 3, 1, 3) == ([[1, 3]], [True]));;\n}\n\ntest \"t36\" {\n    assert (split1d(1, 5, 1, 5) == ([[1, 5]], [True]));;\n}\n\ntest \"t37\" {\n    assert (split1d(1, 10, 1, 10) == ([[1, 10]], [True]));;\n}\n\ntest \"t38\" {\n    assert (split1d(0, 10, 1, 9) == ([[0, 1], [1, 9], [9, 10]], [False, True, False]));;\n}\n\ntest \"t39\" {\n    assert (split1d(0, 10, -10, 11) == ([[0, 10]], [True]));;\n}\n\ntest \"t40\" {\n    assert (split1d(1, 9, 3, 5) == ([[1, 3], [3, 5], [5, 9]], [False, True, False])) , \"split1d(1, 9, 3, 5) should be [[1, 3], [3, 5], [5, 9]], [False, True, False]\";;\n}\n\ntest \"t41\" {\n    assert (split1d(1, 9, 2, 8) == ([[1, 2], [2, 8], [8, 9]], [False, True, False]));;\n}\n\ntest \"t42\" {\n    assert (split1d(1, 9, 1, 3) == ([[1, 3], [3, 9]], [True, False]));;\n}\n\ntest \"t43\" {\n    assert (split1d(1, 9, 3, 5) == ([[1, 3], [3, 5], [5, 9]], [False, True, False]));;\n}\n\ntest \"t44\" {\n    assert (split1d(1, 9, 2, 5) == ([[1, 2], [2, 5], [5, 9]], [False, True, False]));;\n}\n\ntest \"t45\" {\n    assert (split1d(0, 10, 3, 7) == ([[0, 3], [3, 7], [7, 10]], [False, True, False]));;\n}\n\ntest \"t46\" {\n    assert (split1d(0, 10, 4, 9) == ([[0, 4], [4, 9], [9, 10]], [False, True, False]));;\n}\n\ntest \"t47\" {\n    assert (split1d(0, 10, 0, 11) == ([[0, 10]], [True]));;\n}\n\ntest \"t48\" {\n    assert (split1d(1, 10, 3, 6) == ([[1, 3], [3, 6], [6, 10]], [False, True, False]));;\n}\n\ntest \"t49\" {\n    assert (split1d(1, 9, -1, 11) == ([[1, 9]], [True]));;\n}\n\ntest \"t50\" {\n    assert (split1d(1, 10, 7, 10) == ([[1, 7], [7, 10]], [False, True]));;\n}\n\ntest \"t51\" {\n    assert (split1d(1, 9, 1, 9) == ([[1, 9]], [True]));;\n}\n\ntest \"t52\" {\n    assert (split1d(1, 10, 3, 5) == ([[1, 3], [3, 5], [5, 10]], [False, True, False]));;\n}\n\ntest \"t53\" {\n    assert (split1d(1, 9, 0, 10) == ([[1, 9]], [True]));;\n}\n\ntest \"t54\" {\n    assert (split1d(1, 10, 0, 2) == ([[1, 2], [2, 10]], [True, False]));;\n}\n\ntest \"t55\" {\n    assert (split1d(1, 9, 1, 3) == ([[1, 3], [3, 9]], [True, False]));;\n}\n\ntest \"t56\" {\n    assert (split1d(1, 9, 2, 6) == ([[1, 2], [2, 6], [6, 9]], [False, True, False]));;\n}\n\ntest \"t57\" {\n    assert (split1d(1, 9, 2, 6) == ([[1, 2], [2, 6], [6, 9]], [False, True, False]));;\n}\n\ntest \"t58\" {\n    assert (split1d(1, 9, 1, 3) == ([[1, 3], [3, 9]], [True, False]));;\n}"}