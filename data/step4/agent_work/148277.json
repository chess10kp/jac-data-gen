{"id": 148277, "entrypoint": "nextDay", "coverage": 100, "stage": "floor_pass", "python": "def nextDay(year, month, day):\n    \"\"\"\n    Returns the year, month, day of the next day.\n    Simple version: assume every month has 30 days.\n    \"\"\"\n    years = year \n    months = month\n    days = day + 1\n    if days > 30:\n        days = 1\n        months = month + 1\n        if months > 12:\n            months = 1\n            years = year + 1\n    return (years, months, days)", "floor_fn": "\"\"\"\n    Returns the year, month, day of the next day.\n    Simple version: assume every month has 30 days.\n    \"\"\"\ndef nextDay(year: Any, month: Any, day: Any) -> object {\n    years = year;\n    months = month;\n    days = day + 1;\n    if (days > 30) {\n        days = 1;\n        months = month + 1;\n        if (months > 12) {\n            months = 1;\n            years = year + 1;\n        }\n    }\n    return (years, months, days);\n}", "test_blocks": "test \"t0\" {\n    assert (nextDay(2019, 12, 31) == (2020, 1, 1));;\n}\n\ntest \"t1\" {\n    assert (nextDay(2016, 12, 31) == (2017, 1, 1));;\n}\n\ntest \"t2\" {\n    assert (nextDay(2000, 1, 1) == (2000, 1, 2));;\n}\n\ntest \"t3\" {\n    assert (nextDay(1900, 1, 1) == (1900, 1, 2));;\n}\n\ntest \"t4\" {\n    assert (nextDay(2015, 12, 30) == (2016, 1, 1));;\n}\n\ntest \"t5\" {\n    assert (nextDay(2010, 11, 30) == (2010, 12, 1));;\n}\n\ntest \"t6\" {\n    assert (nextDay(2017, 1, 1) == (2017, 1, 2));;\n}\n\ntest \"t7\" {\n    assert (nextDay(2017, 2, 30) == (2017, 3, 1));;\n}\n\ntest \"t8\" {\n    assert (nextDay(2012, 1, 30) == (2012, 2, 1));;\n}\n\ntest \"t9\" {\n    assert (nextDay(2018, 12, 31) == (2019, 1, 1));;\n}\n\ntest \"t10\" {\n    assert (nextDay(2017, 8, 30) == (2017, 9, 1));;\n}\n\ntest \"t11\" {\n    assert (nextDay(2010, 1, 31) == (2010, 2, 1));;\n}\n\ntest \"t12\" {\n    assert (nextDay(2015, 12, 31) == (2016, 1, 1));;\n}\n\ntest \"t13\" {\n    assert (nextDay(2018, 1, 30) == (2018, 2, 1));;\n}\n