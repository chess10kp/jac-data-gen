{"id": 457942, "entrypoint": "scale", "coverage": 100, "stage": "floor_pass", "python": "def scale(pix, pixMax, floatMin, floatMax):\n    \"\"\" scale takes in\n        pix, the CURRENT pixel column (or row)\n        pixMax, the total # of pixel columns\n        floatMin, the min floating-point value\n        floatMax, the max floating-point value\n        scale returns the floating-point value that\n        corresponds to pix\n    \"\"\"\n    return (pix / pixMax) * (floatMax - floatMin) + floatMin", "floor_fn": "\"\"\" scale takes in\n        pix, the CURRENT pixel column (or row)\n        pixMax, the total # of pixel columns\n        floatMin, the min floating-point value\n        floatMax, the max floating-point value\n        scale returns the floating-point value that\n        corresponds to pix\n    \"\"\"\ndef scale(pix: Any, pixMax: Any, floatMin: Any, floatMax: Any) -> object {\n    return (((pix / pixMax) * (floatMax - floatMin)) + floatMin);\n}", "test_blocks": "test \"t0\" {\n    assert (scale(2, 4, 0, 1) == 0.5);;\n}\n\ntest \"t1\" {\n    assert (scale(0, 10, 1, 0) == 1.0);;\n}\n\ntest \"t2\" {\n    assert (scale(5, 10, 0.0, 1.0) == 0.5);;\n}\n\ntest \"t3\" {\n    assert (scale(4, 4, 0, 1) == 1);;\n}\n\ntest \"t4\" {\n    assert (scale(10, 10, -5, 5) == 5);;\n}\n\ntest \"t5\" {\n    assert (scale(1, 1, 1.0, 0.0) == 0.0);;\n}\n\ntest \"t6\" {\n    assert (scale(100, 100, 0, 100) == 100);;\n}\n\ntest \"t7\" {\n    assert (scale(1, 2, 0, 100) == 50);;\n}\n\ntest \"t8\" {\n    assert (scale(0, 4, 1, 2) == 1);;\n}\n\ntest \"t9\" {\n    assert (scale(2, 10, 0, 1) == 0.2);;\n}\n\ntest \"t10\" {\n    assert (scale(100, 100, 0.0, 1.0) == 1.0);;\n}\n\ntest \"t11\" {\n    assert (scale(1, 10, 0, 1) == 0.1);;\n}\n\ntest \"t12\" {\n    assert (scale(10, 10, 0, 1) == 1);;\n}\n\ntest \"t13\" {\n    assert (scale(5, 10, 100, 200) == 150);;\n}\n\ntest \"t14\" {\n    assert (scale(10, 10, 2, 8) == 8);;\n}\n\ntest \"t15\" {\n    assert (scale(0, 10, -10, 0) == -10);;\n}\