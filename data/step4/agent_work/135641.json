{"id": 135641, "entrypoint": "add_to_dict_of_levels", "coverage": 100, "stage": "floor_pass", "python": "def add_to_dict_of_levels(dict_levels, c, cur_level, index):\n    \"\"\"\n    Function returns the dict of positions according to the level of space or comma\n    Example: {'1_,': [14], '2_,': [9], '0_ ': [3], '1_ ': [12]}\n        comma of level 1: position 14\n        comma of level 2: position 9\n        space of level 0: position 3\n        space of level 1: position 12\n    \"\"\"\n    symbol = str(cur_level) + '_' + c\n    if symbol not in dict_levels:\n        dict_levels[symbol] = []\n    dict_levels[symbol].append(index)\n    return dict_levels", "floor_fn": "\"\"\"\n    Function returns the dict of positions according to the level of space or comma\n    Example: {'1_,': [14], '2_,': [9], '0_ ': [3], '1_ ': [12]}\n        comma of level 1: position 14\n        comma of level 2: position 9\n        space of level 0: position 3\n        space of level 1: position 12\n    \"\"\"\ndef add_to_dict_of_levels(\n    dict_levels: Any, c: Any, cur_level: Any, index: Any\n) -> object {\n    symbol = str(cur_level) + '_' + c;\n    if (symbol not in dict_levels) {\n        dict_levels[symbol] = [];\n    }\n    dict_levels[symbol].append(index);\n    return dict_levels;\n}", "test_blocks": "test \"t0\" {\n    assert (add_to_dict_of_levels(`dict(), ',', 0, 14) == {'0_,': [14]});;\n}\n\ntest \"t1\" {\n    assert (add_to_dict_of_levels(`dict(), ',', 0, 0) == {'0_,': [0]});;\n}\n\ntest \"t2\" {\n    assert (add_to_dict_of_levels(`dict(), 'b', 0, 14) == {'0_b': [14]});;\n}\n\ntest \"t3\" {\n    assert (\n        add_to_dict_of_levels(\n            {'2_,': [9], '0_ ': [3], '1_,': [14], '1_ ': [12]}, ',', 2, 16\n        )\n        == {'2_,': [9, 16], '0_ ': [3], '1_,': [14], '1_ ': [12]}\n    );;\n}\n\ntest \"t4\" {\n    assert (\n        add_to_dict_of_levels({'0_c': [1, 2, 3, 4], '0_d': [5, 6]}, 'c', 0, 9)\n        == {'0_c': [1, 2, 3, 4, 9], '0_d': [5, 6]}\n    );;\n}\n\ntest \"t5\" {\n    assert (add_to_dict_of_levels({}, 'c', 0, 1) == {'0_c': [1]});;\n}\n\ntest \"t6\" {\n    assert (add_to_dict_of_levels(`dict(), ',', 2, 3) == {'2_,': [3]});;\n}\n\ntest \"t7\" {\n    assert (add_to_dict_of_levels(`dict(), ',', 1, 3) == {'1_,': [3]});;\n}\n\ntest \"t8\" {\n    assert (add_to_dict_of_levels(`dict(), ',', 2, 12) == {'2_,': [12]});;\n}\n\ntest \"t9\" {\n    assert (add_to_dict_of_levels(`dict(), ',', 0, 3) == {'0_,': [3]});;\n}\n\ntest \"t10\" {\n    assert (\n        add_to_dict_of_levels(\n            {'1_,': [14], '2_,': [9], '0_ ': [3], '1_ ': [12]}, ',', 1, 15\n        )\n        == {'1_,': [14, 15], '2_,': [9], '0_ ': [3], '1_ ': [12]}\n    );;\n}\n\ntest \"t11\" {\n    assert (add_to_dict_of_levels(`dict(), ', ', 3, 5) == {'3_, ': [5]});;\n}\n\ntest \"t12\" {\n    assert (add_to_dict_of_levels(`dict(), 'a', 0, 2) == {'0_a': [2]});;\n}\n\ntest \"t13\" {\n    assert (add_to_dict_of_levels(`dict(), 'a', 1, 15) == {'1_a': [15]});;\n}\n\ntest \"t14\" {\n    assert (add_to_dict_of_levels(`dict(), ',', 2, 3) == {'2_,': [3]});;\n}\n\ntest \"t15\" {\n    assert (add_to_dict_of_levels(`dict(), 'b', 2, 13) == {'2_b': [13]});;\n}\n\ntest \"t16\" {\n    assert (add_to_dict_of_levels(`dict(), ',', 1, 3) == {'1_,': [3]});;\n}\n\ntest \"t17\" {\n    assert (add_to_dict_of_levels(`dict(), '', 1, 5) == {'1_': [5]});;\n}\n\ntest \"t18\" {\n    assert (add_to_dict_of_levels(`dict(), ',', 1, 14) == {'1_,': [14]});;\n}\n\ntest \"t19\" {\n    assert (\n        add_to_dict_of_levels({'1_,': [14], '2_,': [9], '0_ ': [3]}, ',', 1, 12)\n        == {'1_,': [14, 12], '2_,': [9], '0_ ': [3]}\n    );;\n}\n\ntest \"t20\" {\n    assert (add_to_dict_of_levels({'0_c': [1]}, 'd', 0, 2) == {'0_c': [1], '0_d': [2]});;\n}\n\ntest \"t21\" {\n    assert (add_to_dict_of_levels({}, \"a\", 1, 0) == {\"1_a\": [0]}) , \"Should return {'1_a': [0]} for input {}, 'a', 1, 0\";;\n}\n\ntest \"t22\" {\n    assert (add_to_dict_of_levels({'1_,': [14]}, ',', 1, 14) == {'1_,': [14, 14]});;\n}\n\ntest \"t23\" {\n    assert (add_to_dict_of_levels({'0_c': [1]}, 'c', 0, 2) == {'0_c': [1, 2]});;\n}\n\ntest \"t24\" {\n    assert (\n        add_to_dict_of_levels(\n            **{'dict_levels': {}, 'c': ',', 'cur_level': 1, 'index': 14}\n        )\n        == {'1_,': [14]}\n    );;\n}\n\ntest \"t25\" {\n    assert (add_to_dict_of_levels({'1_,': [14]}, ',', 1, 9) == {'1_,': [14, 9]});;\n}\n\ntest \"t26\" {\n    assert (add_to_dict_of_levels(`dict(), ',', 2, 9) == {'2_,': [9]});;\n}\n\ntest \"t27\" {\n    assert (add_to_dict_of_levels({}, ',', 1, 14) == {'1_,': [14]});;\n}\n\ntest \"t28\" {\n    assert (\n        add_to_dict_of_levels({'1_,': [14], '1_ ': [12]}, ',', 1, 13)\n        == {'1_,': [14, 13], '1_ ': [12]}\n    );;\n}\n\ntest \"t29\" {\n    assert (add_to_dict_of_levels(`dict(), 'b', 1, 7) == {'1_b': [7]});;\n}\n\ntest \"t30\" {\n    assert (add_to_dict_of_levels(`dict(), ',', 2, 9) == {'2_,': [9]});;\n}\n\ntest \"t31\" {\n    assert (add_to_dict_of_levels(`dict(), ',', 1, 1) == {'1_,': [1]});;\n}\n\ntest \"t32\" {\n    assert (add_to_dict_of_levels(`dict(), ',', 1, 5) == {'1_,': [5]});;\n}\n\ntest \"t33\" {\n    assert (\n        add_to_dict_of_levels({'1_,': [14, 14]}, ',', 1, 14) == {'1_,': [14, 14, 14]}\n    );;\n}\n\ntest \"t34\" {\n    assert (add_to_dict_of_levels(`dict(), ',', 3, 5) == {'3_,': [5]});;\n}\n\ntest \"t35\" {\n    assert (add_to_dict_of_levels(`dict(), 'c', 2, 15) == {'2_c': [15]});;\n}\n\ntest \"t36\" {\n    assert (add_to_dict_of_levels(`dict(), 'a', 2, 12) == {'2_a': [12]});;\n}\n\ntest \"t37\" {\n    assert (\n        add_to_dict_of_levels({'0_c': [1], '0_d': [2]}, 'd', 0, 3)\n        == {'0_c': [1], '0_d': [2, 3]}\n    );;\n}\n\ntest \"t38\" {\n    assert (add_to_dict_of_levels(`dict(), ',', 1, 9) == {'1_,': [9]});;\n}\n\ntest \"t39\" {\n    assert (add_to_dict_of_levels(`dict(), ',', 1, 14) == {'1_,': [14]});;\n}\n\ntest \"t40\" {\n    assert (\n        add_to_dict_of_levels({\"1_a\": [0]}, \"b\", 2, 1) == {\"1_a\": [0], \"2_b\": [1]}\n    ) , \"Should return {'1_a': [0], '2_b': [1]} for input {'1_a': [0]}, 'b', 2, 1\";;\n}"}