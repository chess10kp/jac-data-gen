{"id": 341143, "entrypoint": "karatsuba", "coverage": 100, "stage": "floor_pass", "python": "def karatsuba(x, y, base=10):\n    \"\"\" Function to multiply 2 numbers in a more efficient manner than the grade school algorithm.\"\"\"\n    if len(str(x)) == 1 or len(str(y)) == 1:\n        return x*y\n    else:\n        n = max(len(str(x)),len(str(y)))\n        # that's suboptimal, and ugly, but it's quick to write\n\n        nby2 = n // 2\n        # split x in b + 10^{n/2} a, with a and b of sizes at most n/2\n        a = x // base**(nby2)\n        b = x %  base**(nby2)\n        # split y in d + 10^{n/2} c, with c and d of sizes at most n/2\n        c = y // base**(nby2)\n        d = y %  base**(nby2)\n\n        # we make 3 calls to entries which are 2 times smaller\n        ac = karatsuba(a, c)\n        bd = karatsuba(b, d)\n        # ad + bc = (a+b)(c+d) - ac - bd as (a+b)(c+d) = ac + ad + bc + bd\n        ad_plus_bc = karatsuba(a + b, c + d) - ac - bd\n        # x y = (b + 10^{n/2} a) (d + 10^{n/2} c)\n        # ==> x y = bd + 10^{n/2} (ad_plus_bc) + 10^{n} (a c)\n\n        # this little trick, writing n as 2*nby2 takes care of both even and odd n\n        prod = ac * base**(2*nby2) + (ad_plus_bc * base**nby2) + bd\n\n        return prod", "floor_fn": "\"\"\" Function to multiply 2 numbers in a more efficient manner than the grade school algorithm.\"\"\"\ndef karatsuba(x: Any, y: Any, base: Any = 10) -> object {\n    if ((len(str(x)) == 1) or (len(str(y)) == 1)) {\n        return (x * y);\n    } else {\n        n = max(len(str(x)), len(str(y)));\n        nby2 = n // 2;\n        a = x // (base ** nby2);\n        b = x % (base ** nby2);\n        c = y // (base ** nby2);\n        d = y % (base ** nby2);\n        ac = karatsuba(a, c);\n        bd = karatsuba(b, d);\n        ad_plus_bc = karatsuba((a + b), (c + d)) - ac - bd;\n        prod = (ac * (base ** (2 * nby2))) + (ad_plus_bc * (base ** nby2)) + bd;\n        return prod;\n    }\n}", "test_blocks": "test \"t0\" {\n    assert (karatsuba(-999999, 123) == (-999999 * 123));;\n}\n\ntest \"t1\" {\n    assert (karatsuba(123456789, 987654321) == (123456789 * 987654321));;\n}\n\ntest \"t2\" {\n    assert (karatsuba((2 ** 100), (2 ** 200)) == (2 ** 300));;\n}\n\ntest \"t3\" {\n    assert (karatsuba(15, 15) == 225);;\n}\n\ntest \"t4\" {\n    assert (karatsuba(123456789, 987654321) == 121932631112635269);;\n}\n\ntest \"t5\" {\n    assert (karatsuba(1, 1) == (1 * 1));;\n}\n\ntest \"t6\" {\n    assert (karatsuba(5, 11, 1000) == 55);;\n}\n\ntest \"t7\" {\n    assert (\n        karatsuba(\n            3141592653589793238462643383279502884197169399375105820974944592,\n            2718281828459045235360287471352662497757247093699959574966967627\n        )\n        == 8539734222673567065463550869546574495034888535765114961879601127067743044893204848617875072216249073013374895871952806582723184\n    );;\n}\n\ntest \"t8\" {\n    assert (karatsuba(123, 4567890123) == (123 * 4567890123));;\n}\n\ntest \"t9\" {\n    assert (karatsuba(1, 2) == 2);;\n}\n\ntest \"t10\" {\n    assert (karatsuba(5, 11) == 55);;\n}\n\ntest \"t11\" {\n    assert (karatsuba(123, 321) == (123 * 321));;\n}\n\ntest \"t12\" {\n    assert (karatsuba((10 ** 10), (10 ** 10)) == (10 ** 20));;\n}\n\ntest \"t13\" {\n    assert (karatsuba(10, 2000000000) == (10 * 2000000000));;\n}\n\ntest \"t14\" {\n    assert (karatsuba(1234, 5678) == 7006652);;\n}\n\ntest \"t15\" {\n    assert (karatsuba(4, 9) == 36);;\n}\n\ntest \"t16\" {\n    assert (karatsuba(3, 3) == 9);;\n}\n\ntest \"t17\" {\n    assert (karatsuba(123, 123) == 15129);;\n}\n\ntest \"t18\" {\n    assert (karatsuba(0, 0) == (0 * 0));;\n}\n\ntest \"t19\" {\n    assert (karatsuba(10, 10) == 100);;\n}\n\ntest \"t20\" {\n    assert (karatsuba((10 ** 25), (10 ** 25)) == (10 ** 50));;\n}\n\ntest \"t21\" {\n    assert (karatsuba(1, 0) == 0);;\n}\n\ntest \"t22\" {\n    assert (karatsuba(123, 123) == int((123 * 123)));;\n}\n\ntest \"t23\" {\n    assert (karatsuba(123, 456) == (123 * 456));;\n}\n\ntest \"t24\" {\n    assert (karatsuba(3, 8) == 24) , \"should be 24\";;\n}\n\ntest \"t25\" {\n    assert (karatsuba(12, 13) == 156);;\n}\n\ntest \"t26\" {\n    assert (karatsuba(123, 45678) == (123 * 45678));;\n}\n\ntest \"t27\" {\n    assert (karatsuba(0, 0) == 0);;\n}\n\ntest \"t28\" {\n    assert (karatsuba(123, 45678901) == (123 * 45678901));;\n}\n\ntest \"t29\" {\n    assert (karatsuba(7, 2) == 14) , \"should be 14\";;\n}\n\ntest \"t30\" {\n    assert (karatsuba(123456, 0) == 0);;\n}\n\ntest \"t31\" {\n    assert (karatsuba(987654321, 123456789) == 121932631112635269);;\n}\n\ntest \"t32\" {\n    assert (karatsuba(0, 1) == (0 * 1));;\n}\n\ntest \"t33\" {\n    assert (karatsuba(123, 45600) == (123 * 45600));;\n}\n\ntest \"t34\" {\n    assert (karatsuba(123, 3) == (123 * 3));;\n}\n\ntest \"t35\" {\n    assert (karatsuba(123, 4560000) == (123 * 4560000));;\n}\n\ntest \"t36\" {\n    assert (karatsuba((10 ** 100), (10 ** 100), (10 ** 5)) == (10 ** 200));;\n}\n\ntest \"t37\" {\n    assert (karatsuba(123, 456789) == (123 * 456789));;\n}\n\ntest \"t38\" {\n    assert (karatsuba(10, 100, 10) == 1000);;\n}\n\ntest \"t39\" {\n    assert (karatsuba(123, -999999) == (123 * -999999));;\n}\n\ntest \"t40\" {\n    assert (karatsuba((10 ** 100), (10 ** 100)) == (10 ** (2 * 100)));;\n}\n\ntest \"t41\" {\n    assert (karatsuba((2 ** 100), (2 ** 90)) == (2 ** 190));;\n}\n\ntest \"t42\" {\n    assert (karatsuba(123, 456) == 56088);;\n}\n\ntest \"t43\" {\n    assert (karatsuba(12, 12) == 144);;\n}\n\ntest \"t44\" {\n    assert (karatsuba(123456789, 123456789) == 15241578750190521);;\n}\n\ntest \"t45\" {\n    assert (karatsuba(5, 11, 10) == 55);;\n}\n\ntest \"t46\" {\n    assert (karatsuba(10, 1000) == 10000);;\n}\n\ntest \"t47\" {\n    assert (karatsuba(10, 11) == 110);;\n}\n\ntest \"t48\" {\n    assert (karatsuba(0, 100) == 0);;\n}\n\ntest \"t49\" {\n    assert (karatsuba(1000, 10) == 10000);;\n}\n\ntest \"t50\" {\n    assert (karatsuba(2, 2) == 4);;\n}\n\ntest \"t51\" {\n    