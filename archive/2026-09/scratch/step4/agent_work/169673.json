{"id": 169673, "entrypoint": "date", "coverage": 100, "stage": "floor_pass", "python": "def date(string):\n    \"\"\"Strip off the T from the datetime string\"\"\"\n    return string.replace('T', ' ')", "floor_fn": "\"\"\"Strip off the T from the datetime string\"\"\"\ndef date(string: Any) -> object {\n    return string.replace('T', ' ');\n}", "test_blocks": "test \"t0\" {\n    assert (date('2020-10-21B14:30:00.000Z') == '2020-10-21B14:30:00.000Z');;\n}\n\ntest \"t1\" {\n    assert (date('2012-03-03T00:00:00') == '2012-03-03 00:00:00');;\n}\n\ntest \"t2\" {\n    assert (date(\"2019-01-01\") == \"2019-01-01\");;\n}\n\ntest \"t3\" {\n    assert (date('2016-07-20 16:24:34.000000000') == '2016-07-20 16:24:34.000000000');;\n}\n\ntest \"t4\" {\n    assert (date('2012-10-09T12:34:56') == '2012-10-09 12:34:56');;\n}\n\ntest \"t5\" {\n    assert (date(\"2019-01-01T12:34:56\") == \"2019-01-01 12:34:56\");;\n}\n\ntest \"t6\" {\n    assert (date('2020-10-21C14:30:00.000Z') == '2020-10-21C14:30:00.000Z');;\n}\n\ntest \"t7\" {\n    assert (date('1991-12-02T00:00:00') == '1991-12-02 00:00:00');;\n}\n\ntest \"t8\" {\n    assert (date(\"2019-01-01 12:34:56\") == \"2019-01-01 12:34:56\");;\n}\n\ntest \"t9\" {\n    assert (date(\"2018-02-07T13:28:17\") == \"2018-02-07 13:28:17\");;\n}\n\ntest \"t10\" {\n    assert (date('2000-01-01T00:00:00') == '2000-01-01 00:00:00');;\n}\n\ntest \"t11\" {\n    assert (date('1992-03-07T12:00:00') == '1992-03-07 12:00:00');;\n}\n\ntest \"t12\" {\n    assert (date('2004-01-12T13:00:00') == '2004-01-12 13:00:00');;\n}\n\ntest \"t13\" {\n    assert (date(\"2019-01\") == \"2019-01\");;\n}\n\ntest \"t14\" {\n    assert (date('2017-07-01T00:00:00') == '2017-07-01 00:00:00');;\n}\n\ntest \"t15\" {\n    assert (date('2016-07-20T16:24:34.000000000') == '2016-07-20 16:24:34.000000000');;\n}\n\ntest \"t16\" {\n    assert (date('1988-09-14T16:00:00') == '1988-09-14 16:00:00');;\n}\n\ntest \"t17\" {\n    assert (date(\"2015-01-01T00:00:00\") == \"2015-01-01 00:00:00\");;\n}\n\ntest \"t18\" {\n    assert (date('2016-07-20') == '2016-07-20');;\n}\n\ntest \"t19\" {\n    assert (date(\"1970-01-01T00:00:00\") == \"1970-01-01 00:00:00\");;\n}\n\ntest \"t20\" {\n    assert (date('2015-05-22T00:00:00') == '2015-05-22 00:00:00');;\n}\n\ntest \"t21\" {\n    assert (date(\"\") == \"\");;\n}\n\ntest \"t22\" {\n    assert (date(\"2015-01-01T12:34:56\") == \"2015-01-01 12:34:56\");;\n}\n\ntest \"t23\" {\n    assert (date('1980-05-04T12:00:00') == '1980-05-04 12:00:00');;\n}"}