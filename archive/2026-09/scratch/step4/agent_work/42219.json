{"id": 42219, "entrypoint": "crr_m", "coverage": 100, "stage": "floor_pass", "python": "def crr_m(ksigma, msf, crr_m7p5):\n    \"\"\"Cyclic resistance ratio corrected for magnitude and confining stress\"\"\"\n    return crr_m7p5 * ksigma * msf", "floor_fn": "\"\"\"Cyclic resistance ratio corrected for magnitude and confining stress\"\"\"\ndef crr_m(ksigma: Any, msf: Any, crr_m7p5: Any) -> object {\n    return (crr_m7p5 * ksigma * msf);\n}", "test_blocks": "test \"t0\" {\n    assert (crr_m(1.0, 1.0, 1.0) == 1.0);;\n}\n\ntest \"t1\" {\n    assert (crr_m(1, 0.5, 1) == 0.5);;\n}\n\ntest \"t2\" {\n    assert (crr_m(1.1, 1.2, 1.3) == (1.3 * 1.1 * 1.2));;\n}\n\ntest \"t3\" {\n    assert (crr_m(0, 2, 1) == 0);;\n}\n\ntest \"t4\" {\n    assert (crr_m(1, 1, 1) == 1);;\n}\n\ntest \"t5\" {\n    assert (crr_m(1, 1, 1.5) == 1.5);;\n}\n\ntest \"t6\" {\n    assert (crr_m(0, 0.5, 1) == 0);;\n}\n\ntest \"t7\" {\n    assert (crr_m(2, 1, 1) == 2);;\n}\n\ntest \"t8\" {\n    assert (crr_m(0, 1, 1) == 0);;\n}\n\ntest \"t9\" {\n    assert (crr_m(1, 2, 1) == 2);;\n}\n\ntest \"t10\" {\n    assert (crr_m(0, 2, 0.5) == 0);;\n}\n\ntest \"t11\" {\n    assert (crr_m(40000, 0.0, 1.1) == 0.0);;\n}\n\ntest \"t12\" {\n    assert (crr_m(1, 1, 2) == 2);;\n}\n\ntest \"t13\" {\n    assert (crr_m(1, 1.1, 1) == 1.1);;\n}\n\ntest \"t14\" {\n    assert (crr_m(0.0, 0.0, 0.0) == 0.0);;\n}\n\ntest \"t15\" {\n    assert (crr_m(0, 0.5, 1.5) == 0);;\n}\n\ntest \"t16\" {\n    assert (crr_m(0, 1.5, 1) == 0);;\n}\n\ntest \"t17\" {\n    assert (crr_m(0.3, 1, 1) == 0.3);;\n}\n\ntest \"t18\" {\n    assert (crr_m(0, 1, 0.5) == 0);;\n}\n\ntest \"t19\" {\n    assert (crr_m(0.9, 1, 1) == 0.9);;\n}\n\ntest \"t20\" {\n    assert (crr_m(30000, 0.0, 1.1) == 0.0);;\n}\n\ntest \"t21\" {\n    assert (crr_m(0.5, 1, 0.5) == 0.25);;\n}\n\ntest \"t22\" {\n    assert (crr_m(30000, 0.0, 1.5) == 0.0);;\n}\n\ntest \"t23\" {\n    assert (crr_m(1.1, 1, 1) == 1.1);;\n}\n\ntest \"t24\" {\n    assert (crr_m(1.0, 2.0, 0.5) == 1.0);;\n}\n\ntest \"t25\" {\n    assert (crr_m(0.5, 1, 1) == 0.5);;\n}\n\ntest \"t26\" {\n    assert (crr_m(1, 1.5, 1) == 1.5);;\n}\n\ntest \"t27\" {\n    assert (crr_m(1, 1, 0.5) == 0.5);;\n}"}