{"id": 359117, "entrypoint": "make_new", "coverage": 94, "stage": "floor_pass", "python": "def make_new(data, name):\n    \"\"\"Make a copy of a dictionary with defaults.\"\"\"\n\n    if name not in data:\n        return None\n    out = data['_defaults'].copy()\n    out.update(data[name])\n    return out", "floor_fn": "\"\"\"Make a copy of a dictionary with defaults.\"\"\"\ndef make_new(data: Any, name: Any) -> object {\n    if (name not in data) {\n        return None;\n    }\n    out = data['_defaults'].copy();\n    out.update(data[name]);\n    return out;\n}", "test_blocks": "test \"t0\" {\n    assert (\n        make_new({'_defaults': {'a': 1, 'b': 2}, 'd': {'b': 3}}, 'd')\n        == {'a': 1, 'b': 3}\n    );;\n}\n\ntest \"t1\" {\n    assert (\n        make_new(\n            {\n                '_defaults': {'a': 1, 'b': 2, 'c': 3},\n                'foo': {'a': None, 'b': None, 'c': None, 'd': 5}\n            },\n            'foo'\n        )\n        == {'a': None, 'b': None, 'c': None, 'd': 5}\n    );;\n}\n\ntest \"t2\" {\n    assert (\n        make_new(\n            {\n                '_defaults': {'a': 1, 'b': 2, 'c': 3},\n                'foo': {'a': None, 'b': 4, 'c': 5, 'd': 6}\n            },\n            'foo'\n        )\n        == {'a': None, 'b': 4, 'c': 5, 'd': 6}\n    );;\n}\n\ntest \"t3\" {\n    assert (\n        make_new({'_defaults': {'a': 1, 'b': 2}, 'd': {'a': 3}}, 'd')\n        == {'a': 3, 'b': 2}\n    );;\n}\n\ntest \"t4\" {\n    assert (\n        make_new({'_defaults': {'a': 1, 'b': 2}, 'x': {'b': 3}, 'y': {'c': 4}}, 'y')\n        == {'a': 1, 'b': 2, 'c': 4}\n    );;\n}\n\ntest \"t5\" {\n    assert (\n        make_new({'_defaults': {'a': 1, 'b': 2}, 'x': {'a': 3}, 'y': {'b': 4}}, 'x')\n        == {'a': 3, 'b': 2}\n    );;\n}\n\ntest \"t6\" {\n    assert (\n        make_new({'_defaults': {'a': 1, 'b': 2}, 'd': {'c': 3}}, 'd')\n        == {'a': 1, 'b': 2, 'c': 3}\n    );;\n}\n\ntest \"t7\" {\n    assert (\n        make_new(\n            {'_defaults': {'a': 1, 'b': 2, 'c': 3}, 'foo': {'b': 4, 'd': 5}}, 'foo'\n        )\n        == {'a': 1, 'b': 4, 'c': 3, 'd': 5}\n    );;\n}\n\ntest \"t8\" {\n    assert (\n        make_new({'_defaults': {'a': 1, 'b': 2}, 'x': {'b': 3}, 'y': {'c': 4}}, 'x')\n        == {'a': 1, 'b': 3}\n    );;\n}\n\ntest \"t9\" {\n    assert (\n        make_new(\n            {'_defaults': {'a': 1, 'b': 2, 'c': 3}, 'foo': {'a': None, 'd': 5}}, 'foo'\n        )\n        == {'a': None, 'b': 2, 'c': 3, 'd': 5}\n    );;\n}"}