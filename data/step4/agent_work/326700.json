{"id": 326700, "entrypoint": "as_gb", "coverage": 100, "stage": "floor_pass", "python": "def as_gb(in_size: int) -> int:\n    \"\"\"\n    Converter functions to convert the size in bytes to gigabytes.\n    \"\"\"\n    conv = 1024 * 1024 * 1024\n    return in_size // conv", "floor_fn": "\"\"\"\n    Converter functions to convert the size in bytes to gigabytes.\n    \"\"\"\ndef as_gb(in_size: int) -> int {\n    conv = 1024 * 1024 * 1024;\n    return (in_size // conv);\n}", "test_blocks": "test \"t0\" {\n    assert (as_gb(1000) == 0);;\n}\n\ntest \"t1\" {\n    assert (as_gb((1024 ** 3)) == ((1024 ** 3) // (1024 * 1024 * 1024)));;\n}\n\ntest \"t2\" {\n    assert (as_gb(1023) == 0);;\n}\n\ntest \"t3\" {\n    assert (as_gb((1024 * 1024 * 1023)) == 0);;\n}\n\ntest \"t4\" {\n    assert (as_gb((1024 ** 2)) == ((1024 ** 2) // (1024 * 1024 * 1024)));;\n}\n\ntest \"t5\" {\n    assert (as_gb((1024 ** 3)) == 1);;\n}\n\ntest \"t6\" {\n    assert (as_gb((1024 * 1024 * 1024)) == 1);;\n}\n\ntest \"t7\" {\n    assert (as_gb((1024 ** 4)) == ((1024 ** 4) // (1024 * 1024 * 1024)));;\n}\n\ntest \"t8\" {\n    assert (as_gb((1024 ** 4)) == 1024);;\n}\n\ntest \"t9\" {\n    assert (as_gb((1024 * 1023)) == 0);;\n}\n\ntest \"t10\" {\n    assert (as_gb(300) == 0);;\n}\n\ntest \"t11\" {\n    assert (as_gb(1024) == (1024 // (1024 * 1024 * 1024)));;\n}\n\ntest \"t12\" {\n    assert (as_gb(1) == 0);;\n}\n\ntest \"t13\" {\n    assert (as_gb((1024 * 1024 * 1024 * 1024 * 2)) == 2048);;\n}\n\ntest \"t14\" {\n    assert (as_gb((1024 ** 6)) == (1024 ** 3));;\n}\n\ntest \"t15\" {\n    assert (as_gb(0) == 0);;\n}\n\ntest \"t16\" {\n    assert (as_gb((1024 ** 5)) == (1024 ** 2));;\n}\n\ntest \"t17\" {\n    assert (as_gb((1024 * 1024 * 1024 * 1024)) == 1024);;\n}\n\ntest \"t18\" {\n    assert (as_gb(3) == 0);;\n}\n\ntest \"t19\" {\n    assert (as_gb(42) == (42 // (1024 * 1024 * 1024)));;\n}\n\ntest \"t20\" {\n    assert (as_gb((1024 * 1024 * 1024)) == 1);;\n}\n\ntest \"t21\" {\n    assert (\n        as_gb((1024 * 1024 * 1024)) == ((1024 * 1024 * 1024) // (1024 * 1024 * 1024))\n    );;\n}\n\ntest \"t22\" {\n    assert (as_gb(10) == (10 // (1024 * 1024 * 1024)));;\n}\n\ntest \"t23\" {\n    assert (as_gb((1024 * 1024 * 1024 * 2)) == 2);;\n}"}