# --- caches & venvs ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# --- nested repos ---
jaseci/

# --- editor / agent scratch ---
.cursor/
.jac/
.pi-subagents/

# --- scratch & debug files ---
tmp_*.jac
_tmp_*.jac
tmp_*.json
_*.jac

# --- backups ---
*.bak
*.bak.*

# --- js2jac intermediates (per-run work dirs, candidate harvests) ---
scripts/js2jac_dataset/runs/**/work/
scripts/js2jac_dataset/runs/**/batches/
scripts/js2jac_dataset/source/runs/
scripts/js2jac_dataset/source/*harvest*.jsonl
scripts/js2jac_dataset/source/candidates.jsonl*
scripts/js2jac_dataset/source/shadcn_cands.jsonl

# --- large local-only artifacts (not part of this commit) ---
golden_client*.jsonl
low_resource_paper.pdf

# --- js2jac per-run pilot artifacts (data, not code) ---
scripts/js2jac_dataset/runs/**/pilot_batches/
scripts/js2jac_dataset/runs/**/pilot_candidates.jsonl
scripts/js2jac_dataset/runs/**/candidates.jsonl
scripts/js2jac_dataset/runs/**/pilot_guard.json
scripts/js2jac_dataset/runs/**/*.log
scripts/js2jac_dataset/runs/**/*.pid
