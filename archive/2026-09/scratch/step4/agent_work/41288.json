{"id": 41288, "entrypoint": "getList", "coverage": 100, "stage": "floor_pass", "python": "def getList(start,end):\n    \"\"\"\n    Strictly Ymd format no spaces or slashes\n    \"\"\"\n    \n    import datetime\n    \n    start = datetime.datetime.strptime(str(start),'%Y%m%d')\n    end = datetime.datetime.strptime(str(end),'%Y%m%d')\n    \n    dateList = [start + datetime.timedelta(days=x) for x in range(0, (end-start).days + 1)]\n    \n    sList = [datetime.datetime.strftime(x,'%Y%m%d') for x in dateList]\n    \n    return sList", "floor_fn": "\"\"\"\n    Strictly Ymd format no spaces or slashes\n    \"\"\"\ndef getList(start: Any, end: Any) -> object {\n    import datetime;\n    start = datetime.datetime.strptime(str(start), '%Y%m%d');\n    end = datetime.datetime.strptime(str(end), '%Y%m%d');\n    dateList = [\n        (start + datetime.timedelta(days=x)) for x in range(0, ((end - start).days + 1))\n    ];\n    sList = [datetime.datetime.strftime(x, '%Y%m%d') for x in dateList];\n    return sList;\n}", "test_blocks": "test \"t0\" {\n    assert (\n        getList(20200101, 20200120)\n        == [\n            '20200101',\n            '20200102',\n            '20200103',\n            '20200104',\n            '20200105',\n            '20200106',\n            '20200107',\n            '20200108',\n            '20200109',\n            '20200110',\n            '20200111',\n            '20200112',\n            '20200113',\n            '20200114',\n            '20200115',\n            '20200116',\n            '20200117',\n            '20200118',\n            '20200119',\n            '20200120'\n        ]\n    );;\n}\n\ntest \"t1\" {\n    assert (\n        getList(20150401, 20150405)\n        == ['20150401', '20150402', '20150403', '20150404', '20150405']\n    );;\n}\n\ntest \"t2\" {\n    assert (getList(20170228, 20170228) == ['20170228']);;\n}\n\ntest \"t3\" {\n    assert (\n        getList(20180301, 20180305)\n        == ['20180301', '20180302', '20180303', '20180304', '20180305']\n    );;\n}\n\ntest \"t4\" {\n    assert (getList(20160228, 20160301) == ['20160228', '20160229', '20160301']);;\n}\n\ntest \"t5\" {\n    assert (getList(20100402, 20100403) == ['20100402', '20100403']);;\n}\n\ntest \"t6\" {\n    assert (getList(20120101, 20120103) == ['20120101', '20120102', '20120103']);;\n}\n\ntest \"t7\" {\n    assert (\n        getList(20170101, 20170131)\n        == [\n            '20170101',\n            '20170102',\n            '20170103',\n            '20170104',\n            '20170105',\n            '20170106',\n            '20170107',\n            '20170108',\n            '20170109',\n            '20170110',\n            '20170111',\n            '20170112',\n            '20170113',\n            '20170114',\n            '20170115',\n            '20170116',\n            '20170117',\n            '20170118',\n            '20170119',\n            '20170120',\n            '20170121',\n            '20170122',\n            '20170123',\n            '20170124',\n            '20170125',\n            '20170126',\n            '20170127',\n            '20170128',\n            '20170129',\n            '20170130',\n            '20170131'\n        ]\n    );;\n}\n\ntest \"t8\" {\n    assert (getList(20150101, 20150101) == ['20150101']);;\n}\n\ntest \"t9\" {\n    assert (getList(20150101, 20150102) == ['20150101', '20150102']);;\n}\n\ntest \"t10\" {\n    assert (\n        getList(20161230, 20170102) == [\"20161230\", \"20161231\", \"20170101\", \"20170102\"]\n    );;\n}\n\ntest \"t11\" {\n    assert (\n        getList(20140501, 20140505)\n        == ['20140501', '20140502', '20140503', '20140504', '20140505']\n    );;\n}\n\ntest \"t12\" {\n    assert (\n        getList(20160101, 20160201)\n        == [\n            '20160101',\n            '20160102',\n            '20160103',\n            '20160104',\n            '20160105',\n            '20160106',\n            '20160107',\n            '20160108',\n            '20160109',\n            '20160110