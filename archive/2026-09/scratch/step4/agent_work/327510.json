{"id": 327510, "entrypoint": "invert_atomlist_coordinates", "coverage": 92, "stage": "floor_pass", "python": "def invert_atomlist_coordinates(atomst):\n  \"\"\"\n  Inverts atom coordinates\n  :param atoms: list of atom list\n  >>> c1 = [['c1', '1', '1', '-2', '3'], ['c1', 2, 1, -2, 3]]\n  >>> invert_atomlist_coordinates(c1)\n  [['c1', '1', -1.0, 2.0, -3.0], ['c1', 2, -1.0, 2.0, -3.0]]\n  \"\"\"\n  atoms = []\n  for line in atomst:\n    line = list(line)\n    try:\n      inv_coord = [-float(i) for i in line[2:]]\n    except:\n      print('Unable to invert fragment coordinates.')\n      return False\n    line[2:] = inv_coord\n    atoms.append(line)\n  return atoms", "floor_fn": "\"\"\"\n  Inverts atom coordinates\n  :param atoms: list of atom list\n  >>> c1 = [['c1', '1', '1', '-2', '3'], ['c1', 2, 1, -2, 3]]\n  >>> invert_atomlist_coordinates(c1)\n  [['c1', '1', -1.0, 2.0, -3.0], ['c1', 2, -1.0, 2.0, -3.0]]\n  \"\"\"\ndef invert_atomlist_coordinates(atomst: Any) -> object {\n    atoms = [];\n    for line in atomst {\n        line = `list(line);\n        try {\n            inv_coord = [-float(i) for i in line[2:]];\n        } except Exception as e {\n            print('Unable to invert fragment coordinates.');\n            return False;\n        }\n        line[2:] = inv_coord;\n        atoms.append(line);\n    }\n    return atoms;\n}", "test_blocks": "test \"t0\" {\n    assert (\n        invert_atomlist_coordinates([['c1', '1', '1', '2', '3'], ['c1', 2, 1, 2, 3]])\n        == [['c1', '1', -1.0, -2.0, -3.0], ['c1', 2, -1.0, -2.0, -3.0]]\n    );;\n}\n\ntest \"t1\" {\n    assert (\n        invert_atomlist_coordinates([['c1', '1', '1', '-2', '3'], ['c1', 2, 1, -2, 3]])\n        == [['c1', '1', -1.0, 2.0, -3.0], ['c1', 2, -1.0, 2.0, -3.0]]\n    );;\n}\n\ntest \"t2\" {\n    assert (\n        invert_atomlist_coordinates([['c1', 1, 1, '-2', '3']])\n        == [['c1', 1, -1.0, 2.0, -3.0]]\n    );;\n}\n\ntest \"t3\" {\n    assert (invert_atomlist_coordinates([]) == []);;\n}\n\ntest \"t4\" {\n    assert (\n        invert_atomlist_coordinates([['c1', 1, '1', '-2', '3']])\n        == [['c1', 1, -1.0, 2.0, -3.0]]\n    );;\n}\n\ntest \"t5\" {\n    assert (\n        invert_atomlist_coordinates([['c1', 1, 1, 2, 3], ['c1', 2, 1, 2, 3]])\n        == [['c1', 1, -1.0, -2.0, -3.0], ['c1', 2, -1.0, -2.0, -3.0]]\n    );;\n}\n\ntest \"t6\" {\n    assert (\n        invert_atomlist_coordinates(\n            [['c1', '1', '1', '-2', '3'], ['c1', 2, 1, -2, 3], ['c1', 3, 1, -2, 3]]\n        )\n        == [\n            ['c1', '1', -1.0, 2.0, -3.0],\n            ['c1', 2, -1.0, 2.0, -3.0],\n            ['c1', 3, -1.0, 2.0, -3.0]\n        ]\n    );;\n}\n\ntest \"t7\" {\n    assert (\n        invert_atomlist_coordinates([['c1', '1', '1', '-2', '3'], ['c1', 2, 1, -2, 3]])\n        == [['c1', '1', -1.0, 2.0, -3.0], ['c1', 2, -1.0, 2.0, -3.0]]\n    );;\n}\n\ntest \"t8\" {\n    assert (\n        invert_atomlist_coordinates(\n            [['c1', '1', '1', '-2', '3'], ['c1', 2, 1, -2, 3], ['c1', 3, 4, 5, 6]]\n        )\n        == [\n            ['c1', '1', -1.0, 2.0, -3.0],\n            ['c1', 2, -1.0, 2.0, -3.0],\n            ['c1', 3, -4.0, -5.0, -6.0]\n        ]\n    );;\n}\n\ntest \"t9\" {\n    assert (\n        invert_atomlist_coordinates(\n            [['c1', '1', '1', '2', '3'], ['c1', '2', '1', '2', '3']]\n        )\n        == [['c1', '1', -1.0, -2.0, -3.0], ['c1', '2', -1.0, -2.0, -3.0]]\n    );;\n}\n\ntest \"t10\" {\n    assert (\n        invert_atomlist_coordinates(\n            [\n                ['c1', 1, 1, -2, 3],\n                ['c1', 2, 1, -2, 3],\n                ['c1', 3, 1, -2, 3],\n                ['c1', 4, 1, -2, 3],\n                ['c1', 5, 1, -2, 3]\n            ]\n        )\n        == [\n            ['c1', 1, -1.0, 2.0, -3.0],\n            ['c1', 2, -1.0, 2.0, -3.0],\n            ['c1', 3, -1.0, 2.0, -3.0],\n            ['c1', 4, -1.0, 2.0, -3.0],\n            ['c1', 5, -1.0, 2.0, -3.0]\n        ]\n    );;\n}\n\ntest \"t11\" {\n    assert (\n        invert_atomlist_coordinates([['c1', 1, 1, 2, 3], ['c1', 2, 1, 2, 3]])\n        == [['c1', 1, -1.0, -2.0, -3.0], ['c1', 2, -1.0, -2.0, -3.0]]\n    );;\n}\n\ntest \"t12\" {\n    assert (\n        invert_atomlist_coordinates([['c1', '1', '1', '-2', '3'], ['c1', 2, 1, -2, 3]])\n        == [['c1', '1', -1.0, 2.0, -3.0], ['c1', 2, -1.0, 2.0, -3.0]]\n    );;\n}\n\ntest \"t13\" {\n    assert (\n        invert_atomlist_coordinates([['c1', '1', '1', '-2', '3']])\n        == [['c1', '1', -1.0, 2.0, -3.0]]\n    );;\n}\n\ntest \"t14\" {\n    assert (\n        invert_atomlist_coordinates([['c1', '1', '1', '-2', '3'], ['c1', 2, 1, -2, 3]])\n        == [['c1', '1', -1.0, 2.0, -3.0], ['c1', 2, -1.0, 2.0, -3.0]]\n    );;\n}\n\ntest \"t15\" {\n    assert (\n        invert_atomlist_coordinates([['c1', '1', 2, 3, 4], ['c1', '2', 3, 4, 5]])\n        == [['c1', '1', -2.0, -3.0, -4.0], ['c1', '2', -3.0, -4.0, -5.0]]\n    );;\n}\n\ntest \"t16\" {\n    assert (\n        invert_atomlist_coordinates([['c1', '1', 1.0, -2.0, 3.0], ['c1', 2, 1, -2, 3]])\n        == [['c1', '1', -1.0, 2.0, -3.0], ['c1', 2, -1.0, 2.0, -3.0]]\n    );;\n}\n\ntest \"t17\" {\n    assert (\n        invert_atomlist_coordinates([['c1', '1', '1', '2', '3'], ['c1', 2, 1, 2, 3]])\n        == [['c1', '1', -1.0, -2.0, -3.0], ['c1', 2, -1.0, -2.0, -3.0]]\n    );;\n}\n\ntest \"t18\" {\n    assert (\n        invert_atomlist_coordinates([['c1', '1', '1', '-2', '3'], ['c1', 2, 1, -2, 3]])\n        == [['c1', '1', -1.0, 2.0, -3.0], ['c1', 2, -1.0, 2.0, -3.0]]\n    );;\n}\n\ntest \"t19\" {\n    assert (\n        invert_atomlist_coordinates([['c1', '1', 1, -2, 3], ['c1', 2, 1, -2, 3]])\n        == [['c1', '1', -1.0, 2.0, -3.0], ['c1', 2, -1.0, 2.0, -3.0]]\n    );;\n}\n\ntest \"t20\" {\n    assert (\n        invert_atomlist_coordinates([['c1', 1, 1, 2, 3], ['c1', 2, 1, 2, 3]])\n        == [['c1', 1, -1.0, -2.0, -3.0], ['c1', 2, -1.0, -2.0, -3.0]]\n    );;\n}\n\ntest \"t21\" {\n    assert (\n        invert_atomlist_coordinates([['c1', '1', '1', '-2', '3'], ['c1', 2, 1, -2, 3]])\n        == [['c1', '1', -1.0, 2.0, -3.0], ['c1', 2, -1.0, 2.0, -3.0]]\n    );;\n}\n\ntest \"t22\" {\n    assert (\n        invert_atomlist_coordinates([['c1', '1', -1, 2, -3], ['c1', 2, 1, -2, 3]])\n        == [['c1', '1', 1.0, -2.0, 3.0], ['c1', 2, -1.0, 2.0, -3.0]]\n    );;\n}\n\ntest \"t23\" {\n    assert (\n        invert_atomlist_coordinates([['c1', 1, 1, -2, 3], ['c1', 2, 1, -2, 3]])\n        == [['c1', 1, -1.0, 2.0, -3.0], ['c1', 2, -1.0, 2.0, -3.0]]\n    );;\n}\n\ntest \"t24\" {\n    assert (\n        invert_atomlist_coordinates([['c1', 1, 1, -2, 3], ['c1', 2, 1, -2, 3]])\n        == [['c1', 1, -1.0, 2.0, -3.0], ['c1', 2, -1.0, 2.0, -3.0]]\n    );;\n}"}