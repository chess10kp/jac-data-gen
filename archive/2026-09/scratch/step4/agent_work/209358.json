{"id": 209358, "entrypoint": "process_gene_line", "coverage": 100, "stage": "floor_pass", "python": "def process_gene_line(gene_line):\n    \"\"\"Parse gene line.\"\"\"\n    # contain [gene_id]=[intersected_chain_id] blocks\n    # remove \"gene\" and \"\", get (gene. chain) tuples\n    # is not necessary really\n    data = [(x.split(\"=\")[1], x.split(\"=\")[0]) for x in gene_line[1:-1]]\n    chain = data[0][0]  # chain is equal everywhere\n    genes = [x[1] for x in data]\n    return chain, genes", "floor_fn": "\"\"\"Parse gene line.\"\"\"\ndef process_gene_line(gene_line: Any) -> object {\n    data = [(x.split(\"=\")[1], x.split(\"=\")[0]) for x in gene_line[1:-1]];\n    chain = data[0][0];\n    genes = [x[1] for x in data];\n    return (chain, genes);\n}", "test_blocks": "test \"t0\" {\n    assert (\n        process_gene_line([\"gene\", \"Gene1=4\", \"Gene2=1\", \"Gene3=1\", \"Gene4=1\", \"gene\"])\n        == (\"4\", [\"Gene1\", \"Gene2\", \"Gene3\", \"Gene4\"])\n    );;\n}\n\ntest \"t1\" {\n    assert (process_gene_line([\"gene\", \"Gene1=4\", \"gene\"]) == (\"4\", [\"Gene1\"]));;\n}\n\ntest \"t2\" {\n    assert (\n        process_gene_line(\n            [\"gene\", \"a=1\", \"b=2\", \"c=3\", \"d=4\", \"e=5\", \"f=6\", \"g=7\", \"gene\"]\n        )\n        == (\"1\", [\"a\", \"b\", \"c\", \"d\", \"e\", \"f\", \"g\"])\n    );;\n}\n\ntest \"t3\" {\n    assert (\n        process_gene_line(\n            [\n                'gene',\n                'ENSG00000162605=A',\n                'ENSG00000162605=B',\n                'ENSG00000162605=C',\n                'ENSG00000162605=D',\n                'ENSG00000162605=E',\n                'gene'\n            ]\n        )\n        == (\n            'A',\n            [\n                'ENSG00000162605',\n                'ENSG00000162605',\n                'ENSG00000162605',\n                'ENSG00000162605',\n                'ENSG00000162605'\n            ]\n        )\n    );;\n}\n\ntest \"t4\" {\n    assert (\n        process_gene_line(['gene', 'ENSG00000162605=A', 'ENSG00000162605=B', 'gene'])\n        == ('A', ['ENSG00000162605', 'ENSG00000162605'])\n    );;\n}\n\ntest \"t5\" {\n    assert (\n        process_gene_line([\"gene\", \"a=1\", \"b=2\", \"c=3\", \"d=4\", \"e=5\", \"f=6\", \"gene\"])\n        == (\"1\", [\"a\", \"b\", \"c\", \"d\", \"e\", \"f\"])\n    );;\n}"}