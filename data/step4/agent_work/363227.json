{"id": 363227, "entrypoint": "_unflatten_lists", "coverage": 100, "stage": "floor_pass", "python": "def _unflatten_lists(d: dict) -> dict:\n\t\"\"\"\n\tNote: modifies dict\n\n\tIn []: _unflatten_lists({'a': {'0': {'b': {'f': {'0': 1, '1': 2, '2': 3}}}, '1': {'c': 2}}, 'd': {'e': 1}})\n\tOut[]: {'a': [{'b': {'f': [1, 2, 3]}}, {'c': 2}], 'd': {'e': 1}}\n\t\"\"\"\n\n\tfor k, v in d.items():\n\t\ttry:\n\t\t\t# Following line's purpose is just to trigger an error when needed:\n\t\t\t# it only works if v is a dict whose keys are integer (all of them)\n\t\t\t[int(kk) for kk in v]\n\t\t\td[k] = [\n\t\t\t\t_unflatten_lists(d[k][kk]) if isinstance(d[k][kk], dict) else d[k][kk]\n\t\t\t\tfor kk in v\n\t\t\t]\n\t\texcept Exception:\n\t\t\tif isinstance(v, dict):\n\t\t\t\td[k] = _unflatten_lists(v)\n\n\treturn d", "floor_fn": "\"\"\"\n\tNote: modifies dict\n\n\tIn []: _unflatten_lists({'a': {'0': {'b': {'f': {'0': 1, '1': 2, '2': 3}}}, '1': {'c': 2}}, 'd': {'e': 1}})\n\tOut[]: {'a': [{'b': {'f': [1, 2, 3]}}, {'c': 2}], 'd': {'e': 1}}\n\t\"\"\"\ndef _unflatten_lists(d: dict) -> dict {\n    for (k, v) in d.items() {\n        try {\n            [int(kk) for kk in v];\n            d[k] = [\n                _unflatten_lists(d[k][kk]) if isinstance(d[k][kk], `dict) else d[k][kk]\n                for kk in v\n            ];\n        } except Exception {\n            if isinstance(v, `dict) {\n                d[k] = _unflatten_lists(v);\n            }\n        }\n    }\n    return d;\n}", "test_blocks": "test \"t0\" {\n    assert (_unflatten_lists({'a': {'b': 1, 'c': 2}}) == {'a': {'b': 1, 'c': 2}});;\n}\n\ntest \"t1\" {\n    assert (\n        _unflatten_lists(\n            {\n                'a': {'0': {'b': {'f': {'0': 1, '1': 2, '2': 3}}}, '1': {'c': 2}},\n                'd': {'e': 1}\n            }\n        )\n        == {'a': [{'b': {'f': [1, 2, 3]}}, {'c': 2}], 'd': {'e': 1}}\n    );;\n}\n\ntest \"t2\" {\n    assert (_unflatten_lists({'a': {'0': 'x', '1': 'y'}}) == {'a': ['x', 'y']});;\n}\n\ntest \"t3\" {\n    assert (_unflatten_lists({'a': {'0': 1, '1': 2}, 'b': 3}) == {'a': [1, 2], 'b': 3});;\n}\n\ntest \"t4\" {\n    assert (_unflatten_lists({'a': 1, 'b': {'c': 2}}) == {'a': 1, 'b': {'c': 2}});;\n}\n\ntest \"t5\" {\n    assert (\n        _unflatten_lists(\n            {\n                'a': {\n                    '0': {'b': {'f': {'0': 1, '1': 2, '2': 3}}},\n                    '1': {'c': 2},\n                    '2': {'b': {'f': {'0': 1, '1': 2, '2': 3}}},\n                    '3': {'c': 2}\n                },\n                'd': {'e': 1}\n            }\n        )\n        == {\n            'a': [{'b': {'f': [1, 2, 3]}}, {'c': 2}, {'b': {'f': [1, 2, 3]}}, {'c': 2}],\n            'd': {'e': 1}\n        }\n    );;\n}\n\ntest \"t6\" {\n    assert (_unflatten_lists({'a': {'0': [1, 2, 3], '1': 2}}) == {'a': [[1, 2, 3], 2]});;\n}\n\ntest \"t7\" {\n    assert (\n        _unflatten_lists(\n            {\n                'a': {'0': {'b': {'f': {'0': 1, '1': 2, '2': 3}}}, '1': {'c': 2}},\n                'd': {'e': 1}\n            }\n        )\n        == {'a': [{'b': {'f': [1, 2, 3]}}, {'c': 2}], 'd': {'e': 1}}\n    );;\n}\n\ntest \"t8\" {\n    assert (_unflatten_lists({'a': {'0': {}, '1': {}}}) == {'a': [{}, {}]});;\n}\n\ntest \"t9\" {\n    assert (_unflatten_lists({}) == {});;\n}\n\ntest \"t10\" {\n    assert (\n        _unflatten_lists({'a': {'0': {'b': 1}, '1': {'c': 2}}, 'd': {'e': 3}})\n        == {'a': [{'b': 1}, {'c': 2}], 'd': {'e': 3}}\n    );;\n}\n\ntest \"t11\" {\n    assert (\n        _unflatten_lists({'a': {'b': {'c': 1}, 'd': 2}})\n        == {'a': {'b': {'c': 1}, 'd': 2}}\n    );;\n}\n\ntest \"t12\" {\n    assert (\n        _unflatten_lists(\n            {\n                'a': {'0': {'b': {'f': {'0': 1, '1': 2, '2': 3}}}, '1': {'c': 2}},\n                'd': {'e': 1}\n            }\n        )\n        == {'a': [{'b': {'f': [1, 2, 3]}}, {'c': 2}], 'd': {'e': 1}}\n    );;\n}\n\ntest \"t13\" {\n    assert (\n        _unflatten_lists({'a': {'b': {'c': {'d': 1}}}, 'e': {'f': 2}})\n        == {'a': {'b': {'c': {'d': 1}}}, 'e': {'f': 2}}\n    );;\n}\n\ntest \"t14\" {\n    assert (_unflatten_lists({'a': 1, 'b': 2}) == {'a': 1, 'b': 2});;\n}\n\ntest \"t15\" {\n    assert (_unflatten_lists({'a': {'0': 1, '1': 2}}) == {'a': [1, 2]});;\n}\n\ntest \"t16\" {\n    assert (\n        _unflatten_lists({'a': {'b': {'c': {'d': 1}}}, 'e': 2})\n        == {'a': {'b': {'c': {'d': 1}}}, 'e': 2}\n    );;\n}\n\ntest \"t17\" {\n    assert (\n        _unflatten_lists(\n            {\n                'a': {'0': {'b': {'f': {'0': 1, '1': 2, '2': 3}}}, '1': {'c': 2}},\n                'd': {'e': 1}\n            }\n        )\n        == {'a': [{'b': {'f': [1, 2, 3]}}, {'c': 2}], 'd': {'e': 1}}\n    );;\n}\n\ntest \"t18\" {\n    assert (\n        _unflatten_lists(\n            {\n                'a': {'0': {'b': {'f': {'0': 1, '1': 2, '2': 3}}}, '1': {'c': 2}},\n                'd': {'e': 1}\n            }\n        )\n        == {'a': [{'b': {'f': [1, 2, 3]}}, {'c': 2}], 'd': {'e': 1}}\n    );;\n}\n\ntest \"t19\" {\n    assert (\n        _unflatten_lists(\n            {'a': {'0': {'b': {'f': {'0': 1, '1': 2, '2': 3}}}, '1': {'c': 2}}}\n        )\n        == {'a': [{'b': {'f': [1, 2, 3]}}, {'c': 2}]}\n    );;\n}\n\ntest \"t20\" {\n    assert (\n        _unflatten_lists(\n            {\n                'a': {'0': {'b': {'f': {'0': 1, '1': 2, '2': 3}}}, '1': {'c': 2}},\n                'd': {'e': 1}\n            }\n        )\n        == {'a': [{'b': {'f': [1, 2, 3]}}, {'c': 2}], 'd': {'e': 1}}\n    );;\n}"}