{"id": 444088, "entrypoint": "getYear", "coverage": 100, "stage": "floor_pass", "python": "def getYear(orig_date_arr):\n    \"\"\"\n    return an integer specifying the previous Year\n    \"\"\"\n    if orig_date_arr[1] == orig_date_arr[2] == 1:\n        return orig_date_arr[0] - 1\n    else:\n        return orig_date_arr[0]", "floor_fn": "\"\"\"\n    return an integer specifying the previous Year\n    \"\"\"\ndef getYear(orig_date_arr: Any) -> object {\n    if (orig_date_arr[1] == orig_date_arr[2] == 1) {\n        return (orig_date_arr[0] - 1);\n    } else {\n        return orig_date_arr[0];\n    }\n}", "test_blocks": "test \"t0\" {\n    assert (getYear([2024, 1, 1]) == 2023);;\n}\n\ntest \"t1\" {\n    assert (getYear((2016, 12, 31)) == 2016);;\n}\n\ntest \"t2\" {\n    assert (getYear((2016, 1, 1)) == 2015);;\n}\n\ntest \"t3\" {\n    assert (getYear([2012, 2, 29]) == 2012);;\n}\n\ntest \"t4\" {\n    assert (getYear((2015, 1, 1)) == 2014);;\n}\n\ntest \"t5\" {\n    assert (getYear([2012, 1, 1]) == 2011);;\n}\n\ntest \"t6\" {\n    assert (getYear([2022, 1, 1]) == 2021);;\n}\n\ntest \"t7\" {\n    assert (getYear([2012, 2, 1]) == 2012);;\n}\n\ntest \"t8\" {\n    assert (getYear([1999, 12, 31]) == 1999);;\n}\n\ntest \"t9\" {\n    assert (getYear([2027, 1, 1]) == 2026);;\n}\n\ntest \"t10\" {\n    assert (getYear([2000, 1, 1]) == 1999);;\n}\n\ntest \"t11\" {\n    assert (getYear([1985, 1, 1]) == 1984);;\n}\n\ntest \"t12\" {\n    assert (getYear([1999, 10, 1]) == 1999);;\n}\n\ntest \"t13\" {\n    assert (getYear([2010, 1, 2]) == 2010);;\n}\n\ntest \"t14\" {\n    assert (getYear([2026, 1, 1]) == 2025);;\n}\n\ntest \"t15\" {\n    assert (getYear([2025, 1, 1]) == 2024);;\n}\n\ntest \"t16\" {\n    assert (getYear([1988, 1, 1]) == 1987);;\n}\n\ntest \"t17\" {\n    assert (getYear([2023, 1, 1]) == 2022);;\n}\n\ntest \"t18\" {\n    assert (getYear([2000, 11, 1]) == 2000);;\n}\n\ntest \"t19\" {\n    assert (getYear([2001, 12, 1]) == 2001);;\n}\n\ntest \"t20\" {\n    assert (getYear([2010, 1, 1]) == 2009);;\n}"}