"""Mapping for html tags.

Maps tags to title case, so you can type html tags as ``<audio>``
or ``<AuDiO>`` or whichever way.
"""
def html[T](module: T, tag: str) -> tuple[T, str] | None {
    title = tag.title();
    if title in HTML_TAGS {
        if title in {"Map", "Object"} {
            title = f"{title}El";
        }
        return (module, title);
    }
}