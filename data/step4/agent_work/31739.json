{"id": 31739, "entrypoint": "hms2stringTime", "coverage": 100, "stage": "floor_pass", "python": "def hms2stringTime(h, m, s, precision=5):\n    \"\"\" Convert a sexagesimal time to a formatted string.\n\n    Parameters\n    ----------\n    hour, min, sec : int, float\n    precision : int\n\n    Returns\n    -------\n        String formatted HH:MM:SS.SSSSS\n\n    \"\"\"\n    if h < 0 or m < 0 or s < 0:\n        pm = '-'\n    else:\n        pm = '+'\n\n    formString = '%s%02d:%02d:%0' + str(precision + 3) + '.' + str(precision) + 'f'\n    return formString % (pm, abs(h), abs(m), abs(s))", "floor_fn": "\"\"\" Convert a sexagesimal time to a formatted string.\n\n    Parameters\n    ----------\n    hour, min, sec : int, float\n    precision : int\n\n    Returns\n    -------\n        String formatted HH:MM:SS.SSSSS\n\n    \"\"\"\ndef hms2stringTime(h: Any, m: Any, s: Any, precision: Any = 5) -> object {\n    if ((h < 0) or (m < 0) or (s < 0)) {\n        pm = '-';\n    } else {\n        pm = '+';\n    }\n    formString = '%s%02d:%02d:%0' + str((precision + 3)) + '.' + str(precision) + 'f';\n    return (formString % (pm, abs(h), abs(m), abs(s)));\n}", "test_blocks": "test \"t0\" {\n    assert (hms2stringTime(0, 0, -10) == '-00:00:10.00000');;\n}\n\ntest \"t1\" {\n    assert (hms2stringTime(0, 1, 1.234567) == '+00:01:01.23457');;\n}\n\ntest \"t2\" {\n    assert (hms2stringTime(0, 0, -1e-05) == '-00:00:00.00001');;\n}\n\ntest \"t3\" {\n    assert (hms2stringTime(1, 2, 3.456789, 10) == '+01:02:03.4567890000');;\n}\n\ntest \"t4\" {\n    assert (hms2stringTime(12, 1, 2) == '+12:01:02.00000');;\n}\n\ntest \"t5\" {\n    assert (hms2stringTime(12, 34, 56.7) == '+12:34:56.70000');;\n}\n\ntest \"t6\" {\n    assert (hms2stringTime(-1, -2, -3) == '-01:02:03.00000');;\n}\n\ntest \"t7\" {\n    assert (hms2stringTime(1, 2, 3.4) == '+01:02:03.40000');;\n}\n\ntest \"t8\" {\n    assert (hms2stringTime(0, 1, 0) == '+00:01:00.00000');;\n}\n\ntest \"t9\" {\n    assert (hms2stringTime(-3, -4, -5.6) == '-03:04:05.60000');;\n}\n\ntest \"t10\" {\n    assert (hms2stringTime(1, 2, 3.456) == '+01:02:03.45600');;\n}\n\ntest \"t11\" {\n    assert (hms2stringTime(0, 0, 0.444444, 2) == '+00:00:00.44');;\n}\n\ntest \"t12\" {\n    assert (hms2stringTime(13, 56, 23.33333) == '+13:56:23.33333');;\n}\n\ntest \"t13\" {\n    assert (hms2stringTime(1, 2, 3.14159265359) == '+01:02:03.14159');;\n}\n\ntest \"t14\" {\n    assert (hms2stringTime(-1, -2, -3.456789) == '-01:02:03.45679');;\n}\n\ntest \"t15\" {\n    assert (hms2stringTime(0, 0, -0.01) == '-00:00:00.01000');;\n}\n\ntest \"t16\" {\n    assert (hms2stringTime(5, -23, -45) == \"-05:23:45.00000\");;\n}\n\ntest \"t17\" {\n    assert (hms2stringTime(5, 23, 45) == \"+05:23:45.00000\");;\n}\n\ntest \"t18\" {\n    assert (hms2stringTime(1.0, 2.0, 3.0001) == '+01:02:03.00010');;\n}\n\ntest \"t19\" {\n    assert (hms2stringTime(0, 3, 1) == '+00:03:01.00000');;\n}\n\ntest \"t20\" {\n    assert (hms2stringTime(0, 1, 1) == '+00:01:01.00000');;\n}\n\ntest \"t21\" {\n    assert (hms2stringTime(0, 2, 0) == '+00:02:00.00000');;\n}\n\ntest \"t22\" {\n    assert (hms2stringTime(0, 1, 0) == '+00:01:00.00000');;\n}\n\ntest \"t23\" {\n    assert (hms2stringTime(12, 30, 0.123) == '+12:30:00.12300');;\n}\n\ntest \"t24\" {\n    assert (hms2stringTime(0, 0, -1) == '-00:00:01.00000');;\n}\n\ntest \"t25\" {\n    assert (hms2stringTime(-0, -0, -0) == '+00:00:00.00000');;\n}\n\ntest \"t26\" {\n    assert (hms2stringTime(1, 2, 3.45678) == '+01:02:03.45678');;\n}\n\ntest \"t27\" {\n    assert (hms2stringTime(0, 0, -1.5) == '-00:00:01.50000');;\n}\n\ntest \"t28\" {\n    assert (hms2stringTime(-3, -4, -5.6789) == '-03:04:05.67890');;\n}\n\ntest \"t29\" {\n    assert (hms2stringTime(1, 2, 3.456789) == '+01:02:03.45679');;\n}\n\ntest \"t30\" {\n    assert (hms2stringTime(0, 0, -0.001) == '-00:00:00.00100');;\n}\n\ntest \"t31\" {\n    assert (hms2stringTime(0, 0, 0.444444) == '+00:00:00.44444');;\n}\n\ntest \"t32\" {\n    assert (hms2stringTime(-12, -3