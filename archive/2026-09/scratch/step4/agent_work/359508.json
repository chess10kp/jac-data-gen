{"id": 359508, "entrypoint": "corrfac", "coverage": 100, "stage": "floor_pass", "python": "def corrfac(z, params):\n    \"\"\"\n    Correlation coefficient between galaxy distribution and velocity field, r(z).\n    \"\"\"\n    r_g = params['r_g'] #0.98\n    return r_g + 0.*z", "floor_fn": "\"\"\"\n    Correlation coefficient between galaxy distribution and velocity field, r(z).\n    \"\"\"\ndef corrfac(z: Any, params: Any) -> object {\n    r_g = params['r_g'];\n    return (r_g + (0.0 * z));\n}", "test_blocks": "test \"t0\" {\n    assert (corrfac(1, {'r_g': 0.98}) == 0.98);;\n}\n\ntest \"t1\" {\n    assert (corrfac(0, {'r_g': 0.98}) == 0.98);;\n}\n\ntest \"t2\" {\n    assert (corrfac(0.5, {'r_g': 0.98}) == 0.98);;\n}\n\ntest \"t3\" {\n    assert (corrfac(0.2, {'r_g': 0.82}) == 0.82);;\n}\n\ntest \"t4\" {\n    assert (corrfac(6, {'r_g': 0.98}) == 0.98);;\n}\n\ntest \"t5\" {\n    assert (corrfac(1.0, {'r_g': 1.0}) == 1.0);;\n}\n\ntest \"t6\" {\n    assert (corrfac(0.5, {'r_g': 0.99}) == 0.99);;\n}\n\ntest \"t7\" {\n    assert (corrfac(3, {'r_g': 0.98}) == 0.98);;\n}\n\ntest \"t8\" {\n    assert (corrfac(0.5, {'r_g': 0.85}) == 0.85);;\n}\n\ntest \"t9\" {\n    assert (corrfac(4, {'r_g': 0.98}) == 0.98);;\n}\n\ntest \"t10\" {\n    assert (corrfac(0.0, {'r_g': 0.98}) == 0.98);;\n}\n\ntest \"t11\" {\n    assert (corrfac(0.0, {'r_g': 0.7}) == 0.7);;\n}\n\ntest \"t12\" {\n    assert (corrfac(1.0, {'r_g': 0.98}) == 0.98);;\n}\n\ntest \"t13\" {\n    assert (corrfac(0.0, {'r_g': 1.0}) == 1.0);;\n}\n\ntest \"t14\" {\n    assert (corrfac(2, {'r_g': 0.98}) == 0.98);;\n}\n\ntest \"t15\" {\n    assert (corrfac(0.0, {'r_g': 0.98}) == 0.98);;\n}\n\ntest \"t16\" {\n    assert (corrfac(20.0, {'r_g': 0.98}) == 0.98);;\n}\n\ntest \"t17\" {\n    assert (corrfac(0.2, {'r_g': -0.1}) == -0.1);;\n}\n\ntest \"t18\" {\n    assert (corrfac(7, {'r_g': 0.98, 'r_s': 0.8}) == 0.98);;\n}\n\ntest \"t19\" {\n    assert (corrfac(1.0, {'r_g': 0.7}) == 0.7);;\n}\n\ntest \"t20\" {\n    assert (corrfac(1.0, {'r_g': 0.98}) == 0.98);;\n}\n\ntest \"t21\" {\n    assert (corrfac(5, {'r_g': 0.98}) == 0.98);;\n}\n\ntest \"t22\" {\n    assert (corrfac(1.0, {'r_g': 1.0}) == 1.0);;\n}\n\ntest \"t23\" {\n    assert (corrfac(10.0, {'r_g': 0.98}) == 0.98);;\n}\n\ntest \"t24\" {\n    assert (corrfac(1.0, {'r_g': 0.8}) == 0.8);;\n}\n\ntest \"t25\" {\n    assert (corrfac(0.2, {'r_g': 1.0}) == 1.0);;\n}\n\ntest \"t26\" {\n    assert (corrfac(1.0, {'r_g': 0.0}) == 0.0);;\n}\n\ntest \"t27\" {\n    assert (corrfac(0.0, {'r_g': 0.99}) == 0.99);;\n}\n\ntest \"t28\" {\n    assert (corrfac(50.0, {'r_g': 0.98}) == 0.98);;\n}\n\ntest \"t29\" {\n    assert (corrfac(10, {'r_g': 0.98}) == 0.98);;\n}\n\ntest \"t30\" {\n    assert (corrfac(1.0, {'r_g': 0.9}) == 0.9);;\n}\n\ntest \"t31\" {\n    assert (corrfac(2.0, {'r_g': 0.98}) == 0.98);;\n}\n\ntest \"t32\" {\n    assert (corrfac(1, {'r_g': 0.5}) == 0.5);;\n}\n\ntest \"t33\" {\n    assert (corrfac(1, {'r_g': 0.9}) == 0.9);;\n}\n\ntest \"t34\" {\n    assert (corrfac(0.2, {'r_g': 0.98}) == 0.98);;\n}\n\ntest \"t35\" {\n    assert (corrfac(0.2, {'r_g': 0.1}) == 0.1);;\n}\n\ntest \"t36\" {\n    assert (corrfac(1, {'r_g': 0.1}) == 0.1);;\n}"}