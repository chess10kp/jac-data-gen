"""Digest node — a generated weekly summary for the adult child.

Generated by digest_generator walker every Sunday. Contains
an AI-written summary of all activity, alerts, and action items.
"""

node Digest {
    has digest_id: str = "",
        period_start: str = "",
        period_end: str = "",
        generated_at: str = "",
        delivered_at: str = "",
        # Content sections (populated by digest_generator via by llm())
        executive_summary: str = "",
        new_documents: str = "",
        claims_activity: str = "",
        disputes_update: str = "",
        upcoming_deadlines: str = "",
        financial_summary: str = "",
        alerts_section: str = "",
        action_items: list[str] = [],   # items requiring adult child attention
        full_content: str = "",
        delivery_status: str = "PENDING"; # PENDING | SENT | FAILED
}
