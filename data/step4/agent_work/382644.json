{"id": 382644, "entrypoint": "filter_dict", "coverage": 100, "stage": "floor_pass", "python": "def filter_dict(dict, keywords):\n    \"\"\"\n    Returns only the keywords that are part of a dictionary\n\n    Parameters\n    ----------\n    dictionary : dict\n        Dictionary for filtering\n    keywords : list of str\n        Keywords that will be filtered\n\n    Returns\n    -------\n    keywords : list of str\n        List containing the keywords that are keys in dictionary\n    \"\"\"\n    return [key for key in keywords if key in dict]", "floor_fn": "\"\"\"\n    Returns only the keywords that are part of a dictionary\n\n    Parameters\n    ----------\n    dictionary : dict\n        Dictionary for filtering\n    keywords : list of str\n        Keywords that will be filtered\n\n    Returns\n    -------\n    keywords : list of str\n        List containing the keywords that are keys in dictionary\n    \"\"\"\ndef filter_dict(`dict: Any, keywords: Any) -> object {\n    return [\n        key\n        for key in keywords\n        if (key in `dict)\n    ];\n}", "test_blocks": "test \"t0\" {\n    assert (\n        filter_dict({\"a\": 1, \"b\": 2, \"c\": 3}, [\"a\", \"b\", \"c\", \"d\"]) == [\"a\", \"b\", \"c\"]\n    );;\n}\n\ntest \"t1\" {\n    assert (filter_dict({\"a\": 1, \"b\": 2, \"c\": 3}, [\"b\", \"c\"]) == [\"b\", \"c\"]);;\n}\n\ntest \"t2\" {\n    assert (filter_dict({'a': 1, 'b': 2, 'c': 3}, ['a']) == ['a']);;\n}\n\ntest \"t3\" {\n    assert (filter_dict({'a': 1, 'b': 2, 'c': 3}, ['a', 'b']) == ['a', 'b']);;\n}\n\ntest \"t4\" {\n    assert (filter_dict({'a': 1, 'b': 2}, []) == []);;\n}\n\ntest \"t5\" {\n    assert (\n        filter_dict(\n            {\"123\": \"123\", \"456\": \"456\", \"789\": \"789\"},\n            [\"123\", \"789\", \"012\", \"345\", \"678\", \"901\", \"234\", \"567\", \"890\"]\n        )\n        == [\"123\", \"789\"]\n    );;\n}\n\ntest \"t6\" {\n    assert (filter_dict({'a': 1, 'b': 2, 'c': 3}, ['c']) == ['c']);;\n}\n\ntest \"t7\" {\n    assert (filter_dict({'a': 1, 'b': 2}, ['c']) == []);;\n}\n\ntest \"t8\" {\n    assert (filter_dict({'a': 1, 'b': 2, 'c': 3}, []) == []);;\n}\n\ntest \"t9\" {\n    assert (filter_dict({'a': 1, 'b': 2, 'c': 3, 'd': 4}, ['a', 'b']) == ['a', 'b']);;\n}\n\ntest \"t10\" {\n    assert (filter_dict(`dict(), ['a', 'c']) == []);;\n}\n\ntest \"t11\" {\n    assert (filter_dict({\"a\": 1, \"b\": 2, \"c\": 3}, [\"a\", \"c\"]) == [\"a\", \"c\"]);;\n}\n\ntest \"t12\" {\n    assert (filter_dict({'a': 1, 'b': 2, 'c': 3, 'd': 4}, ['a', 'e']) == ['a']);;\n}\n\ntest \"t13\" {\n    assert (filter_dict({\"a\": 1, \"b\": 2, \"c\": 3}, [\"c\", \"b\", \"a\"]) == [\"c\", \"b\", \"a\"]);;\n}\n\ntest \"t14\" {\n    assert (filter_dict({'a': 1, 'b': 2, 'c': 3}, ['a', 'b', 'c']) == ['a', 'b', 'c']);;\n}\n\ntest \"t15\" {\n    assert (filter_dict(`dict(), [\"a\", \"b\", \"c\"]) == []);;\n}\n\ntest \"t16\" {\n    assert (filter_dict({'a': 1, 'b': 2, 'c': 3, 'd': 4}, []) == []);;\n}\n\ntest \"t17\" {\n    assert (\n        filter_dict({'a': 1, 'b': 2, 'c': 3, 'd': 4}, ['a', 'b', 'c', 'd', 'e'])\n        == ['a', 'b', 'c', 'd']\n    );;\n}\n\ntest \"t18\" {\n    assert (filter_dict({\"a\": 1, \"b\": 2, \"c\": 3}, [\"a\", \"c\", \"z\"]) == [\"a\", \"c\"]);;\n}\n\ntest \"t19\" {\n    assert (filter_dict({'a': 1, 'b': 2, 'c': 3}, ['b']) == ['b']);;\n}\n\ntest \"t20\" {\n    assert (filter_dict(`dict(), [\"a\"]) == `list());;\n}\n\ntest \"t21\" {\n    assert (filter_dict({\"a\": 1, \"b\": 2, \"c\": 3}, [\"c\", \"b\", \"a\"]) == [\"c\", \"b\", \"a\"]);;\n}\n\ntest \"t22\" {\n    assert (filter_dict({'a': 1, 'b': 2, 'c': 3}, ['d']) == []);;\n}\n\ntest \"t23\" {\n    assert (filter_dict({\"a\": 1, \"b\": 2, \"c\": 3}, []) == []);;\n}\n\ntest \"t24\" {\n    assert (filter_dict(`dict(), ['a']) == []);;\n}\n\ntest \"t25\" {\n    assert (filter_dict({'a': 1, 'b': 2}, ['a', 'c']) == ['a']);;\n}\n\ntest \"t26\" {\n    assert (filter_dict({}, ['a', 'c']) == []);;\n}\n\ntest \"t27\" {\n    assert (filter_dict({\"a\": 1, \"b\": 2, \"c\": 3}, [\"a\", \"b\", \"c\"]) == [\"a\", \"b\", \"c\"]);;\n}\n\ntest \"t28\" {\n    assert (filter_dict({'a': 1, 'b': 2}, ['c', 'd']) == []);;\n}\n\ntest \"t29\" {\n    assert (filter_dict({'a': 1, 'b': 2, 'c': 3}, ['b', 'c']) == ['b', 'c']);;\n}\n\ntest \"t30\" {\n    assert (filter_dict(`dict(), ['c']) == []);;\n}\n\ntest \"t31\" {\n    assert (\n        filter_dict({'a': 1, 'b': 2, 'c': 3}, ['a', 'b', 'c', 'd']) == ['a', 'b', 'c']\n    );;\n}\n\ntest \"t32\" {\n    assert (filter_dict({'a': 1, 'b': 2, 'c': 3}, ['a', 'd', 'b']) == ['a', 'b']);;\n}\n\ntest \"t33\" {\n    assert (\n        filter_dict({'a': 1, 'b': 2, 'c': 3, 'd': 4}, ['a', 'e', 'f', 'g']) == ['a']\n    );;\n}\n\ntest \"t34\" {\n    assert (filter_dict({'a': 1, 'b': 2}, ['b', 'c']) == ['b']);;\n}\n\ntest \"t35\" {\n    assert (\n        filter_dict(\n            {\"123\": \"123\", \"456\": \"456\", \"789\": \"789\"},\n            [\"456\", \"012\", \"345\", \"678\", \"901\", \"234\", \"567\", \"890\"]\n        )\n        == [\"456\"]\n    );;\n}\n\ntest \"t36\" {\n    assert (filter_dict({}, ['a', 'b', 'c']) == []);;\n}\n\ntest \"t37\" {\n    assert (filter_dict({}, \"a\") == []);;\n}\n\ntest \"t38\" {\n    assert (filter_dict({'a': 1, 'b': 2, 'c': 3}, ['a', 'c', 'd']) == ['a', 'c']);;\n}\n\ntest \"t39\" {\n    assert (filter_dict({'a': 1, 'b': 2, 'c': 3}, ['a', 'c']) == ['a', 'c']);;\n}\n\ntest \"t40\" {\n    assert (filter_dict(`dict(), `list()) == `list());;\n}\n\ntest \"t41\" {\n    assert (filter_dict({\"a\": 1, \"b\": 2, \"c\": 3}, []) == []);;\n}\n\ntest \"t42\" {\n    assert (filter_dict({'a': 1, 'b': 2, 'c': 3}, ['a', 'd']) == ['a']);;\n}\n\ntest \"t43\" {\n    assert (\n        filter_dict(\n            {\"123\": \"123\", \"456\": \"456\", \"789\": \"789\"},\n            [\"123\", \"456\", \"789\", \"012\", \"345\", \"678\", \"901\", \"234\", \"567\", \"890\"]\n        )\n        == [\"123\", \"456\", \"789\"]\n    );;\n}"}