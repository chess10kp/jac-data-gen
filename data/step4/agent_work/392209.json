{"id": 392209, "entrypoint": "_zerofix", "coverage": 100, "stage": "floor_pass", "python": "def _zerofix(x, string, precision=6):\n    \"\"\"\n    Try to fix non-zero tick labels formatted as ``'0'``.\n    \"\"\"\n    if string.rstrip('0').rstrip('.') == '0' and x != 0:\n        string = ('{:.%df}' % precision).format(x)\n    return string", "floor_fn": "\"\"\"\n    Try to fix non-zero tick labels formatted as ``'0'``.\n    \"\"\"\ndef _zerofix(x: Any, string: Any, precision: Any = 6) -> object {\n    if ((string.rstrip('0').rstrip('.') == '0') and (x != 0)) {\n        string = ('{:.%df}' % precision).format(x);\n    }\n    return string;\n}", "test_blocks": "test \"t0\" {\n    assert (_zerofix(0, '0.00') == '0.00');;\n}\n\ntest \"t1\" {\n    assert (_zerofix(0.0, '0') == '0');;\n}\n\ntest \"t2\" {\n    assert (_zerofix(1.123, '1.123') == '1.123');;\n}\n\ntest \"t3\" {\n    assert (_zerofix(1.1, '1.1') == '1.1');;\n}\n\ntest \"t4\" {\n    assert (_zerofix(1, '0.01') == '0.01');;\n}\n\ntest \"t5\" {\n    assert (_zerofix(0.0, '0.00000') == '0.00000');;\n}\n\ntest \"t6\" {\n    assert (_zerofix(1.0, '1.000000000001') == '1.000000000001');;\n}\n\ntest \"t7\" {\n    assert (_zerofix(1.0, '1.00000000001') == '1.00000000001');;\n}\n\ntest \"t8\" {\n    assert (_zerofix(0.0, '0') == '0');;\n}\n\ntest \"t9\" {\n    assert (_zerofix(1, '0.00001') == '0.00001');;\n}\n\ntest \"t10\" {\n    assert (_zerofix(1.1234, '1.1234') == '1.1234');;\n}\n\ntest \"t11\" {\n    assert (_zerofix(1.0, '1.0000001') == '1.0000001');;\n}\n\ntest \"t12\" {\n    assert (_zerofix(0, '1.') == '1.');;\n}\n\ntest \"t13\" {\n    assert (_zerofix(10.000000001, '0.000000') == '10.000000');;\n}\n\ntest \"t14\" {\n    assert (_zerofix(-12.3, '-12.3') == '-12.3');;\n}\n\ntest \"t15\" {\n    assert (_zerofix(1, '0.000000') == '1.000000');;\n}\n\ntest \"t16\" {\n    assert (_zerofix(1e-15, '1.1') == '1.1');;\n}\n\ntest \"t17\" {\n    assert (_zerofix(10, '10') == '10');;\n}\n\ntest \"t18\" {\n    assert (_zerofix(0, '1.00') == '1.00');;\n}\n\ntest \"t19\" {\n    assert (_zerofix(0.123, '0.123') == '0.123');;\n}\n\ntest \"t20\" {\n    assert (_zerofix(0, '0') == '0');;\n}\n\ntest \"t21\" {\n    assert (_zerofix(1.0, '0.000000') == '1.000000');;\n}\n\ntest \"t22\" {\n    assert (_zerofix(1.23456, \"0\") == \"0\");;\n}\n\ntest \"t23\" {\n    assert (_zerofix(0.1, '0.1') == '0.1');;\n}\n\ntest \"t24\" {\n    assert (_zerofix(1, '0.0001') == '0.0001');;\n}\n\ntest \"t25\" {\n    assert (_zerofix(0, '1.0000') == '1.0000');;\n}\n\ntest \"t26\" {\n    assert (_zerofix(0.0, '0.0') == '0.0');;\n}\n\ntest \"t27\" {\n    assert (_zerofix(0.001, '0.001') == '0.001');;\n}\n\ntest \"t28\" {\n    assert (_zerofix(0, '00') == '00');;\n}\n\ntest \"t29\" {\n    assert (_zerofix(0, '1') == '1');;\n}\n\ntest \"t30\" {\n    assert (_zerofix(1, '.1') == '.1');;\n}\n\ntest \"t31\" {\n    assert (_zerofix(0, '0.0') == '0.0');;\n}\n\ntest \"t32\" {\n    assert (_zerofix(1, '0.1') == '0.1');;\n}\n\ntest \"t33\" {\n    assert (_zerofix(1.0, '1.0') == '1.0');;\n}\n\ntest \"t34\" {\n    assert (_zerofix(0, '0.1') == '0.1');;\n}\n\ntest \"t35\" {\n    assert (_zerofix(123456.1, '123456.1') == '123456.1');;\n}\n\ntest \"t36\" {\n    assert (_zerofix(1.0, '1.0000000000001') == '1.0000000000001');;\n}\n\ntest \"t37\" {\n    assert (_zerofix(123456, \"0\") == \"0\");;\n}\n\ntest \"t38\" {\n    assert (_zerofix(1.0, '1.000000') == '1.000000');;\n}\n\ntest \"t39\" {\n    assert (_zerofix(0, '01') == '01');;\n}\n\ntest \"t40\" {\n    assert (_zerofix(1.1234567, '1.1234567') == '1.1234567');;\n}\n\ntest \"t41\" {\n    assert (_zerofix(1e-05, '0.00001') == '0.00001');;\n}\n\ntest \"t42\" {\n    assert (_zerofix(1, '0.001') == '0.001');;\n}\n\ntest \"t43\" {\n    assert (_zerofix(1.0, '1.00000001') == '1.00000001');;\n}\n\ntest \"t44\" {\n    assert (_zerofix(1, '1.0') == '1.0');;\n}\n\ntest \"t45\" {\n    assert (_zerofix(1.0, '1.00000000000001') == '1.00000000000001');;\n}\n\ntest \"t46\" {\n    assert (_zerofix(1, '1') == '1');;\n}\n\ntest \"t47\" {\n    assert (_zerofix(0.0001, '0.0001') == '0.0001');;\n}\n\ntest \"t48\" {\n    assert (_zerofix(1.12, '1.12') == '1.12');;\n}\n\ntest \"t49\" {\n    assert (_zerofix(-1, '-1') == '-1');;\n}\n\ntest \"t50\" {\n    assert (_zerofix(1.23456, \"1.23456\") == \"1.23456\");;\n}\n\ntest \"t51\" {\n    assert (_zerofix(1.12345, '1.12345') == '1.12345');;\n}\n\ntest \"t52\" {\n    assert (_zerofix(0, '000000.000000') == '000000.000000');;\n}\n\ntest \"t53\" {\n    assert (_zerofix(1e-07, '0.0000001') == '0.0000001');;\n}\n\ntest \"t54\" {\n    assert (_zerofix(0, '10') == '10');;\n}\n\ntest \"t55\" {\n    assert (_zerofix(0.1, '0.000000') == '0.100000');;\n}\n\ntest \"t56\" {\n    assert (_zerofix(1.123456, '1.123456') == '1.123456');;\n}\n\ntest \"t57\" {\n    assert (_zerofix(0, '0.000001') == '0.000001');;\n}\n\ntest \"t58\" {\n    assert (_zerofix(0.0, '0.000000') == '0.000000');;\n}\n\ntest \"t59\" {\n    assert (_zerofix(1, '1.') == '1.');;\n}\n\ntest \"t60\" {\n    assert (_zerofix(1.0, '1.0000000001') == '1.0000000001');;\n}\n\ntest \"t61\" {\n    assert (_zerofix(-1e-07, '-0.0000001') == '-0.0000001');;\n}\n\ntest \"t62\" {\n    assert (_zerofix(0, '0.000000') == '0.000000');;\n}\n\ntest \"t63\" {\n    assert (_zerofix(1.000000001, '0.000000') == '1.000000');;\n}\n\ntest \"t64\" {\n    assert (_zerofix(10000000000.0, '10000000000') == '10000000000');;\n}\n\ntest \"t65\" {\n    assert (_zerofix(1.0, '1') == '1');;\n}\n\ntest \"t66\" {\n    assert (_zerofix(0, '1.0') == '1.0');;\n}\n\ntest \"t67\" {\n    assert (_zerofix(-1.0, '-1') == '-1');;\n}\n\ntest \"t68\" {\n    assert (_zerofix(1.23456, \"0000000\") == \"0000000\");;\n}\n\ntest \"t69\" {\n    assert (_zerofix(1e-15, '1.10') == '1.10');;\n}\n\ntest \"t70\" {\n    assert (_zerofix(0.0, '000000.0') == '000000.0');;\n}\n\ntest \"t71\" {\n    assert (_zerofix(123456, \"123456\") == \"123456\");;\n}\n\ntest \"t72\" {\n    assert (_zerofix(123456.1, '123000') == '123000');;\n}\n\ntest \"t73\" {\n    assert (_zerofix(1e-09, '0.000000') == '0.000000');;\n}\n\ntest \"t74\" {\n    assert (_zerofix(1e-07, '0') == '0');;\n}\n\ntest \"t75\" {\n    assert (_zerofix(1, '1.1') == '1.1');;\n}\n\ntest \"t76\" {\n    assert (_zerofix(0.0, '0.00') == '0.00');;\n}\n\ntest \"t77\" {\n    assert (_zerofix(1, '01') == '01');;\n}\n\ntest \"t78\" {\n    assert (_zerofix(123456, \"0000000\") == \"0000000\");;\n}\n\ntest \"t79\" {\n    assert (_zerofix(0.00123, '0.00123') == '0.00123');;\n}\n\ntest \"t80\" {\n    assert (_zerofix(1.0, '0') == '0');;\n}\n\ntest \"t81\" {\n    assert (_zerofix(0, '0.') == '0.');;\n}\n\ntest \"t82\" {\n    assert (_zerofix(0, '1.00000') == '1.00000');;\n}\n\ntest \"t83\" {\n    assert (_zerofix(1.23e-05, '0.0000123') == '0.0000123');;\n}\n\ntest \"t84\" {\n    assert (_zerofix(12.3, '12.3') == '12.3');;\n}\n\ntest \"t85\" {\n    assert (_zerofix(-0.123456789, '-0.123456789') == '-0.123456789');;\n}\n\ntest \"t86\" {\n    assert (_zerofix(1, '1.000001') == '1.000001');;\n}\n\ntest \"t87\" {\n    assert (_zerofix(1e-13, '1e-12') == '1e-12');;\n}\n\ntest \"t88\" {\n    assert (_zerofix(1, '1.000000') == '1.000000');;\n}\n\ntest \"t89\" {\n    assert (_zerofix(0.0, '0.0000') == '0.0000');;\n}\n\ntest \"t90\" {\n    assert (_zerofix(0, '0.00000') == '0.00000');;\n}\n\ntest \"t91\" {\n    assert (_zerofix(0, '1.000') == '1.000');;\n}\n\ntest \"t92\" {\n    assert (_zerofix(0.0, '000000.000000') == '000000.000000');;\n}\n\ntest \"t93\" {\n    assert (_zerofix(0.0, '000000') == '000000');;\n}\n\ntest \"t94\" {\n    assert (_zerofix(1.23e-12, '0') == '0');;\n}\n\ntest \"t95\" {\n    assert (_zerofix(0.123456789, '0.123456789') == '0.123456789');;\n}\n\ntest \"t96\" {\n    assert (_zerofix(0, '0.000') == '0.000');;\n}\n\ntest \"t97\" {\n    assert (_zerofix(-0.1, '-0.1') == '-0.1');;\n}\n\ntest \"t98\" {\n    assert (_zerofix(-1.23456, \"0\") == \"0\");;\n}\n\ntest \"t99\" {\n    assert (_zerofix(0.01, '0.01') == '0.01');;\n}\n\ntest