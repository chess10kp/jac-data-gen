{
 "timeout_s": 300,
 "start": {
  "entry": "app.jac",
  "requests": [
   {
    "path": "/function/add_sailing",
    "json": {
     "code": "PRB",
     "day": 9,
     "car_slots": 2,
     "foot_slots": 3
    },
    "expect": [
     "PRB"
    ]
   },
   {
    "path": "/walker/book",
    "json": {
     "sailing": "PRB",
     "ref": "probe-1",
     "vehicle": "VAN",
     "passengers": 2
    },
    "expect": [
     "\"ok\": true",
     "probe-1"
    ]
   },
   {
    "path": "/walker/book",
    "json": {
     "sailing": "PRB",
     "ref": "probe-2",
     "vehicle": "CAR",
     "passengers": 1
    },
    "expect": [
     "sold out"
    ]
   },
   {
    "path": "/walker/day_summary",
    "json": {
     "day": 9
    },
    "expect": [
     "\"free_car\": 0",
     "\"free_foot\": 3"
    ]
   }
  ]
 }
}
