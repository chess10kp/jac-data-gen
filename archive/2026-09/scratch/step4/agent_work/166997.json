{"id": 166997, "entrypoint": "residual", "coverage": 100, "stage": "floor_pass", "python": "def residual(qdot, q):\n    \"\"\"\n    Residual of the ODE\n    \"\"\"\n    return qdot - 9.8 + 0.196*q", "floor_fn": "\"\"\"\n    Residual of the ODE\n    \"\"\"\ndef residual(qdot: Any, q: Any) -> object {\n    return ((qdot - 9.8) + (0.196 * q));\n}", "test_blocks": "test \"t0\" {\n    assert (residual(1, 0) == ((1.0 - 9.8) + (0.196 * 0)));;\n}\n\ntest \"t1\" {\n    assert (residual(1, 1) == ((1.0 - 9.8) + (0.196 * 1)));;\n}\n\ntest \"t2\" {\n    assert (residual(100, 100) == ((100 - 9.8) + (0.196 * 100)));;\n}\n\ntest \"t3\" {\n    assert (residual(0, 0) == -9.8);;\n}\n\ntest \"t4\" {\n    assert (residual(1000.0, 0.0) == (1000.0 - 9.8));;\n}\n\ntest \"t5\" {\n    assert (residual(3, 4) == ((3 - 9.8) + (0.196 * 4)));;\n}"}