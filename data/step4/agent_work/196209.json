{"id": 196209, "entrypoint": "pluck", "coverage": 100, "stage": "floor_pass", "python": "def pluck(input_dictionary):\n    \"\"\"Destructures a dictionary (vaguely like ES6 for JS)\n       Results are SORTED by key alphabetically! You must sort your receiving vars\n    \"\"\"\n    items = sorted(input_dictionary.items())\n    return [item[1] for item in items]", "floor_fn": "\"\"\"Destructures a dictionary (vaguely like ES6 for JS)\n       Results are SORTED by key alphabetically! You must sort your receiving vars\n    \"\"\"\ndef pluck(input_dictionary: Any) -> object {\n    items = sorted(input_dictionary.items());\n    return [item[1] for item in items];\n}", "test_blocks": "test \"t0\" {\n    assert (pluck(`dict((i, (i ** 2)) for i in [1, 2, 3])) == [1, 4, 9]);;\n}\n\ntest \"t1\" {\n    assert (pluck({'a': {'a': 1}, 'b': {'b': 2}}) == [{'a': 1}, {'b': 2}]);;\n}\n\ntest \"t2\" {\n    assert (\n        pluck({\"C\": 3, \"D\": 4, \"E\": 5, \"F\": 6, \"G\": 7, \"H\": 8, \"I\": 9})\n        == [3, 4, 5, 6, 7, 8, 9]\n    );;\n}\n\ntest \"t3\" {\n    assert (pluck({\"c\": 3, \"b\": 2, \"a\": 1, \"d\": 4}) == [1, 2, 3, 4]);;\n}\n\ntest \"t4\" {\n    assert (pluck({\"C\": 3, \"D\": 4, \"E\": 5, \"F\": 6, \"G\": 7}) == [3, 4, 5, 6, 7]);;\n}\n\ntest \"t5\" {\n    assert (pluck({'a': ['a'], 'b': {'b': 2}}) == [['a'], {'b': 2}]);;\n}\n\ntest \"t6\" {\n    assert (pluck({'a': ['a'], 'b': ['b']}) == [['a'], ['b']]);;\n}\n\ntest \"t7\" {\n    assert (pluck({'a': 1, 'b': 2, 'c': 3}) == [1, 2, 3]);;\n}\n\ntest \"t8\" {\n    assert (pluck(`dict()) == []);;\n}\n\ntest \"t9\" {\n    assert (pluck({}) == []);;\n}\n\ntest \"t10\" {\n    assert (pluck({\"A\": 1, \"B\": 2, \"C\": 3, \"D\": 4, \"E\": 5}) == [1, 2, 3, 4, 5]);;\n}\n\ntest \"t11\" {\n    assert (pluck({\"c\": 3, \"b\": 2, \"a\": 1}) == [1, 2, 3]);;\n}\n\ntest \"t12\" {\n    assert (pluck({\"a\": 1, \"b\": 2, \"c\": 3}) == [1, 2, 3]);;\n}\n\ntest \"t13\" {\n    assert (pluck({'a': {'a': 1}, 'b': ['b']}) == [{'a': 1}, ['b']]);;\n}\n\ntest \"t14\" {\n    assert (pluck({1: 'a', 2: 1.0, 3: True, 4: None}) == ['a', 1.0, True, None]);;\n}\n\ntest \"t15\" {\n    assert (pluck({\"a\": 1, \"b\": 2, \"c\": 3, \"d\": 4}) == [1, 2, 3, 4]);;\n}"}