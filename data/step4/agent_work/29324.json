{"id": 29324, "entrypoint": "search_trie", "coverage": 96, "stage": "floor_pass", "python": "def search_trie(trie, token, token_i=0):\n    \"\"\"\n    Search the given character-trie for paths that match the `token` string.\n    \"\"\"\n    if \"*\" in trie:\n        return trie[\"*\"]\n    if \"$\" in trie and token_i == len(token):\n        return trie[\"$\"]\n    if token_i < len(token):\n        char = token[token_i]\n        if char in trie:\n            return search_trie(trie[char], token, token_i + 1)\n    return []", "floor_fn": "\"\"\"\n    Search the given character-trie for paths that match the `token` string.\n    \"\"\"\ndef search_trie(trie: Any, token: Any, token_i: Any = 0) -> object {\n    if (\"*\" in trie) {\n        return trie[\"*\"];\n    }\n    if ((\"$\" in trie) and (token_i == len(token))) {\n        return trie[\"$\"];\n    }\n    if (token_i < len(token)) {\n        char = token[token_i];\n        if (char in trie) {\n            return search_trie(trie[char], token, (token_i + 1));\n        }\n    }\n    return [];\n}", "test_blocks": "test \"t0\" {\n    assert (search_trie({\"x\": {\"*\": [1]}}, \"y\") == []);;\n}\n\ntest \"t1\" {\n    assert (search_trie({\"x\": {\"*\": [1]}}, \"x\") == [1]);;\n}\n\ntest \"t2\" {\n    assert (\n        search_trie(\n            {\"*\": [], \"$\": [], \"a\": {\"*\": [], \"$\": [], \"b\": {\"*\": [], \"$\": []}}},\n            \"aabbbb\"\n        )\n        == []\n    );;\n}\n\ntest \"t3\" {\n    assert (\n        search_trie(\n            {\"*\": [], \"$\": [], \"a\": {\"*\": [], \"$\": [], \"b\": {\"*\": [], \"$\": []}}}, \"aab\"\n        )\n        == []\n    );;\n}\n\ntest \"t4\" {\n    assert (\n        search_trie({\"x\": {\"y\": {\"*\": [1]}, \"z\": {\"*\": [2]}, \"*\": [3]}}, \"x\") == [3]\n    );;\n}\n\ntest \"t5\" {\n    assert (\n        search_trie({\"x\": {\"y\": {\"*\": [1]}, \"z\": {\"*\": [2]}, \"*\": [3]}}, \"q\") == []\n    );;\n}\n\ntest \"t6\" {\n    assert (\n        search_trie(\n            {\"*\": [], \"$\": [], \"a\": {\"*\": [], \"$\": [], \"b\": {\"*\": [], \"$\": []}}}, \"ab\"\n        )\n        == []\n    );;\n}\n\ntest \"t7\" {\n    assert (\n        search_trie(\n            {\"*\": [], \"$\": [], \"a\": {\"*\": [], \"$\": [], \"b\": {\"*\": [], \"$\": []}}}, \"aaab\"\n        )\n        == []\n    );;\n}\n\ntest \"t8\" {\n    assert (\n        search_trie(\n            {\"*\": [], \"$\": [], \"a\": {\"*\": [], \"$\": [], \"b\": {\"*\": [], \"$\": []}}}, \"abbb\"\n        )\n        == []\n    );;\n}\n\ntest \"t9\" {\n    assert (\n        search_trie(\n            {\"*\": [], \"$\": [], \"a\": {\"*\": [], \"$\": [], \"b\": {\"*\": [], \"$\": []}}},\n            \"aaabbbb\"\n        )\n        == []\n    );;\n}\n\ntest \"t10\" {\n    assert (\n        search_trie(\n            {\"*\": [], \"$\": [], \"a\": {\"*\": [], \"$\": [], \"b\": {\"*\": [], \"$\": []}}},\n            \"aaabbb\"\n        )\n        == []\n    );;\n}\n\ntest \"t11\" {\n    assert (search_trie({\"a\": {\"b\": {\"c\": {\"d\": {\"$\": 1}}}}}, \"a\") == []);;\n}\n\ntest \"t12\" {\n    assert (search_trie({\"$\": [\"a\", \"b\"]}, \"a\") == []);;\n}\n\ntest \"t13\" {\n    assert (search_trie({\"*\": [\"foo\"], \"b\": {\"a\": [\"bar\"]}}, \"bar\", 1) == [\"foo\"]);;\n}\n\ntest \"t14\" {\n    assert (search_trie({\"x\": {\"*\": [1]}}, \"\") == []);;\n}\n\ntest \"t15\" {\n    assert (\n        search_trie(\n            {\n                \"A\": {\"B\": {\"*\": {\"$\": \"123\"}, \"D\": {\"$\": \"456\"}}},\n                \"C\": {\"*\": {\"$\": \"789\"}}\n            },\n            \"AXD\"\n        )\n        == []\n    );;\n}\n\ntest \"t16\" {\n    assert (\n        search_trie(\n            {\"*\": [], \"$\": [], \"a\": {\"*\": [], \"$\": [], \"b\": {\"*\": [], \"$\": []}}},\n            \"aabbb\"\n        )\n        == []\n    );;\n}\n\ntest \"t17\" {\n    assert (search_trie({\"*\": [], \"$\": [], \"a\": {\"*\": [], \"$\": []}}, \"aaaaaaa\") == []);;\n}"}