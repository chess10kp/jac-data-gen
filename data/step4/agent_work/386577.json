{"id": 386577, "entrypoint": "get_recursively", "coverage": 99, "stage": "floor_pass", "python": "def get_recursively(search_dict, field, no_field_recursive=False):\n    \"\"\"\n    Takes a dict with nested lists and dicts,\n    and searches all dicts for a key of the field\n    provided.\n    \"\"\"\n    fields_found = []\n\n    for key, value in search_dict.items():\n\n        if key == field:\n\n            if no_field_recursive \\\n                    and (isinstance(value, dict) or isinstance(key, list)):\n                continue\n\n            fields_found.append(value)\n\n        elif isinstance(value, dict):\n            results = get_recursively(value, field, no_field_recursive)\n            for result in results:\n                fields_found.append(result)\n\n        elif isinstance(value, list):\n            for item in value:\n                if isinstance(item, dict):\n                    more_results = get_recursively(item, field, no_field_recursive)\n                    for another_result in more_results:\n                        fields_found.append(another_result)\n\n    return fields_found", "floor_fn": "\"\"\"\n    Takes a dict with nested lists and dicts,\n    and searches all dicts for a key of the field\n    provided.\n    \"\"\"\ndef get_recursively(\n    search_dict: Any, field: Any, no_field_recursive: Any = False\n) -> object {\n    fields_found = [];\n    for (key, value) in search_dict.items() {\n        if (key == field) {\n            if (\n                no_field_recursive\n                and (isinstance(value, `dict) or isinstance(key, `list))\n            ) {\n                continue;\n            }\n            fields_found.append(value);\n        } elif isinstance(value, `dict) {\n            results = get_recursively(value, field, no_field_recursive);\n            for result in results {\n                fields_found.append(result);\n            }\n        } elif isinstance(value, `list) {\n            for item in value {\n                if isinstance(item, `dict) {\n                    more_results = get_recursively(item, field, no_field_recursive);\n                    for another_result in more_results {\n                        fields_found.append(another_result);\n                    }\n                }\n            }\n        }\n    }\n    return fields_found;\n}", "test_blocks": "test \"t0\" {\n    assert (\n        get_recursively(\n            {\n                'a': 1,\n                'b': 2,\n                'c': {\n                    'c1': 3,\n                    'c2': 4,\n                    'c3': [{'c31': 5, 'c32': 6}, {'c31': 7, 'c32': 8}]\n                }\n            },\n            'c31'\n        )\n        == [5, 7]\n    );;\n}\n\ntest \"t1\" {\n    assert (get_recursively(`dict(), 'a') == []);;\n}\n\ntest \"t2\" {\n    assert (get_recursively({'a': [{'b': 'c'}, 'd']}, 'b') == ['c']);;\n}\n\ntest \"t3\" {\n    assert (\n        get_recursively(\n            {'first': 1, 'second': {'a': 5, 'b': 6}, 'third': [7, 8]}, 'second'\n        )\n        == [{'a': 5, 'b': 6}]\n    );;\n}\n\ntest \"t4\" {\n    assert (\n        get_recursively(\n            {'a': [1, 2], 'b': 3, 'c': {'d': 4, 'e': {'f': 5, 'g': 6}}}, 'f'\n        )\n        == [5]\n    );;\n}\n\ntest \"t5\" {\n    assert (\n        get_recursively(\n            {\n                'a': 1,\n                'b': 2,\n                'c': 3,\n                'd': {'d_1': 4, 'd_2': 5, 'd_3': {'d_3_1': 7, 'd_3_2': 8}},\n                'e': 6\n            },\n            'd_2'\n        )\n        == [5]\n    );;\n}\n\ntest \"t6\" {\n    assert (get_recursively({'a': 1, 'b': {'c': 2, 'd': 3}, 'e': 4}, 'c') == [2]);;\n}\n\ntest \"t7\" {\n    assert (\n        get_recursively({'a': 1, 'b': [{'c': 2, 'd': 3}, {'e': 4}], 'f': 5}, 'd') == [3]\n    );;\n}\n\ntest \"t8\" {\n    assert (\n        get_recursively(\n            {\n                'a': 1,\n                'b': 2,\n                'c': 3,\n                'd': {'d_1': 4, 'd_2': 5, 'd_3': {'d_3_1': 7, 'd_3_2': 8}},\n                'e': 6\n            },\n            'd'\n        )\n        == [{'d_1': 4, 'd_2': 5, 'd_3': {'d_3_1': 7, 'd_3_2': 8}}]\n    );;\n}\n\ntest \"t9\" {\n    assert (\n        get_recursively(\n            {'a': 1, 'b': 2, 'c': 3, 'd': {'e': 4, 'f': [{'g': 5}, {'h': 6}]}}, 'i'\n        )\n        == []\n    );;\n}\n\ntest \"t10\" {\n    assert (\n        get_recursively(\n            {'a': 5, 'b': 6, 'c': 7, 'd': 8, 'e': 9, 'f': 10, 'g': 11, 'h': 12}, 'b'\n        )\n        == [6]\n    );;\n}\n\ntest \"t11\" {\n    assert (\n        get_recursively({'a': 1, 'b': 2, 'c': 3, 'd': {'e': 4, 'f': {'g': 5}}}, 'h')\n        == []\n    );;\n}\n\ntest \"t12\" {\n    assert (\n        get_recursively({'a': 1, 'b': 2, 'c': 3, 'd': {'e': 4, 'f': {'g': 5}}}, 'g')\n        == [5]\n    );;\n}\n\ntest \"t13\" {\n    assert (\n        get_recursively(\n            {'a': 5, 'b': 6, 'c': 7, 'd': 8, 'e': 9, 'f': 10, 'g': 11, 'h': 12}, 'd'\n        )\n        == [8]\n    );;\n}\n\ntest \"t14\" {\n    assert (\n        get_recursively(\n            {'first': 1, 'second': {'a': 5, 'b': 6}, 'third': [7, 8]}, 'third'\n        )\n        == [[7, 8]]\n    );;\n}\n\ntest \"t15\" {\n    assert (\n        get_recursively({\"a\": 1, \"b\": [2, 3], \"c\": {\"d\": 4, \"e\": [5, 6]}}, \"d\") == [4]\n    );;\n}\n\ntest \"t16\" {\n    assert (get_recursively({'a': 1, 'b': {'c': 2, 'd': 3}, 'e': 4}, 'e') == [4]);;\n}\n\ntest \"t17\" {\n    assert (\n        get_recursively({'a': {'b': 1, 'c': 2}, 'd': {'b': 3, 'e': 4}}, 'b', False)\n        == [1, 3]\n    );;\n}\n\ntest \"t18\" {\n    assert (\n        get_recursively(\n            {'key1': 'value1', 'key2': {'nested': {'deep': 'value2'}}}, 'key2'\n        )\n        == [{'nested': {'deep': 'value2'}}]\n    );;\n}\n\ntest \"t19\" {\n    assert (get_recursively({'a': {'b': 'c'}}, 'a') == [{'b': 'c'}]);;\n}\n\ntest \"t20\" {\n    assert (\n        get_recursively(\n            {'key1': 'value1', 'key2': {'nested': ['value1', 'value2']}}, 'key2'\n        )\n        == [{'nested': ['value1', 'value2']}]\n    );;\n}\n\ntest \"t21\" {\n    assert (\n        get_recursively(\n            {'a': [1, 2], 'b': 3, 'c': {'d': 4, 'e': {'f': 5, 'g': 6}}}, 'b'\n        )\n        == [3]\n    );;\n}\n\ntest \"t22\" {\n    assert (\n        get_recursively(\n            {\n                \"key\": \"value\",\n                \"list\": [{\"dict\": {\"key\": \"value\", \"list\": [{\"key\": \"value\"}]}}]\n            },\n            \"key\"\n        )\n        == [\"value\", \"value\", \"value\"]\n    );;\n}\n\ntest \"t23\" {\n    assert (get_recursively({'a': [1, 2, 3], 'b': 4, 'c': [5, 6, 7]}, 'b') == [4]);;\n}\n\ntest \"t24\" {\n    assert (\n        get_recursively({'a': {'b': 1, 'c': 2}, 'd': {'b': 3, 'e': 4}}, 'b') == [1, 3]\n    );;\n}\n\ntest \"t25\" {\n    assert (\n        get_recursively(\n            {'a': [1, 2], 'b': 3, 'c': {'d': 4, 'e': {'f': 5, 'g': 6}}}, 'd'\n        )\n        == [4]\n    );;\n}\n\ntest \"t26\" {\n    assert (\n        get_recursively(\n            {\n                'a': 1,\n                'b': 2,\n                'c': {'a': 1, 'b': 2, 'c': [1, 2, {'a': 1, 'b': 2}]},\n                'd': [1, 2, {'a': 1, 'b': 2}]\n            },\n            'b'\n        )\n        == [2, 2, 2, 2]\n    );;\n}\n\ntest \"t27\" {\n    assert (\n        get_recursively(\n            {\n                'a': 1,\n                'b': 2,\n                'c': {'a': 1, 'b': 2, 'c': [1, 2, {'a': 1, 'b': 2}]},\n                'd': [1, 2, {'a': 1, 'b': 2}]\n            },\n            'a'\n        )\n        == [1, 1, 1, 1]\n    );;\n}\n\ntest \"t28\" {\n    assert (get_recursively({'a': [{'b': {'c': 'd'}}, 'e']}, 'b') == [{'c': 'd'}]);;\n}\n\ntest \"t29\" {\n    assert (\n        get_recursively({'first': 1, 'second': {'a': 5, 'b': 6}, 'third': [7, 8]}, 'b')\n        == [6]\n    );;\n}\n\ntest \"t30\" {\n    assert (\n        get_recursively(\n            {\n                'a': 1,\n                'b': 2,\n                'c': {\n                    'c1': 3,\n                    'c2': 4,\n                    'c3': [{'c31': 5, 'c32': 6}, {'c31': 7, 'c32': 8}]\n                }\n            },\n            'c31',\n            True\n        )\n        == [5, 7]\n    );;\n}\n\ntest \"t31\" {\n    assert (\n        get_recursively(\n            {\"key1\": \"value1\", \"key2\": {\"key3\": [\"key4\", \"value2\"]}}, \"key3\"\n        )\n        == [[\"key4\", \"value2\"]]\n    );;\n}\n\ntest \"t32\" {\n    assert (\n        get_recursively(\n            {'a': 5, 'b': 6, 'c': 7, 'd': 8, 'e': 9, 'f': 10, 'g': 11, 'h': 12}, 'c'\n        )\n        == [7]\n    );;\n}\n\ntest \"t33\" {\n    assert (\n        get_recursively(\n            {'a': 5, 'b': 6, 'c': 7, 'd': 8, 'e': 9, 'f': 10, 'g': 11, 'h': 12}, 'e'\n        )\n        == [9]\n    );;\n}\n\ntest \"t34\" {\n    assert (\n        get_recursively({\"a\": 1, \"b\": [2, 3], \"c\": {\"d\": 4, \"e\": [5, 6]}}, \"z\") == []\n    );;\n}\n\ntest \"t35\" {\n    assert (\n        get_recursively(\n            {'first': 1, 'second': {'a': 5, 'b': 6}, 'third': [7, 8]}, 'first'\n        )\n        == [1]\n    );;\n}\n\ntest \"t36\" {\n    assert (\n        get_recursively(\n            {'a': 1, 'b': 2, 'c': {'c1': 3, 'c2': 4, 'c3': {'c31': 5, 'c32': 6}}},\n            'c31',\n            True\n        )\n        == [5]\n    );;\n}\n\ntest \"t37\" {\n    assert (get_recursively({'a': {'b': 1, 'c': 2}, 'd': {'b': 3, 'e': 4}}, 'f') == []);;\n}\n\ntest \"t38\" {\n    assert (\n        get_recursively(\n            {\n                'a': [1, 2],\n                'b': 3,\n                'c': {'d': 4, 'e': [{'f': 5, 'g': 6}, {'f': 7, 'g': 8}]}\n            },\n            'f'\n        )\n        == [5, 7]\n    );;\n}\n\ntest \"t39\" {\n    assert (\n        get_recursively(\n            {\n                \"key\": \"value\",\n                \"list\": [{\"dict\": {\"key\": \"value\", \"list\": [{\"key\": \"value\"}]}}]\n            },\n            \"not_key\"\n        )\n        == []\n    );;\n}\n\ntest \"t40\" {\n    assert (\n        get_recursively({'first': 1, 'second': {'a': 5, 'b': 6}, 'third': [7, 8]}, 'c')\n        == []\n    );;\n}\n\ntest \"t41\" {\n    assert (\n        get_recursively(\n            {'a': [1, 2], 'b': 3, 'c': {'d': 4, 'e': {'f': 5, 'g': 6}}}, 'g'\n        )\n        == [6]\n    );;\n}\n\ntest \"t42\" {\n    assert (\n        get_recursively(\n            {\n                \"id\": 1,\n                \"name\": \"one\",\n                \"children\": [{\"id\": 2, \"name\": \"two\"}, {\"id\": 3, \"name\": \"three\"}]\n            },\n            \"id\"\n        )\n        == [1, 2, 3]\n    );;\n}\n\ntest \"t43\" {\n    assert (\n        get_recursively({\"a\": 1, \"b\": [2, 3], \"c\": {\"d\": 4, \"e\": [5, 6]}}, \"c\")\n        == [{\"d\": 4, \"e\": [5, 6]}]\n    );;\n}\n\ntest \"t44\" {\n    assert (\n        get_recursively({'key1': 'value1', 'key2': {'nested': 'value2'}}, 'key2')\n        == [{'nested': 'value2'}]\n    );;\n}\n\ntest \"t45\" {\n    assert (\n        get_recursively({'a': 1, 'b': 2, 'c': 3, 'd': {'e': 4, 'f': {'g': 5}}}, 'a')\n        == [1]\n    );;\n}\n\ntest \"t46\" {\n    assert (\n        get_recursively(\n            {\n                \"id\": 1,\n                \"name\": \"one\",\n                \"children\": [{\"id\": 2, \"name\": \"two\"}, {\"id\": 3, \"name\": \"three\"}]\n            },\n            \"name\"\n        )\n        == [\"one\", \"two\", \"three\"]\n    );;\n}\n\ntest \"t47\" {\n    assert (get_recursively({'a': 1, 'b': {'a': 2, 'b': {'a': 3}}}, 'a') == [1, 2, 3]);;\n}\n\ntest \"t48\" {\n    assert (\n        get_recursively(\n            {'a': 1, 'b': 2, 'c': 3, 'd': {'e': 4, 'f': [{'g': 5}, {'h': 6}]}}, 'g'\n        )\n        == [5]\n    );;\n}\n\ntest \"t49\" {\n    assert (\n        get_recursively(\n            {\"key1\": \"value1\", \"key2\": {\"key3\": [\"key4\", \"value2\"]}}, \"key2\"\n        )\n        == [{\"key3\": [\"key4\", \"value2\"]}]\n    );;\n}\n\ntest \"t50\" {\n    assert (\n        get_recursively(\n            {'a': 5, 'b': 6, 'c': 7, 'd': 8, 'e': 9, 'f': 10, 'g': 11, 'h': 12}, 'a'\n        )\n        == [5]\n    );;\n}\n\ntest \"t51\" {\n    assert (get_recursively({'a': [{'b': 'c'}]}, 'b') == ['c']);;\n}\n\ntest \"t52\" {\n    assert (\n        get_recursively(\n            {\n                'a': 1,\n                'b': 2,\n                'c': {\n                    'c1': 3,\n                    'c2': 4,\n                    'c3': [{'c31': 5, 'c32': 6}, {'c31': 7, 'c32': 8}]\n                }\n            },\n            'c32'\n        )\n        == [6, 8]\n    );;\n}\n\ntest \"t53\" {\n    assert (\n        get_recursively(\n            {\n                'name': 'bob',\n                'age': 25,\n                'pets': [\n                    {'name': 'Fido', 'animal': 'dog'},\n                    {'name': 'Buddy', 'animal': 'cat'}\n                ]\n            },\n            'animal'\n        )\n        == ['dog', 'cat']\n    );;\n}\n\ntest \"t54\" {\n    assert (\n        get_recursively({'a': 1, 'b': 2, 'c': 3, 'd': {'e': 4, 'f': {'g': 5}}}, 'e')\n        == [4]\n    );;\n}\n\ntest \"t55\" {\n    assert (\n        get_recursively({'a': 1, 'b': [{'c': 2, 'd': 3}, {'e': 4}], 'f': 5}, 'e') == [4]\n    );;\n}\n\ntest \"t56\" {\n    assert (\n        get_recursively(\n            {\n                'a': 1,\n                'b': 2,\n                'c': 3,\n                'd': {'d_1': 4, 'd_2': 5, 'd_3': {'d_3_1': 7, 'd_3_2': 8}},\n                'e': 6\n            },\n            'a'\n        )\n        == [1]\n    );;\n}\n\ntest \"t57\" {\n    assert (\n        get_recursively({'key1': 'value1', 'key2': 'value2'}, 'key1') == ['value1']\n    );;\n}\n\ntest \"t58\" {\n    assert (\n        get_recursively({'first': 1, 'second': {'a': 5, 'b': 6}, 'third': [7, 8]}, 'a')\n        == [5]\n    );;\n}\n\ntest \"t59\" {\n    assert (\n        get_recursively(\n            {'a': 1, 'b': 2, 'c': {'a': 1, 'b': 2, 'c': {'a': 1, 'b': 2, 'c': 3}}}, 'c'\n        )\n        == [{'a': 1, 'b': 2, 'c': {'a': 1, 'b': 2, 'c': 3}}]\n    );;\n}\n\ntest \"t60\" {\n    assert (\n        get_recursively({'a': 1, 'b': {'c': 2, 'd': 3}, 'e': 4}, 'b')\n        == [{'c': 2, 'd': 3}]\n    );;\n}\n\ntest \"t61\" {\n    assert (\n        get_recursively(\n            {'a': 1, 'b': 2, 'c': 3, 'd': {'e': 4, 'f': [{'g': 5}, {'h': 6}]}}, 'h'\n        )\n        == [6]\n    );;\n}\n\ntest \"t62\" {\n    assert (\n        get_recursively(\n            {\n                'name': 'bob',\n                'age': 25,\n                'pets': [\n                    {'name': 'Fido', 'animal': 'dog'},\n                    {'name': 'Buddy', 'animal': 'cat'}\n                ]\n            },\n            'age'\n        )\n        == [25]\n    );;\n}\n\ntest \"t63\" {\n    assert (\n        get_recursively({'a': 1, 'b': [{'c': 2, 'd': 3}, {'e': 4}], 'f': 5}, 'f') == [5]\n    );;\n}\n\ntest \"t64\" {\n    assert (\n        get_recursively(\n            {'a': 1, 'b': 2, 'c': {'a': 1, 'b': 2, 'c': {'a': 1, 'b': 2, 'c': 3}}}, 'd'\n        )\n        == []\n    );;\n}\n\ntest \"t65\" {\n    assert (\n        get_recursively({'a': {'b': 1, 'c': 2}, 'd': {'b': 3, 'e': 4}}, 'f', False)\n        == []\n    );;\n}\n\ntest \"t66\" {\n    assert (\n        get_recursively({\"a\": 1, \"b\": [2, 3], \"c\": {\"d\": 4, \"e\": [5, 6]}}, \"a\") == [1]\n    );;\n}\n\ntest \"t67\" {\n    assert (\n        get_recursively(\n            {'key1': 'value1', 'key2': {'nested': {'deep': 'value2'}}}, 'key3'\n        )\n        == []\n    );;\n}\n\ntest \"t68\" {\n    assert (\n        get_recursively(\n            {\n                'a': 1,\n                'b': 2,\n                'c': 3,\n                'd': {'d_1': 4, 'd_2': 5, 'd_3': {'d_3_1': 7, 'd_3_2': 8}},\n                'e': 6\n            },\n            'd_3_1'\n        )\n        == [7]\n    );;\n}\n\ntest \"t69\" {\n    assert (\n        get_recursively(\n            {\"key1\": \"value1\", \"key2\": {\"key3\": [\"key4\", \"value2\"]}}, \"key5\"\n        )\n        == []\n    );;\n}\n\ntest \"t70\" {\n    assert (\n        get_recursively({'a': 1, 'b': [{'c': 2, 'd': 3}, {'e': 4}], 'f': 5}, 'c') == [2]\n    );;\n}\n\ntest \"t71\" {\n    assert (\n        get_recursively(\n            {'a': 1, 'b': 2, 'c': {'c1': 3, 'c2': 4, 'c3': {'c31': 5, 'c32': 6}}}, 'c31'\n        )\n        == [5]\n    );;\n}\n\ntest \"t72\" {\n    assert (\n        get_recursively({'a': {'b': 1, 'c': 2}, 'd': {'b': 3, 'e': 4}}, 'f', True) == []\n    );;\n}"}