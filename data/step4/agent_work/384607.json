{"id": 384607, "entrypoint": "gens_by_bus", "coverage": 100, "stage": "floor_pass", "python": "def gens_by_bus(buses, gens):\n    \"\"\"\n    Return a dictionary of the generators attached to each bus\n    \"\"\"\n    gens_by_bus = {k: list() for k in buses.keys()}\n    for gen_name, gen in gens.items():\n        gens_by_bus[gen['bus']].append(gen_name)\n\n    return gens_by_bus", "floor_fn": "\"\"\"\n    Return a dictionary of the generators attached to each bus\n    \"\"\"\ndef gens_by_bus(buses: Any, gens: Any) -> object {\n    gens_by_bus = {k: `list() for k in buses.keys()};\n    for (gen_name, gen) in gens.items() {\n        gens_by_bus[gen['bus']].append(gen_name);\n    }\n    return gens_by_bus;\n}", "test_blocks": "test \"t0\" {\n    assert (\n        gens_by_bus(\n            {'1': {}, '2': {}, '3': {}},\n            {'1': {'bus': '1'}, '2': {'bus': '2'}, '3': {'bus': '2'}}\n        )\n        == {'1': ['1'], '2': ['2', '3'], '3': []}\n    );;\n}\n\ntest \"t1\" {\n    assert (\n        gens_by_bus(\n            {'1': {}, '2': {}, '3': {}},\n            {'1': {'bus': '1'}, '2': {'bus': '1'}, '3': {'bus': '1'}}\n        )\n        == {'1': ['1', '2', '3'], '2': [], '3': []}\n    );;\n}\n\ntest \"t2\" {\n    assert (\n        gens_by_bus(\n            {'1': {}, '2': {}, '3': {}},\n            {'1': {'bus': '1'}, '2': {'bus': '1'}, '3': {'bus': '2'}}\n        )\n        == {'1': ['1', '2'], '2': ['3'], '3': []}\n    );;\n}\n\ntest \"t3\" {\n    assert (\n        gens_by_bus(\n            {'Bus 1': {'generators': ['Gen 1'], 'name': 'Bus 1'}},\n            {'Gen 1': {'bus': 'Bus 1', 'name': 'Gen 1'}}\n        )\n        == {'Bus 1': ['Gen 1']}\n    );;\n}\n\ntest \"t4\" {\n    assert (\n        gens_by_bus(\n            {'Bus 1': {'Gen 1': {}, 'Gen 2': {}, 'Gen 3': {}}},\n            {\n                'Gen 1': {'bus': 'Bus 1'},\n                'Gen 2': {'bus': 'Bus 1'},\n                'Gen 3': {'bus': 'Bus 1'}\n            }\n        )\n        == {'Bus 1': ['Gen 1', 'Gen 2', 'Gen 3']}\n    );;\n}\n\ntest \"t5\" {\n    assert (\n        gens_by_bus(\n            {'Bus 1': {'number': 1}, 'Bus 2': {'number': 2}},\n            {\n                'Gen 1': {'bus': 'Bus 1'},\n                'Gen 2': {'bus': 'Bus 2'},\n                'Gen 3': {'bus': 'Bus 2'}\n            }\n        )\n        == {'Bus 1': ['Gen 1'], 'Bus 2': ['Gen 2', 'Gen 3']}\n    );;\n}\n\ntest \"t6\" {\n    assert (\n        gens_by_bus(\n            {'Bus 1': {'generators': ['Gen 1'], 'name': 'Bus 1'}},\n            {\n                'Gen 1': {'bus': 'Bus 1', 'name': 'Gen 1'},\n                'Gen 2': {'bus': 'Bus 1', 'name': 'Gen 2'}\n            }\n        )\n        == {'Bus 1': ['Gen 1', 'Gen 2']}\n    );;\n}\n\ntest \"t7\" {\n    assert (\n        gens_by_bus(\n            {\n                1: {'name': 'bus1', 'base_kv': 0.132},\n                2: {'name': 'bus2', 'base_kv': 0.132},\n                3: {'name': 'bus3', 'base_kv': 0.132}\n            },\n            {\n                'gen1': {'name': 'gen1', 'bus': 1},\n                'gen2': {'name': 'gen2', 'bus': 1},\n                'gen3': {'name': 'gen3', 'bus': 2},\n                'gen4': {'name': 'gen4', 'bus': 3}\n            }\n        )\n        == {1: ['gen1', 'gen2'], 2: ['gen3'], 3: ['gen4']}\n    );;\n}\n\ntest \"t8\" {\n    assert (gens_by_bus({}, {}) == {});;\n}"}