{"id": 223704, "entrypoint": "convert_to_csv", "coverage": 100, "stage": "floor_pass", "python": "def convert_to_csv(records):\n    \"\"\"Convert records in list type to csv string.\n\n    Args:\n        records: A list of power data records each of which contains timestamp, power value,\n        and channel. e.g. [[12345678, 80, \"SYSTEM\"],[23456789, 60, \"SENSOR\"]].\n\n    Returns:\n        A string that contains all CSV records, None if the given list if empty.\n    \"\"\"\n    if not records:\n        return ''\n\n    csv_lines = list()\n    for record in records:\n        string_record = [str(element) for element in record]\n        csv_line = ','.join(string_record)\n        csv_lines.append(csv_line)\n\n    return '\\n'.join(csv_lines)", "floor_fn": "\"\"\"Convert records in list type to csv string.\n\n    Args:\n        records: A list of power data records each of which contains timestamp, power value,\n        and channel. e.g. [[12345678, 80, \"SYSTEM\"],[23456789, 60, \"SENSOR\"]].\n\n    Returns:\n        A string that contains all CSV records, None if the given list if empty.\n    \"\"\"\ndef convert_to_csv(records: Any) -> object {\n    if not records {\n        return '';\n    }\n    csv_lines = `list();\n    for record in records {\n        string_record = [str(element) for element in record];\n        csv_line = ','.join(string_record);\n        csv_lines.append(csv_line);\n    }\n    return '\\n'.join(csv_lines);\n}", "test_blocks": "test \"t0\" {\n    assert (\n        convert_to_csv([[12345678, 80, \"SYSTEM\"], [23456789, 60, \"SENSOR\"]])\n        == '12345678,80,SYSTEM\\n23456789,60,SENSOR'\n    );;\n}\n\ntest \"t1\" {\n    assert (convert_to_csv([[23456789, 60, 'SENSOR']]) == '23456789,60,SENSOR');;\n}\n\ntest \"t2\" {\n    assert (\n        convert_to_csv([[12345678, 80, \"SYSTEM\"], [23456789, 60, \"SENSOR\"]])\n        == \"12345678,80,SYSTEM\\n23456789,60,SENSOR\"\n    );;\n}\n\ntest \"t3\" {\n    assert (\n        convert_to_csv(\n            [\n                [12345678, 80, \"SYSTEM\"],\n                [23456789, 60, \"SENSOR\"],\n                [34567890, 100, \"SYSTEM\"]\n            ]\n        )\n        == \"12345678,80,SYSTEM\\n23456789,60,SENSOR\\n34567890,100,SYSTEM\"\n    );;\n}\n\ntest \"t4\" {\n    assert (\n        convert_to_csv(\n            [\n                [12345678, 80, 'SYSTEM'],\n                [23456789, 60, 'SENSOR'],\n                [34567890, 40, 'SENSOR']\n            ]\n        )\n        == '12345678,80,SYSTEM\\n23456789,60,SENSOR\\n34567890,40,SENSOR'\n    );;\n}\n\ntest \"t5\" {\n    assert (\n        convert_to_csv([[12345678, 80, \"SYSTEM\"], [23456789, 60, \"SENSOR\"]])\n        == '12345678,80,SYSTEM\\n23456789,60,SENSOR'\n    );;\n}\n\ntest \"t6\" {\n    assert (\n        convert_to_csv([[12345678, 80, 'SYSTEM'], [23456789, 60, 'SENSOR']])\n        == '12345678,80,SYSTEM\\n23456789,60,SENSOR'\n    );;\n}\n\ntest \"t7\" {\n    assert (\n        convert_to_csv(\n            [\n                [12345678, 80, \"SYSTEM\"],\n                [23456789, 60, \"SENSOR\"],\n                [12345679, 90, \"SYSTEM\"]\n            ]\n        )\n        == '12345678,80,SYSTEM\\n23456789,60,SENSOR\\n12345679,90,SYSTEM'\n    );;\n}\n\ntest \"t8\" {\n    assert (\n        convert_to_csv([[12345678, 80, \"SYSTEM\"], [23456789, 60, \"SENSOR\"]])\n        == '12345678,80,SYSTEM\\n23456789,60,SENSOR'\n    );;\n}\n\ntest \"t9\" {\n    assert (convert_to_csv([[12345678, 80, \"SYSTEM\"]]) == \"12345678,80,SYSTEM\");;\n}\n\ntest \"t10\" {\n    assert (convert_to_csv([]) == '');;\n}\n\ntest \"t11\" {\n    assert (\n        convert_to_csv([[12345678], [23456789], [34567890]])\n        == \"12345678\\n23456789\\n34567890\"\n    );;\n}\n\ntest \"t12\" {\n    assert (\n        convert_to_csv([[12345678, 80, \"SYSTEM\"], [23456789, 60, \"SENSOR\"]])\n        == '12345678,80,SYSTEM\\n23456789,60,SENSOR'\n    );;\n}\n\ntest \"t13\" {\n    assert (convert_to_csv([]) == \"\");;\n}\n\ntest \"t14\" {\n    assert (convert_to_csv([[12345678, 80, \"SYSTEM\"]]) == '12345678,80,SYSTEM');;\n}\n\ntest \"t15\" {\n    assert (convert_to_csv([[]]) == \"\");;\n}\n\ntest \"t16\" {\n    assert (\n        convert_to_csv([[12345678, 80], [23456789, 60, \"SENSOR\"]])\n        == \"12345678,80\\n23456789,60,SENSOR\"\n    );;\n}\n\ntest \"t17\" {\n    assert (\n        convert_to_csv([[12345678, 80, 'SYSTEM'], [23456789, 60, 'SENSOR']])\n        == '12345678,80,SYSTEM\\n23456789,60,SENSOR'\n    );;\n}\n\ntest \"t18\" {\n    assert (\n        convert_to_csv([[12345678, 80], [23456789, 60]]) == \"12345678,80\\n23456789,60\"\n    );;\n}\n\ntest \"t19\" {\n    assert (convert_to_csv([]) == '');;\n}\n\ntest \"t20\" {\n    assert (convert_to_csv([[12345678], [23456789]]) == \"12345678\\n23456789\");;\n}\n\ntest \"t21\" {\n    assert (\n        convert_to_csv(`list(zip([12345678, 23456789], [80, 60], [\"SYSTEM\", \"SENSOR\"])))\n        == '12345678,80,SYSTEM\\n23456789,60,SENSOR'\n    );;\n}\n\ntest \"t22\" {\n    assert (\n        convert_to_csv(\n            [\n                [123456789012, 80, 'SYSTEM'],\n                [123456789013, 60, 'SENSOR'],\n                [123456789014, 40, 'SENSOR']\n            ]\n        )\n        == '123456789012,80,SYSTEM\\n123456789013,60,SENSOR\\n123456789014,40,SENSOR'\n    );;\n}\n\ntest \"t23\" {\n    assert (\n        convert_to_csv([[12345678, 80, \"SYSTEM\"], [23456789, 60, \"SENSOR\"]])\n        == \"12345678,80,SYSTEM\\n23456789,60,SENSOR\"\n    );;\n}\n\ntest \"t24\" {\n    assert (\n        convert_to_csv([[12345678, 80, \"SYSTEM\"], [23456789, 60, \"SENSOR\"]])\n        == \"12345678,80,SYSTEM\\n23456789,60,SENSOR\"\n    );;\n}\n\ntest \"t25\" {\n    assert (\n        convert_to_csv([[12345678, 80, \"SYSTEM\"], [23456789, 60, \"SENSOR\"]])\n        == '12345678,80,SYSTEM\\n23456789,60,SENSOR'\n    );;\n}\n\ntest \"t26\" {\n    assert (\n        convert_to_csv([[12345678, 80, \"SYSTEM\"], [23456789, 60, \"SENSOR\"]])\n        == '12345678,80,SYSTEM\\n23456789,60,SENSOR'\n    );;\n}\n\ntest \"t27\" {\n    assert (\n        convert_to_csv(\n            [\n                [12345678, 80, \"SYSTEM\"],\n                [23456789, 60, \"SENSOR\"],\n                [34567890, 90, \"SENSOR\"]\n            ]\n        )\n        == '12345678,80,SYSTEM\\n23456789,60,SENSOR\\n34567890,90,SENSOR'\n    );;\n}\n\ntest \"t28\" {\n    assert (\n        convert_to_csv(\n            [\n                [12345678, 80, \"SYSTEM\"],\n                [23456789, 60, \"SENSOR\"],\n                [12345678, 70, \"SYSTEM\"],\n                [23456789, 50, \"SENSOR\"]\n            ]\n        )\n        == '''12345678,80,SYSTEM\n23456789,60,SENSOR\n12345678,70,SYSTEM\n23456789,50,SENSOR'''\n    );;\n}\n\ntest \"t29\" {\n    assert (convert_to_csv([]) == '');;\n}\n\ntest \"t30\" {\n    assert (\n        convert_to_csv([[12345678, 80, \"SYSTEM\"], [23456789, 60, \"SENSOR\"]])\n        == '12345678,80,SYSTEM\\n23456789,60,SENSOR'\n    );;\n}\n\ntest \"t31\" {\n    assert (convert_to_csv(None) == '');;\n}"}