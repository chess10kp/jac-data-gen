{"id": 265699, "entrypoint": "fac", "coverage": 100, "stage": "floor_pass", "python": "def fac(num):\n    \"\"\"fac: Returns an array of factors for the given number\n    Args: \n    \tnum (int): number to list factors for\n    Returns:\n    \tarray: factors of num\n    \"\"\"\n    output = []\n    # Creates inlist for output\n    for x in range(1, num + 1):\n    # Loop with variable x\n        if num % x == 0 and not num % x in output:\n            # Tests if x goes into num and if x is already in output\n            output.append(x)\n    return output", "floor_fn": "\"\"\"fac: Returns an array of factors for the given number\n    Args:\n    \tnum (int): number to list factors for\n    Returns:\n    \tarray: factors of num\n    \"\"\"\ndef fac(num: Any) -> object {\n    output = [];\n    for x in range(1, (num + 1)) {\n        if (((num % x) == 0) and not ((num % x) in output)) {\n            output.append(x);\n        }\n    }\n    return output;\n}", "test_blocks": "test \"t0\" {\n    assert (fac(1) == [1]) , \"fac(1) failed\";;\n}\n\ntest \"t1\" {\n    assert (fac(10) == [1, 2, 5, 10]);;\n}\n\ntest \"t2\" {\n    assert (fac(9) == [1, 3, 9]);;\n}\n\ntest \"t3\" {\n    assert (fac(8) == [1, 2, 4, 8]);;\n}\n\ntest \"t4\" {\n    assert (fac(3) == [1, 3]);;\n}\n\ntest \"t5\" {\n    assert (fac(3) == [1, 3]);;\n}\n\ntest \"t6\" {\n    assert (fac(12) == [1, 2, 3, 4, 6, 12]);;\n}\n\ntest \"t7\" {\n    assert (fac(12) == [1, 2, 3, 4, 6, 12]);;\n}\n\ntest \"t8\" {\n    assert (fac(19) == [1, 19]);;\n}\n\ntest \"t9\" {\n    assert (fac(5) == [1, 5]);;\n}\n\ntest \"t10\" {\n    assert (fac(1) == [1]);;\n}\n\ntest \"t11\" {\n    assert (fac(11) == [1, 11]);;\n}\n\ntest \"t12\" {\n    assert (fac(18) == [1, 2, 3, 6, 9, 18]);;\n}\n\ntest \"t13\" {\n    assert (fac(4) == [1, 2, 4]);;\n}\n\ntest \"t14\" {\n    assert (fac(7) == [1, 7]);;\n}\n\ntest \"t15\" {\n    assert (fac(8) == [1, 2, 4, 8]);;\n}\n\ntest \"t16\" {\n    assert (fac(-10) == []);;\n}\n\ntest \"t17\" {\n    assert (fac(10) == [1, 2, 5, 10]) , \"fac(10) failed\";;\n}\n\ntest \"t18\" {\n    assert (fac(22) == [1, 2, 11, 22]);;\n}\n\ntest \"t19\" {\n    assert (fac(42) == [1, 2, 3, 6, 7, 14, 21, 42]);;\n}\n\ntest \"t20\" {\n    assert (fac(20) == [1, 2, 4, 5, 10, 20]);;\n}\n\ntest \"t21\" {\n    assert (fac(0) == []);;\n}\n\ntest \"t22\" {\n    assert (fac(7) == [1, 7]) , \"fac(7) failed\";;\n}\n\ntest \"t23\" {\n    assert (fac(2) == [1, 2]);;\n}\n\ntest \"t24\" {\n    assert (fac(6) == [1, 2, 3, 6]) , \"fac(6) failed\";;\n}\n\ntest \"t25\" {\n    assert (fac(15) == [1, 3, 5, 15]);;\n}\n\ntest \"t26\" {\n    assert (fac(15) == [1, 3, 5, 15]);;\n}\n\ntest \"t27\" {\n    assert (fac(6) == [1, 2, 3, 6]);;\n}\n\ntest \"t28\" {\n    assert (\n        fac(1000) == [1, 2, 4, 5, 8, 10, 20, 25, 40, 50, 100, 125, 200, 250, 500, 1000]\n    );;\n}\n\ntest \"t29\" {\n    assert (fac(7) == [1, 7]);;\n}\n\ntest \"t30\" {\n    assert (fac(16) == [1, 2, 4, 8, 16]);;\n}\n\ntest \"t31\" {\n    assert (fac(6) == [1, 2, 3, 6]);;\n}\n\ntest \"t32\" {\n    assert (fac(2) == [1, 2]) , \"fac(2) failed\";;\n}\n\ntest \"t33\" {\n    assert (fac(5) == [1, 5]);;\n}\n\ntest \"t34\" {\n    assert (fac(21) == [1, 3, 7, 21]);;\n}\n\ntest \"t35\" {\n    assert (fac(9) == [1, 3, 9]);;\n}\n\ntest \"t36\" {\n    assert (fac(9) == [1, 3, 9]) , \"fac(9) failed\";;\n}\n\ntest \"t37\" {\n    assert (fac(8) == [1, 2, 4, 8]) , \"fac(8) failed\";;\n}\n\ntest \"t38\" {\n    assert (fac(4) == [1, 2, 4]) , \"fac(4) failed\";;\n}\n\ntest \"t39\" {\n    assert (fac(24) == [1, 2, 3, 4, 6, 8, 12, 24]);;\n}\n\ntest \"t40\" {\n    assert (fac(4) == [1, 2, 4]);;\n}\n\ntest \"t41\" {\n    assert (fac(3) == [1, 3]) , \"fac(3) failed\";;\n}\n\ntest \"t42\" {\n    assert (fac(5) == [1, 5]) , \"fac(5) failed\";;\n}\n\ntest \"t43\" {\n    assert (fac(17) == [1, 17]);;\n}\n\ntest \"t44\" {\n    assert (fac(14) == [1, 2, 7, 14]);;\n}\n\ntest \"t45\" {\n    assert (fac(13) == [1, 13]);;\n}\n\ntest \"t46\" {\n    assert (fac(2) == [1, 2]