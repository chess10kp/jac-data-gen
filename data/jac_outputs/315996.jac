glob BOUNCE_K = 7.5625;
glob BOUNCE_PHASE1_END = 0.36363636363636365;
glob BOUNCE_PHASE2_END = 0.7272727272727273;
glob BOUNCE_PHASE3_END = 0.9090909090909091;
glob BOUNCE_PHASE2_CENTER = 0.5454545454545454;
glob BOUNCE_PHASE3_CENTER = 0.8181818181818182;
glob BOUNCE_PHASE4_CENTER = 0.9545454545454545454;
glob BOUNCE_PHASE2_FLOOR = 0.75;
glob BOUNCE_PHASE3_FLOOR = 0.9375;
glob BOUNCE_PHASE4_FLOOR = 0.984375;

"""Bounce out. Amplitude of bounce decreases."""
def bounce_out(t: float) -> float {
    if t < BOUNCE_PHASE1_END {
        return BOUNCE_K * t * t;
    } elif t < BOUNCE_PHASE2_END {
        return BOUNCE_K * (t - BOUNCE_PHASE2_CENTER) ** 2 + BOUNCE_PHASE2_FLOOR;
    } elif t < BOUNCE_PHASE3_END {
        return BOUNCE_K * (t - BOUNCE_PHASE3_CENTER) ** 2 + BOUNCE_PHASE3_FLOOR;
    } else {
        return BOUNCE_K * (t - BOUNCE_PHASE4_CENTER) ** 2 + BOUNCE_PHASE4_FLOOR;
    }
}