{"id": 428846, "entrypoint": "cve_harvest", "coverage": 100, "stage": "floor_pass", "python": "def cve_harvest(text):\n    \"\"\"\n    looks for anything with 'CVE' inside a text and returns a list of it\n    \"\"\"\n    array = []\n    #look inside split by whitespace\n    for word in text.split():\n        if 'CVE' in word:\n            array.append(word)\n    return array", "floor_fn": "\"\"\"\n    looks for anything with 'CVE' inside a text and returns a list of it\n    \"\"\"\ndef cve_harvest(text: Any) -> object {\n    array = [];\n    for word in text.split() {\n        if ('CVE' in word) {\n            array.append(word);\n        }\n    }\n    return array;\n}", "test_blocks": "test \"t0\" {\n    assert (\n        cve_harvest(\n            \"CVE-1999-0001 CVE-1999-0002 CVE-1999-0003 CVE-2001-0004 CVE-2000-0005\"\n        )\n        == [\n            \"CVE-1999-0001\",\n            \"CVE-1999-0002\",\n            \"CVE-1999-0003\",\n            \"CVE-2001-0004\",\n            \"CVE-2000-0005\"\n        ]\n    );;\n}\n\ntest \"t1\" {\n    assert (\n        cve_harvest('This is a sample sentence that includes CVE-2000-0123-5678')\n        == ['CVE-2000-0123-5678']\n    );;\n}\n\ntest \"t2\" {\n    assert (cve_harvest(\"CVE-2012-12345 CVE-12345\") == ['CVE-2012-12345', 'CVE-12345']);;\n}\n\ntest \"t3\" {\n    assert (\n        cve_harvest('This is a sample sentence that includes CVE-2000-0123')\n        == ['CVE-2000-0123']\n    );;\n}\n\ntest \"t4\" {\n    assert (\n        cve_harvest(\"CVE-2021-29921\\n CVE-2021-29922\")\n        == [\"CVE-2021-29921\", \"CVE-2021-29922\"]\n    );;\n}\n\ntest \"t5\" {\n    assert (\n        cve_harvest('CVE-1918-1234 CVE-2012-3456 CVE-0000-1234')\n        == ['CVE-1918-1234', 'CVE-2012-3456', 'CVE-0000-1234']\n    );;\n}\n\ntest \"t6\" {\n    assert (\n        cve_harvest(\"CVE-2010-3867 CVE-2010-3867\") == ['CVE-2010-3867', 'CVE-2010-3867']\n    );;\n}\n\ntest \"t7\" {\n    assert (\n        cve_harvest(\n            \"CVE-2021-29921 this is a test CVE-2021-29922 this is a test CVE-2021-29923\"\n        )\n        == [\"CVE-2021-29921\", \"CVE-2021-29922\", \"CVE-2021-29923\"]\n    );;\n}\n\ntest \"t8\" {\n    assert (\n        cve_harvest(\"CVE-2019-3453 and CVE-2019-3454\")\n        == [\"CVE-2019-3453\", \"CVE-2019-3454\"]\n    );;\n}\n\ntest \"t9\" {\n    assert (cve_harvest(\"\") == []);;\n}\n\ntest \"t10\" {\n    assert (\n        cve_harvest(\n            \"CVE-2014-0160 CVE-2012-6153 CVE-2011-4889 CVE-2011-4890 CVE-2011-4888 CVE-2011-4887 CVE-2011-4886\"\n        )\n        == [\n            \"CVE-2014-0160\",\n            \"CVE-2012-6153\",\n            \"CVE-2011-4889\",\n            \"CVE-2011-4890\",\n            \"CVE-2011-4888\",\n            \"CVE-2011-4887\",\n            \"CVE-2011-4886\"\n        ]\n    );;\n}\n\ntest \"t11\" {\n    assert (\n        cve_harvest(\"CVE-2021-29921 CVE-2021-29922\")\n        == [\"CVE-2021-29921\", \"CVE-2021-29922\"]\n    );;\n}\n\ntest \"t12\" {\n    assert (cve_harvest(\"nope\") == []);;\n}\n\ntest \"t13\" {\n    assert (\n        cve_harvest(\n            \"\"\"\n    CVE-2016-1000000\n    CVE-2016-1000001\n    CVE-2016-1000002\n    CVE-2016-1000003\n    CVE-2016-1000004\n    \"\"\"\n        )\n        == [\n            'CVE-2016-1000000',\n            'CVE-2016-1000001',\n            'CVE-2016-1000002',\n            'CVE-2016-1000003',\n            'CVE-2016-1000004'\n        ]\n    );;\n}\n\ntest \"t14\" {\n    assert (\n        cve_harvest('CVE-2017-0001\\nCVE-2017-0002\\nCVE-2017-0003\\n')\n        == ['CVE-2017-0001', 'CVE-2017-0002', 'CVE-2017-0003']\n    );;\n}\n\ntest \"t15\" {\n    assert (\n        cve_harvest(\n            \"\"\"\n    CVE-2016-1000000\n    CVE-2016-1000001\n    CVE-2016-1000002\n    \"\"\"\n        )\n        == ['CVE-2016-1000000', 'CVE-2016-1000001', 'CVE-2016-1000002']\n    );;\n}\n\ntest \"t16\" {\n    assert (cve_harvest(\"CVE-2005-0197\") == ['CVE-2005-0197']);;\n}\n\ntest \"t17\" {\n    assert (\n        cve_harvest('CVE-2013-1234 CVE-2013-1235 CVE-2013-1236')\n        == ['CVE-2013-1234', 'CVE-2013-1235', 'CVE-2013-1236']\n    );;\n}\n\ntest \"t18\" {\n    assert (cve_harvest(\"CVE-2012-12345\") == ['CVE-2012-12345']);;\n}\n\ntest \"t19\" {\n    assert (\n        cve_harvest(\"CVE-2012-12345 is CVE-2012-12345\")\n        == ['CVE-2012-12345', 'CVE-2012-12345']\n    );;\n}\n\ntest \"t20\" {\n    assert (\n        cve_harvest(\n            \"CVE-2012-6551 is a thing that should be found, CVE-2012-6552 is another.\"\n        )\n        == [\"CVE-2012-6551\", \"CVE-2012-6552\"]\n    );;\n}\n\ntest \"t21\" {\n    assert (\n        cve_harvest(\"CVE-2019-3453 CVE-2019-3454\") == [\"CVE-2019-3453\", \"CVE-2019-3454\"]\n    );;\n}\n\ntest \"t22\" {\n    assert (\n        cve_harvest('CVE-1918-1234 CVE-2012-3456') == ['CVE-1918-1234', 'CVE-2012-3456']\n    );;\n}\n\ntest \"t23\" {\n    assert (\n        cve_harvest('CVE-1999-0001 CVE-1999-0002 CVE-1999-0003 CVE-1999-0004')\n        == ['CVE-1999-0001', 'CVE-1999-0002', 'CVE-1999-0003', 'CVE-1999-0004']\n    );;\n}\n\ntest \"t24\" {\n    assert (\n        cve_harvest('CVE-2017-0001\\nCVE-2017-0002\\nCVE-2017-0003')\n        == ['CVE-2017-0001', 'CVE-2017-0002', 'CVE-2017-0003']\n    );;\n}\n\ntest \"t25\" {\n    assert (cve_harvest('CV-2018-1234') == []);;\n}\n\ntest \"t26\" {\n    assert (cve_harvest(\"CVE-2021-29921  \") == [\"CVE-2021-29921\"]);;\n}\n\ntest \"t27\" {\n    assert (\n        cve_harvest(\"CVE-2010-3867 CVE-2010-3867 CVE-2010-3867\")\n        == ['CVE-2010-3867', 'CVE-2010-3867', 'CVE-2010-3867']\n    );;\n}\n\ntest \"t28\" {\n    assert (cve_harvest(\"CVE-2012-1150\") == ['CVE-2012-1150']);;\n}\n\ntest \"t29\" {\n    assert (cve_harvest('CVE-2012-3456') == ['CVE-2012-3456']);;\n}\n\ntest \"t30\" {\n    assert (\n        cve_harvest(\n            \"CVE-2005-0197 CVE-2005-1231 CVE-2006-1231 \" \"CVE-2006-1234 CVE-2007-1234\"\n        )\n        == [\n            'CVE-2005-0197',\n            'CVE-2005-1231',\n            'CVE-2006-1231',\n            'CVE-2006-1234',\n            'CVE-2007-1234'\n        ]\n    );;\n}\n\ntest \"t31\" {\n    assert (\n        cve_harvest('CVE-2017-0001 CVE-2017-0002 CVE-2017-0003')\n        == ['CVE-2017-0001', 'CVE-2017-0002', 'CVE-2017-0003']\n    );;\n}\n\ntest \"t32\" {\n    assert (\n        cve_harvest(\"CVE-2021-29921\\nCVE-2021-29922\")\n        == [\"CVE-2021-29921\", \"CVE-2021-29922\"]\n    );;\n}\n\ntest \"t33\" {\n    assert (cve_harvest(\"         \\n   \\n    \\n     \") == []);;\n}\n\ntest \"t34\" {\n    assert (\n        cve_harvest(r'CVE-2018-1234 CVE-2018-1235 CVE-2018-1236')\n        == ['CVE-2018-1234', 'CVE-2018-1235', 'CVE-2018-1236']\n    );;\n}\n\ntest \"t35\" {\n    assert (\n        cve_harvest('CVE-2015-0000 CVE-2016-0000 CVE-2017-0000')\n        == ['CVE-2015-0000', 'CVE-2016-0000', 'CVE-2017-0000']\n    );;\n}\n\ntest \"t36\" {\n    assert (\n        cve_harvest(\n            'This is a sample sentence that includes CVE-2000-0123 CVE-1234-5678'\n        )\n        == ['CVE-2000-0123', 'CVE-1234-5678']\n    );;\n}\n\ntest \"t37\" {\n    assert (cve_harvest('CVE-2018-1234') == ['CVE-2018-1234']);;\n}\n\ntest \"t38\" {\n    assert (\n        cve_harvest(\"CVE-2021-23215 CVE-2021-23216 CVE-2021-23217\")\n        == [\"CVE-2021-23215\", \"CVE-2021-23216\", \"CVE-2021-23217\"]\n    );;\n}\n\ntest \"t39\" {\n    assert (\n        cve_harvest(\n            'CVE-2015-4591 CVE-2015-4590 CVE-2015-4592 CVE-2015-4593 CVE-2015-4594'\n        )\n        == [\n            'CVE-2015-4591',\n            'CVE-2015-4590',\n            'CVE-2015-4592',\n            'CVE-2015-4593',\n            'CVE-2015-4594'\n        ]\n    );;\n}\n\ntest \"t40\" {\n    assert (\n        cve_harvest('CVE-2012-3456 CVE-1918-1234') == ['CVE-2012-3456', 'CVE-1918-1234']\n    );;\n}\n\ntest \"t41\" {\n    assert (\n        cve_harvest(\"CVE-2021-23215\\nCVE-2021-23216\\nCVE-2021-23217 CVE-2021-23218\")\n        == [\"CVE-2021-23215\", \"CVE-2021-23216\", \"CVE-2021-23217\", \"CVE-2021-23218\"]\n    );;\n}\n\ntest \"t42\" {\n    assert (\n        cve_harvest(\"CVE-2021-23215\\nCVE-2021-23216\\nCVE-2021-23217\")\n        == [\"CVE-2021-23215\", \"CVE-2021-23216\", \"CVE-2021-23217\"]\n    );;\n}\n\ntest \"t43\" {\n    assert (cve_harvest(\"CVE-2021-29921\") == [\"CVE-2021-29921\"]);;\n}\n\ntest \"t44\" {\n    assert (cve_harvest(\"\") == []);;\n}\n\ntest \"t45\" {\n    assert (cve_harvest(\"CVE-2019-3453\") == [\"CVE-2019-3453\"]);;\n}\n\ntest \"t46\" {\n    assert (\n        cve_harvest(\n            'CVE-2015-4591 CVE-2015-4590 CVE-2015-4592 CVE-2015-4593 CVE-2015-4594'\n        )\n        == [\n            'CVE-2015-4591',\n            'CVE-2015-4590',\n            'CVE-2015-4592',\n            'CVE-2015-4593',\n            'CVE-2015-4594'\n        ]\n    );;\n}\n\ntest \"t47\" {\n    assert (cve_harvest(\"CVE-2012-6153\") == [\"CVE-2012-6153\"]);;\n}"}